use std::abi::sol
msg ProbeMsg {
    #[selector = sol("concat(string,string)")]
    Concat { a: DynString, b: DynString } -> DynString,
}
pub contract ConcatProbe {
    recv ProbeMsg {
        Concat { a, b } -> DynString uses (mem: mut RawMem) { join((a.as_bytes(), b.as_bytes())) }
    }
}
