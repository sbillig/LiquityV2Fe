// Shared byte-span concatenation keeps renderer tuple adapters small.
use core::ptr::{self, MemSpan, MemSlice, MemArray}
use std::abi::{Bytes, DynString}
use std::evm::RawMem
pub trait Fragment {
    fn fragment(self) -> MemSpan uses (mem: mut RawMem)
}
impl Fragment for Bytes {
    fn fragment(self) -> MemSpan uses (mem: mut RawMem) { self.payload_span() }
}
impl<const N: usize> Fragment for String<N> {
    fn fragment(self) -> MemSpan uses (mem: mut RawMem) {
        let p = ptr::alloc_bytes(32)
        let len = self.len() as u256
        mem.mstore(addr: p, value: (self as u256) << ((32 - len) * 8))
        MemSpan::from_raw_parts(ptr: p, len)
    }
}
pub trait Fragments {
    fn fragments(own self) -> MemSlice<MemSpan> uses (mem: mut RawMem)
}
impl<const N: usize> Fragments for String<N> {
    fn fragments(own self) -> MemSlice<MemSpan> uses (mem: mut RawMem) {
        let array = MemArray<MemSpan>::new_uninit(1)
        *array.ptr_at(0) = self.fragment()
        array.as_slice()
    }
}
#[inline(never)]
fn concatenate(_ pieces: MemSlice<MemSpan>) -> DynString uses (mem: mut RawMem) {
    let mut len: u256 = 0
    let mut i: u256 = 0
    while i < pieces.len() {
        len += (*ptr::offset(pieces.ptr(), i)).len()
        i += 1
    }
    let size = 32 + ((len + 31) / 32) * 32
    let output = ptr::alloc_bytes(size)
    mem.mstore(addr: output, value: len)
    if len % 32 != 0 { mem.mstore(addr: ptr::offset_bytes(output, size - 32), value: 0) }
    let mut offset: u256 = 32
    i = 0
    while i < pieces.len() {
        let piece = *ptr::offset(pieces.ptr(), i)
        ptr::copy(dest: ptr::offset_bytes(output, offset), source: piece)
        offset += piece.len()
        i += 1
    }
    DynString::from_abi_tail(data: output, len, size)
}
pub fn join<T: Fragments>(_ value: own T) -> DynString uses (mem: mut RawMem) {
    concatenate(value.fragments())
}

impl<A: Fragment, B: Fragment> Fragments for (A, B) {
    fn fragments(own self) -> MemSlice<MemSpan> uses (mem: mut RawMem) {
        let array = MemArray<MemSpan>::new_uninit(2)
        *array.ptr_at(0) = self.0.fragment()
        *array.ptr_at(1) = self.1.fragment()
        array.as_slice()
    }
}
