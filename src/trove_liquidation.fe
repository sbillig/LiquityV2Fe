use std::evm::read_storage_word
use core::num::IntDowncast
use std::abi::{sol, DynArray, DynArrayAccess}
use std::evm::{Address, Ctx, Call, Log, RawStorage, revert_error}
use super::trove_data as data
use super::trove_hooks as hooks
use super::trove_events as events
use super::trove_redemption::{require_code, PriceMsg}
use super::types::{TroveChange, LatestTroveData, LatestBatchData}
use super::active_pool::ActivePoolMsg
use super::default_pool::DefaultPoolMsg
use super::stability_pool::StabilityPoolMsg
use super::coll_surplus_pool::CollSurplusPoolMsg
use super::trove_nft::TroveNFTMsg
use super::token_calls::TokenMsg
use super::liquity_base::BranchPoolMsg
use super::liquity_math as math
use super::constants::*
#[error]
pub struct EmptyData {}
#[error]
pub struct NothingToLiquidate {}
pub msg LiquidationBorrowerMsg {
    #[selector = sol("onLiquidateTrove(uint256)")]
    Liquidate { id: u256 },
}
pub struct Values {
    pub coll_gas: u256, pub eth_gas: u256, pub debt_offset: u256, pub coll_sp: u256,
    pub debt_redist: u256, pub coll_redist: u256, pub surplus: u256, pub old_weighted: u256, pub new_weighted: u256,
}
impl Copy for Values {}
impl Values {
    pub fn zero() -> Self { Self { coll_gas: 0, eth_gas: 0, debt_offset: 0, coll_sp: 0, debt_redist: 0, coll_redist: 0, surplus: 0, old_weighted: 0, new_weighted: 0 } }
}
pub fn penalty(_ coll: u256, _ debt: u256, _ ratio: u256, _ price: u256) -> (u256, u256) {
    let maximum = debt * (DECIMAL_PRECISION + ratio) / price
    if coll > maximum { (maximum, coll - maximum) } else { (coll, 0) }
}
pub fn offset_values(_ debt: u256, _ coll: u256, _ sp: u256, _ price: u256, _ sp_penalty: u256, _ redist_penalty: u256) -> Values {
    var v = Values::zero()
    var portion: u256 = 0
    if sp > 0 {
        v.debt_offset = math::min(debt, sp)
        portion = coll * v.debt_offset / debt
        v.coll_gas = math::min(portion / COLL_GAS_COMPENSATION_DIVISOR, COLL_GAS_COMPENSATION_CAP)
        let result = penalty(portion - v.coll_gas, v.debt_offset, sp_penalty, price)
        v.coll_sp = result.0
        v.surplus = result.1
    }
    v.debt_redist = debt - v.debt_offset
    if v.debt_redist > 0 {
        let remainder = coll - portion
        if remainder > 0 {
            let result = penalty(remainder + v.surplus, v.debt_redist, redist_penalty, price)
            v.coll_redist = result.0
            v.surplus = result.1
        }
    }
    v
}
pub fn single(_ id: u256, _ sp: u256, _ price: u256, _ sp_penalty: u256, _ redist_penalty: u256) -> (LatestTroveData, Values) uses (ctx: Ctx, storage: mut RawStorage, call: mut Call, log: mut Log) {
    let nft = Address::from_word_truncate(read_storage_word(3))
    let owner = nft.static(TroveNFTMsg::OwnerOf { id })
    let t = data::latest_trove(id)
    let manager = data::load_trove(id).batch_manager
    var b = LatestBatchData::zero()
    if manager != Address::zero() { b = data::latest_batch(manager) }
    hooks::move_rewards(t.redist_bold_debt_gain, t.redist_coll_gain)
    var v = offset_values(t.entire_debt, t.entire_coll, sp, price, sp_penalty, redist_penalty)
    var change = TroveChange::zero()
    change.coll_decrease = t.entire_coll
    change.debt_decrease = t.entire_debt
    change.applied_redist_coll_gain = t.redist_coll_gain
    change.applied_redist_bold_debt_gain = t.redist_bold_debt_gain
    hooks::close(id, change, manager, b.entire_coll_without_redistribution, b.entire_debt_without_redistribution, 3)
    if manager != Address::zero() {
        v.old_weighted = b.weighted_recorded_debt + (t.entire_debt - t.redist_bold_debt_gain) * b.annual_interest_rate
        v.new_weighted = b.entire_debt_without_redistribution * b.annual_interest_rate
        change.batch_accrued_management_fee = b.accrued_management_fee
        change.old_weighted_recorded_batch_management_fee = b.weighted_recorded_batch_management_fee + (t.entire_debt - t.redist_bold_debt_gain) * b.annual_management_fee
        change.new_weighted_recorded_batch_management_fee = b.entire_debt_without_redistribution * b.annual_management_fee
        let active = Address::from_word_truncate(read_storage_word(0))
        require_code(active)
        active.call(ActivePoolMsg::BatchFee { change, batch: manager })
    } else { v.old_weighted = t.weighted_recorded_debt }
    if v.surplus > 0 {
        let surplus = Address::from_word_truncate(read_storage_word(7))
        require_code(surplus)
        surplus.call(CollSurplusPoolMsg::AccountSurplus { account: owner, amount: v.surplus })
    }
    let bo = Address::from_word_truncate(read_storage_word(4))
    require_code(bo)
    bo.call(LiquidationBorrowerMsg::Liquidate { id })
    log.emit(events::TroveUpdated { id, debt: 0, coll: 0, stake: 0, rate: 0, l_coll: 0, l_debt: 0 })
    let signed_debt: i256 = t.entire_debt.downcast_truncate()
    let signed_coll: i256 = t.entire_coll.downcast_truncate()
    log.emit(events::TroveOperation { id, operation: 5, rate: 0, redist_debt: t.redist_bold_debt_gain, upfront: 0, debt_change: -signed_debt, redist_coll: t.redist_coll_gain, coll_change: -signed_coll })
    if manager != Address::zero() {
        let current = data::load_batch(manager)
        log.emit(events::BatchUpdated { manager, operation: 5, debt: current.debt, coll: current.coll, rate: b.annual_interest_rate, fee: b.annual_management_fee, shares: current.total_shares, upfront: 0 })
    }
    (t, v)
}
pub fn redistribute(_ active: Address, _ default_pool: Address, _ debt: u256, _ coll: u256) uses (ctx: Ctx, storage: mut RawStorage, call: mut Call) {
    if debt == 0 { return }
    let coll_num = coll * DECIMAL_PRECISION + read_storage_word(data::COLL_ERROR)
    let debt_num = debt * DECIMAL_PRECISION + read_storage_word(data::DEBT_ERROR)
    let stakes = read_storage_word(data::TOTAL_STAKES)
    let coll_reward = coll_num / stakes
    let debt_reward = debt_num / stakes
    unsafe { storage.sstore(slot: data::COLL_ERROR, value: coll_num - coll_reward * stakes) }
    unsafe { storage.sstore(slot: data::DEBT_ERROR, value: debt_num - debt_reward * stakes) }
    unsafe { storage.sstore(slot: data::L_COLL, value: read_storage_word(data::L_COLL) + coll_reward) }
    unsafe { storage.sstore(slot: data::L_DEBT, value: read_storage_word(data::L_DEBT) + debt_reward) }
    require_code(default_pool)
    default_pool.call(DefaultPoolMsg::IncreaseBoldDebt { amount: debt })
    require_code(active)
    active.call(ActivePoolMsg::SendCollToDefaultPool { amount: coll })
}
pub fn liquidate(_ ids: DynArray<u256>, _ mcr: u256, _ sp_penalty: u256, _ redist_penalty: u256, _ weth: Address) uses (ctx: Ctx, storage: mut RawStorage, call: mut Call, log: mut Log) {
    if ids.len() == 0 { revert_error(EmptyData {}) }
    let active = Address::from_word_truncate(read_storage_word(0))
    let default_pool = Address::from_word_truncate(read_storage_word(1))
    let sp = Address::from_word_truncate(read_storage_word(5))
    var change = TroveChange::zero()
    var total = Values::zero()
    let feed = Address::from_word_truncate(read_storage_word(2))
    let price = feed.call(PriceMsg::Price {}).0
    let deposits = sp.static(StabilityPoolMsg::TotalBoldDeposits {})
    var remaining = deposits - math::min(MIN_BOLD_IN_SP, deposits)
    var i: u256 = 0
    while i < ids.len() {
        let id = ids.get(i)
        i += 1
        let status = data::load_trove(id).status
        if status != 1 && status != 4 { continue }
        let tcr = data::latest_trove(id)
        if math::compute_cr(tcr.entire_coll, tcr.entire_debt, price) < mcr {
            let result = single(id, remaining, price, sp_penalty, redist_penalty)
            let t = result.0
            let v = result.1
            remaining -= v.debt_offset
            total.coll_gas += v.coll_gas
            total.eth_gas += ETH_GAS_COMPENSATION
            change.debt_decrease += t.entire_debt
            change.coll_decrease += t.entire_coll
            change.applied_redist_bold_debt_gain += t.redist_bold_debt_gain
            change.old_weighted_recorded_debt += v.old_weighted
            change.new_weighted_recorded_debt += v.new_weighted
            total.debt_offset += v.debt_offset
            total.coll_sp += v.coll_sp
            total.debt_redist += v.debt_redist
            total.coll_redist += v.coll_redist
            total.surplus += v.surplus
        }
    }
    if change.debt_decrease == 0 { revert_error(NothingToLiquidate {}) }
    require_code(active)
    active.call(ActivePoolMsg::AccountTroveChange { change, batch: Address::zero() })
    if total.debt_offset > 0 || total.coll_sp > 0 {
        require_code(sp)
        sp.call(StabilityPoolMsg::Offset { debt: total.debt_offset, amount: total.coll_sp })
    }
    redistribute(active, default_pool, total.debt_redist, total.coll_redist)
    if total.surplus > 0 {
        let surplus = Address::from_word_truncate(read_storage_word(7))
        require_code(active)
        active.call(ActivePoolMsg::SendColl { account: surplus, amount: total.surplus })
    }
    unsafe { storage.sstore(slot: data::STAKES_SNAPSHOT, value: read_storage_word(data::TOTAL_STAKES)) }
    let active_coll = active.static(BranchPoolMsg::CollBalance {})
    let current_default = Address::from_word_truncate(read_storage_word(1))
    let default_coll = current_default.static(BranchPoolMsg::CollBalance {})
    unsafe { storage.sstore(slot: data::COLL_SNAPSHOT, value: active_coll - total.coll_gas + default_coll) }
    log.emit(events::Liquidation { debt_offset: total.debt_offset, debt_redistributed: total.debt_redist, bold_gas: total.eth_gas, coll_gas: total.coll_gas, coll_sp: total.coll_sp, coll_redistributed: total.coll_redist, surplus: total.surplus, l_coll: read_storage_word(data::L_COLL), l_debt: read_storage_word(data::L_DEBT), price })
    if total.eth_gas > 0 {
        let gas_pool = Address::from_word_truncate(read_storage_word(6))
        let ignored = weth.call(TokenMsg::TransferFrom { owner: gas_pool, receiver: ctx.caller(), amount: total.eth_gas })
    }
    if total.coll_gas > 0 {
        require_code(active)
        active.call(ActivePoolMsg::SendColl { account: ctx.caller(), amount: total.coll_gas })
    }
}
