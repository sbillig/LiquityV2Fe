// SPDX-License-Identifier: MIT
use core::num::IntDowncast
use std::abi::{sol, Bytes32}
use std::evm::{Address, Ctx, Call, RawOps}
use super::address_word::{AddressWord, checked_address}
use super::token_calls::TokenMsg
use super::leftovers_sweep::BalanceMsg
use super::revert_texts::require
use super::user_proxy_errors as error
// Address words and v are validated only after the authorization checks.
#[abi]
pub struct PermitParams { pub owner: AddressWord, pub spender: AddressWord, pub value: u256, pub deadline: u256, pub v: u256, pub r: Bytes32, pub s: Bytes32 }
impl Copy for PermitParams {}
pub struct Config { pub lqty: Address, pub lusd: Address, pub staking: Address, pub v2: Address }
impl Copy for Config {}
pub msg ProxyCalls {
    #[selector = sol("stake(uint256)")]
    Stake { amount: u256 },
    #[selector = sol("unstake(uint256)")]
    Unstake { amount: u256 },
    #[selector = sol("stakes(address)")]
    Stakes { account: Address } -> u256,
    #[selector = sol("permit(address,address,uint256,uint256,uint8,bytes32,bytes32)")]
    Permit { owner: Address, spender: Address, value: u256, deadline: u256, v: u8, r: Bytes32, s: Bytes32 },
}
pub msg UserProxyMsg {
    #[selector = sol("lqty()")]
    Lqty -> Address,
    #[selector = sol("lusd()")]
    Lusd -> Address,
    #[selector = sol("stakingV1()")]
    V1 -> Address,
    #[selector = sol("stakingV2()")]
    V2 -> Address,
    #[selector = sol("staked()")]
    Staked -> u256,
    #[selector = sol("stake(uint256,address,bool,address)")]
    Stake { amount: u256, from: Address, send: bool, recipient: Address } -> (u256, u256, u256, u256),
    // Numeric selector permits the deliberately lazy calldata uint8/address decoder.
    #[selector = 0xeb876bf7]
    StakePermit { amount: u256, from: Address, p: PermitParams, send: bool, recipient: Address } -> (u256, u256, u256, u256),
    #[selector = sol("unstake(uint256,bool,address)")]
    Unstake { amount: u256, send: bool, recipient: Address } -> (u256, u256, u256, u256, u256, u256),
}
fn require_code(_ target: Address) uses (ctx: Ctx) {
    if ctx.extcodesize(target) == 0 { std::evm::revert(()) }
}
fn send_rewards(_ cfg: Config, _ recipient: Address, _ lusd: u256, _ eth: u256) -> (u256, u256)
uses (ctx: Ctx, call: mut Call) {
    if lusd > 0 { let ignored = cfg.lusd.call(TokenMsg::Transfer { receiver: recipient, amount: lusd }) }
    if eth > 0 {
        var output = core::ptr::MemBuffer::empty()
        let result = call.raw_call(addr: recipient, gas: ctx.gas(), value: eth, args: core::ptr::MemSpan::empty(), ret: mut output)
        require(result.success(), error::eth())
    }
    (lusd, eth)
}
fn stake(_ cfg: Config, _ amount: u256, _ from: Address, _ send: bool, _ recipient: Address) -> (u256, u256, u256, u256)
uses (ctx: Ctx, call: mut Call) {
    require(ctx.caller() == cfg.v2, error::caller())
    let before_lusd = cfg.lusd.static(BalanceMsg::Balance { account: ctx.address() })
    let before_eth = ctx.selfbalance()
    let ignored = cfg.lqty.call(TokenMsg::TransferFrom { owner: from, receiver: ctx.address(), amount })
    require_code(cfg.staking)
    cfg.staking.call(ProxyCalls::Stake { amount })
    let lusd = cfg.lusd.static(BalanceMsg::Balance { account: ctx.address() })
    let eth = ctx.selfbalance()
    let received_lusd = lusd - before_lusd
    let received_eth = eth - before_eth
    let (sent_lusd, sent_eth) = if send { send_rewards(cfg, recipient, lusd, eth) } else { (0, 0) }
    (received_lusd, sent_lusd, received_eth, sent_eth)
}
pub contract UserProxy {
    cfg: Config,
    init(lqty: Address, lusd: Address, staking: Address) uses (mut cfg, ctx: Ctx) {
        cfg = Config { lqty, lusd, staking, v2: ctx.caller() }
    }
    recv {
        UserProxyMsg::Lqty {} -> Address uses (cfg) { cfg.lqty }
        UserProxyMsg::Lusd {} -> Address uses (cfg) { cfg.lusd }
        UserProxyMsg::V1 {} -> Address uses (cfg) { cfg.staking }
        UserProxyMsg::V2 {} -> Address uses (cfg) { cfg.v2 }
        UserProxyMsg::Staked {} -> u256 uses (cfg, ctx: Ctx, call: Call) { cfg.staking.static(ProxyCalls::Stakes { account: ctx.address() }) }
        UserProxyMsg::Stake { amount, from, send, recipient } -> (u256, u256, u256, u256) uses (cfg, ctx: Ctx, call: mut Call) {
            stake(cfg, amount, from, send, recipient)
        }
        UserProxyMsg::StakePermit { amount, from, p, send, recipient } -> (u256, u256, u256, u256) uses (cfg, ctx: Ctx, call: mut Call) {
            require(ctx.caller() == cfg.v2, error::caller())
            require(from == checked_address(p.owner), error::owner())
            let owner = checked_address(p.owner)
            let spender = checked_address(p.spender)
            if p.v > 255 { std::evm::revert(()) }
            require_code(cfg.lqty)
            let ignored = cfg.lqty.try_call(ProxyCalls::Permit { owner, spender, value: p.value, deadline: p.deadline, v: p.v.downcast_truncate(), r: p.r, s: p.s })
            stake(cfg, amount, from, send, recipient)
        }
        UserProxyMsg::Unstake { amount, send, recipient } -> (u256, u256, u256, u256, u256, u256) uses (cfg, ctx: Ctx, call: mut Call) {
            require(ctx.caller() == cfg.v2, error::caller())
            let before_lqty = cfg.lqty.static(BalanceMsg::Balance { account: ctx.address() })
            let before_lusd = cfg.lusd.static(BalanceMsg::Balance { account: ctx.address() })
            let before_eth = ctx.selfbalance()
            require_code(cfg.staking)
            cfg.staking.call(ProxyCalls::Unstake { amount })
            let lqty = cfg.lqty.static(BalanceMsg::Balance { account: ctx.address() })
            let lusd = cfg.lusd.static(BalanceMsg::Balance { account: ctx.address() })
            let eth = ctx.selfbalance()
            let received_lqty = lqty - before_lqty
            let received_lusd = lusd - before_lusd
            let received_eth = eth - before_eth
            if lqty > 0 { let ignored = cfg.lqty.call(TokenMsg::Transfer { receiver: recipient, amount: lqty }) }
            let (sent_lusd, sent_eth) = if send { send_rewards(cfg, recipient, lusd, eth) } else { (0, 0) }
            (received_lqty, lqty, received_lusd, sent_lusd, received_eth, sent_eth)
        }
        #[payable]
        _ uses (ops: mut RawOps) {
            if ops.calldatasize() != 0 { ops.revert(data: core::ptr::MemSpan::empty()) }
        }
    }
}
