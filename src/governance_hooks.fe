use std::evm::{Address, Ctx, Call}
use std::abi::DynString
use super::revert_texts::require
#[arithmetic(unchecked)]
pub fn has_min_gas(_ minimum: u256, _ reserved: u256) -> bool uses (ctx: Ctx) {
    ctx.gas() * 63 >= minimum * 64 + (40000 + reserved) * 63
}
fn gas_error() -> DynString { "Must have minGas" }
pub fn safe_call(_ target: Address, _ gas: u256, _ value: u256, _ data: core::ptr::MemSpan) -> bool
uses (ctx: Ctx, call: mut Call) {
    require(has_min_gas(gas, 1000), gas_error())
    var ignored = core::ptr::MemBuffer::empty()
    let result = call.raw_call(addr: target, gas, value, args: data, ret: mut ignored)
    result.success()
}
