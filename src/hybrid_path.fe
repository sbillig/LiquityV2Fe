// SPDX-License-Identifier: MIT
use std::abi::{Bytes, Uint24}
use std::evm::{Address}
// Uniswap v3 path: address (20 bytes), fee (3 bytes), address, optional second hop.
pub fn path(_ usdc: Address, _ weth: Address, _ coll: Address, _ fee_uw: Uint24, _ fee_wc: Uint24, _ reverse: bool) -> Bytes {
    var out = core::ptr::MemBuffer::with_capacity(96)
    let single = weth == coll
    let first = if reverse { coll } else { usdc }
    let last = if reverse { usdc } else { coll }
    let first_fee = if reverse && !single { fee_wc.val } else { fee_uw.val }
    let second_fee = if reverse { fee_uw.val } else { fee_wc.val }
    out.write_word(offset: 0, value: first.word() << 96)
    out.write_word(offset: 20, value: (first_fee as u256) << 232)
    if single {
        out.write_word(offset: 23, value: last.word() << 96)
        Bytes::from_payload(source: out.slice(offset: 0, len: 43))
    } else {
        out.write_word(offset: 23, value: weth.word() << 96)
        out.write_word(offset: 43, value: (second_fee as u256) << 232)
        out.write_word(offset: 46, value: last.word() << 96)
        Bytes::from_payload(source: out.slice(offset: 0, len: 66))
    }
}
