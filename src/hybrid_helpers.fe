use core::num::IntDowncast
use std::abi::{sol, Uint24}
use std::evm::{Address, Call, RawOps}
use super::quote_calls::{QuoteCalls, quote}
use super::hybrid_path::path
pub struct Config { pub usdc: Address, pub weth: Address, pub pool: Address, pub usdc_index: u128, pub bold_index: u128, pub fee_uw: Uint24, pub fee_wc: Uint24, pub quoter: Address }
impl Copy for Config {}
pub msg HelperMsg {
    #[selector = sol("USDC()")]
    Usdc -> Address,
    #[selector = sol("WETH()")]
    Weth -> Address,
    #[selector = sol("curvePool()")]
    Pool -> Address,
    #[selector = sol("USDC_INDEX()")]
    UsdcIndex -> u128,
    #[selector = sol("BOLD_TOKEN_INDEX()")]
    BoldIndex -> u128,
    #[selector = sol("feeUsdcWeth()")]
    FeeUW -> Uint24,
    #[selector = sol("feeWethColl()")]
    FeeWC -> Uint24,
    #[selector = sol("uniV3Quoter()")]
    Quoter -> Address,
    #[selector = sol("getCollFromBold(uint256,address,uint256)")]
    FromBold { amount: u256, coll: Address, desired: u256 } -> (u256, u256),
}
pub contract HybridCurveUniV3ExchangeHelpers {
    cfg: Config,
    init(usdc: Address, weth: Address, pool: Address, usdc_index: u128, bold_index: u128, fee_uw: Uint24, fee_wc: Uint24, quoter: Address) uses (mut cfg) {
        cfg = Config { usdc, weth, pool, usdc_index, bold_index, fee_uw, fee_wc, quoter }
    }
    recv HelperMsg {
        Usdc -> Address uses (cfg) { cfg.usdc }
        Weth -> Address uses (cfg) { cfg.weth }
        Pool -> Address uses (cfg) { cfg.pool }
        UsdcIndex -> u128 uses (cfg) { cfg.usdc_index }
        BoldIndex -> u128 uses (cfg) { cfg.bold_index }
        FeeUW -> Uint24 uses (cfg) { cfg.fee_uw }
        FeeWC -> Uint24 uses (cfg) { cfg.fee_wc }
        Quoter -> Address uses (cfg) { cfg.quoter }
        FromBold { amount, coll, desired } -> (u256, u256) uses (cfg, call: mut Call, ops: mut RawOps) {
            let intermediate = cfg.pool.static(QuoteCalls::Dy { input: cfg.bold_index.downcast_truncate(), output: cfg.usdc_index.downcast_truncate(), amount })
            let route = path(cfg.usdc, cfg.weth, coll, cfg.fee_uw, cfg.fee_wc, false)
            let quoted = quote(cfg.quoter, route, intermediate, false, true)
            let deviation = if desired > 0 && quoted <= desired { 1000000000000000000 - quoted * 1000000000000000000 / desired } else { 0 }
            (quoted, deviation)
        }
    }
}
