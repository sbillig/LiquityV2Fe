use core::num::IntDowncast
use std::abi::{DynArray, DynArrayAccess, MemVec}
use std::evm::{Address, Ctx, RawMem, RawStorage, Call, Log}
use super::governance_actions::ActionConfig
use super::governance_allocation as allocation
use super::governance_guard as guard
use super::governance_allocation_errors as error
use super::revert_texts::require
fn no_duplicates(_ values: DynArray<Address>) uses (mem: mut RawMem) {
    let mut i = 0
    while i + 1 < values.len() {
        let mut j = i + 1
        while j < values.len() {
            require(values.get(i) != values.get(j), error::duplicate())
            j += 1
        }
        i += 1
    }
}
fn no_negatives(_ values: DynArray<i256>) uses (mem: mut RawMem) {
    let mut i = 0
    while i < values.len() { require(values.get(i) >= 0, error::negative())
        i += 1 }
}
#[inline(never)]
fn reset_inner(_ cfg: ActionConfig, _ targets: DynArray<Address>) -> DynArray<i256>
uses (ctx: Ctx, mem: mut RawMem, storage: mut RawStorage, call: mut Call, log: mut Log) {
    let n = targets.len()
    let mut cached: MemVec<i256> = MemVec::zeroed(n)
    let mut votes: MemVec<i256> = MemVec::zeroed(n)
    let mut vetos: MemVec<i256> = MemVec::zeroed(n)
    let mut vote_offsets: MemVec<i256> = MemVec::zeroed(n)
    let mut veto_offsets: MemVec<i256> = MemVec::zeroed(n)
    let mut i = 0
    while i < n {
        let old = allocation::read_allocation(ctx.caller(), targets.get(i))
        require(old.0 > 0 || old.2 > 0, error::nothing())
        let v: i256 = old.0.downcast_truncate()
        let t: i256 = old.2.downcast_truncate()
        let ov: i256 = old.1.downcast_truncate()
        let ot: i256 = old.3.downcast_truncate()
        cached.set(index: i, value: v)
        votes.set(index: i, value: -v)
        vetos.set(index: i, value: -t)
        vote_offsets.set(index: i, value: -ov)
        veto_offsets.set(index: i, value: -ot)
        i += 1
    }
    allocation::apply(cfg, targets, votes.to_dyn_array(), vetos.to_dyn_array(), vote_offsets.to_dyn_array(), veto_offsets.to_dyn_array())
    cached.to_dyn_array()
}
pub fn reset(_ cfg: ActionConfig, _ targets: DynArray<Address>, _ check_all: bool)
uses (ctx: Ctx, mem: mut RawMem, storage: mut RawStorage, call: mut Call, log: mut Log) {
    guard::enter()
    no_duplicates(targets)
    let ignored = reset_inner(cfg, targets)
    if check_all { require(allocation::read_user(ctx.caller()).2 == 0, error::reset_all()) }
    guard::exit()
}
pub fn allocate(_ cfg: ActionConfig, _ cutoff: u256, _ reset_targets: DynArray<Address>, _ targets: DynArray<Address>, _ votes: DynArray<i256>, _ vetos: DynArray<i256>)
uses (ctx: Ctx, mem: mut RawMem, storage: mut RawStorage, call: mut Call, log: mut Log) {
    guard::enter()
    require(targets.len() == votes.len() && votes.len() == vetos.len(), error::length())
    no_duplicates(reset_targets)
    no_duplicates(targets)
    no_negatives(votes)
    no_negatives(vetos)
    let mut i = 0
    while i < votes.len() { require(votes.get(i) > 0 || vetos.get(i) > 0, error::nop())
        i += 1 }
    i = 0
    while i < votes.len() { require(votes.get(i) == 0 || vetos.get(i) == 0, error::simultaneous())
        i += 1 }
    let cached = reset_inner(cfg, reset_targets)
    let mut user = allocation::read_user(ctx.caller())
    require(user.2 == 0, error::reset())
    require(user.0 != 0, error::insufficient())
    if (ctx.timestamp() - cfg.snapshots.start) % cfg.snapshots.duration > cutoff {
        i = 0
        while i < targets.len() {
            let mut found = false
            let mut j = 0
            while j < reset_targets.len() {
                if reset_targets.get(j) == targets.get(i) {
                    found = true
                    require(votes.get(i) <= cached.get(j), error::increase())
                    break
                }
                j += 1
            }
            if !found { require(votes.get(i) == 0, error::new_votes()) }
            i += 1
        }
    }
    let mut offsets_v: MemVec<i256> = MemVec::zeroed(targets.len())
    let mut offsets_t: MemVec<i256> = MemVec::zeroed(targets.len())
    i = 0
    while i < targets.len() {
        let is_vote = votes.get(i) > 0
        let qty: u256 = if is_vote { votes.get(i).downcast_truncate() } else { vetos.get(i).downcast_truncate() }
        let offset = user.1 * qty / user.0
        user.0 -= qty
        user.1 -= offset
        if is_vote { offsets_v.set(index: i, value: offset.downcast_truncate()) }
        else { offsets_t.set(index: i, value: offset.downcast_truncate()) }
        i += 1
    }
    // Solidity copies address[] calldata to memory at this call boundary.
    i = 0
    while i < targets.len() { let checked = targets.get(i)
        i += 1 }
    allocation::apply(cfg, targets, votes, vetos, offsets_v.to_dyn_array(), offsets_t.to_dyn_array())
    guard::exit()
}
