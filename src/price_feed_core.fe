// SPDX-License-Identifier: MIT
use core::num::IntDowncast
use std::abi::sol
use std::evm::{Address, Ctx, Call, Log, RawStorage, revert_error}
#[error]
pub struct InsufficientGasForExternalCall {}
#[event]
pub struct ShutDownFromOracleFailure { pub failed_oracle: Address }
pub msg OracleMsg {
    #[selector = sol("decimals()")]
    Decimals -> u8,
    #[selector = sol("latestRoundData()")]
    Round -> (u256, i256, u256, u256, u256),
    #[selector = sol("getExchangeRate()")]
    RethRate -> u256,
    #[selector = sol("stEthPerToken()")]
    WstethRate -> u256,
    #[selector = sol("shutdownFromOracleFailure()")]
    Shutdown,
}
pub fn address_at(_ slot: u256) -> Address uses (storage: RawStorage) {
    Address { inner: unsafe { storage.sload(slot) } & 0xffffffffffffffffffffffffffffffffffffffff }
}
pub fn source() -> u8 uses (storage: RawStorage) { (unsafe { storage.sload(0) } & 255).downcast_truncate() }
pub fn set_source(_ value: u256) uses (storage: mut RawStorage) { unsafe { storage.sstore(slot: 0, value: (unsafe { storage.sload(0) } & ~255) | value) } }
pub fn oracle(_ slot: u256) -> (Address, u256, u8) uses (storage: RawStorage) {
    (address_at(slot), unsafe { storage.sload(slot + 1) }, (unsafe { storage.sload(slot + 2) } & 255).downcast_truncate())
}
pub fn init_oracle(_ slot: u256, _ aggregator: Address, _ threshold: u256) uses (storage: mut RawStorage, call: mut Call) {
    unsafe { storage.sstore(slot: slot, value: aggregator.inner) }
    unsafe { storage.sstore(slot: slot + 1, value: threshold) }
    let decimals = aggregator.static(OracleMsg::Decimals {})
    unsafe { storage.sstore(slot: slot + 2, value: decimals as u256) }
}
pub fn init_base(_ aggregator: Address, _ threshold: u256, _ borrower: Address) uses (storage: mut RawStorage, call: mut Call) {
    init_oracle(2, aggregator, threshold)
    unsafe { storage.sstore(slot: 5, value: borrower.inner) }
    assert(unsafe { storage.sload(4) } == 8)
}
pub fn answer(_ slot: u256) -> (u256, bool) uses (ctx: Ctx, storage: RawStorage, call: mut Call) {
    let (aggregator, threshold, decimals) = oracle(slot)
    let before = ctx.gas()
    let response = aggregator.try_static(OracleMsg::Round {})
    if !response.success() {
        if ctx.gas() <= before / 64 { revert_error(InsufficientGasForExternalCall {}) }
        return (0, true)
    }
    let decoded: (u256, i256, u256, u256, u256) = response.decode()
    if decoded.0 >> 80 != 0 || decoded.4 >> 80 != 0 { std::evm::revert(()) }
    if ctx.timestamp() - decoded.3 >= threshold || decoded.1 <= 0 { return (0, true) }
    let exponent = 18 - (decimals as u256)
    var scale: u256 = 1
    var i = 0
    while i < exponent { scale *= 10
i += 1 }
    let value: u256 = decoded.1.downcast_truncate()
    (value * scale, false)
}
pub fn canonical(_ reth: bool) -> (u256, bool) uses (ctx: Ctx, storage: RawStorage, call: mut Call) {
    let provider = address_at(6)
    let before = ctx.gas()
    let response = if reth { provider.try_static(OracleMsg::RethRate {}) } else { provider.try_static(OracleMsg::WstethRate {}) }
    if !response.success() {
        if ctx.gas() <= before / 64 { revert_error(InsufficientGasForExternalCall {}) }
        return (0, true)
    }
    let rate: u256 = response.decode()
    (rate, rate == 0)
}
pub fn shutdown(_ failed: Address, _ new_source: u256) uses (ctx: Ctx, storage: mut RawStorage, call: mut Call, log: mut Log) {
    let borrower = address_at(5)
    if ctx.extcodesize(borrower) == 0 { std::evm::revert(()) }
    borrower.call(OracleMsg::Shutdown {})
    set_source(new_source)
    log.emit(ShutDownFromOracleFailure { failed_oracle: failed })
}
pub fn min(_ a: u256, _ b: u256) -> u256 { if a < b { a } else { b } }
pub fn max(_ a: u256, _ b: u256) -> u256 { if a > b { a } else { b } }
pub fn within(_ price: u256, _ reference: u256, _ deviation: u256) -> bool {
    let maximum = reference * (1000000000000000000 + deviation) / 1000000000000000000
    let minimum = reference * (1000000000000000000 - deviation) / 1000000000000000000
    price >= minimum && price <= maximum
}
pub fn fallback_price(_ eth: u256, _ reth: bool) -> u256 uses (ctx: Ctx, storage: mut RawStorage, call: mut Call) {
    assert(source() == 1)
    let (rate, down) = canonical(reth)
    if down { set_source(2)
return unsafe { storage.sload(1) } }
    let price = eth * rate / 1000000000000000000
    let best = min(price, unsafe { storage.sload(1) })
    unsafe { storage.sstore(slot: 1, value: best) }
    best
}
pub fn during_shutdown(_ reth: bool) -> (u256, bool) uses (ctx: Ctx, storage: mut RawStorage, call: mut Call) {
    if source() == 1 {
        let (eth, down) = answer(2)
        if down { set_source(2)
return (unsafe { storage.sload(1) }, false) }
        return (fallback_price(eth, reth), false)
    }
    assert(source() == 2)
    (unsafe { storage.sload(1) }, false)
}
pub fn weth() -> (u256, bool) uses (ctx: Ctx, storage: mut RawStorage, call: mut Call, log: mut Log) {
    if source() != 0 { assert(source() == 2)
return (unsafe { storage.sload(1) }, false) }
    let (price, down) = answer(2)
    if down { shutdown(address_at(2), 2)
return (unsafe { storage.sload(1) }, true) }
    unsafe { storage.sstore(slot: 1, value: price) }
    (price, false)
}
pub fn composite(_ reth: bool, _ redemption: bool) -> (u256, bool) uses (ctx: Ctx, storage: mut RawStorage, call: mut Call, log: mut Log) {
    if source() != 0 { return during_shutdown(reth) }
    var eth = 0
    var eth_down = false
    var market = 0
    var market_down = false
    var rate = 0
    var rate_down = false
    if reth {
        let (v, d) = answer(2)
eth = v
eth_down = d
        let (v2, d2) = answer(7)
market = v2
market_down = d2
        let (v3, d3) = canonical(true)
rate = v3
rate_down = d3
        if eth_down { shutdown(address_at(2), 2)
return (unsafe { storage.sload(1) }, true) }
        if rate_down { shutdown(address_at(6), 2)
return (unsafe { storage.sload(1) }, true) }
    } else {
        let (v, d) = answer(7)
market = v
market_down = d
        let (v2, d2) = canonical(false)
rate = v2
rate_down = d2
        let (v3, d3) = answer(2)
eth = v3
eth_down = d3
        if rate_down { shutdown(address_at(6), 2)
return (unsafe { storage.sload(1) }, true) }
        if eth_down { shutdown(address_at(2), 2)
return (unsafe { storage.sload(1) }, true) }
    }
    if market_down {
        shutdown(address_at(7), 1)
        return (fallback_price(eth, reth), true)
    }
    let price = if reth {
        let market_usd = eth * market / 1000000000000000000
        let canonical_usd = eth * rate / 1000000000000000000
        if redemption && within(market_usd, canonical_usd, 20000000000000000) { max(market_usd, canonical_usd) } else { min(market_usd, canonical_usd) }
    } else {
        let underlying = if redemption && within(market, eth, 10000000000000000) { max(market, eth) } else { market }
        underlying * rate / 1000000000000000000
    }
    unsafe { storage.sstore(slot: 1, value: price) }
    (price, false)
}
