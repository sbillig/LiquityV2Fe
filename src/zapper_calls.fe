use core::abi::{AbiSize, AbiSpan, AbiDecoder, ByteInput, Decode, Encode}
use std::abi::{sol, Sol, Bytes}
use std::evm::Address
use super::types::LatestTroveData
pub struct OpenParams { pub owner: Address, pub index: u256, pub coll: u256, pub bold: u256, pub upper: u256, pub lower: u256, pub rate: u256, pub batch: Address, pub fee: u256, pub add: Address, pub remove: Address, pub receiver: Address }
impl AbiSize for OpenParams { const HEAD_SIZE: u256 = 384
 const IS_DYNAMIC: bool = false }
impl AbiSpan<Sol> for OpenParams { fn payload_end<I: ByteInput>(_: I, base: u256, pos: u256) -> u256 { pos + 384 } }
impl Decode<Sol> for OpenParams { fn decode_payload<D: AbiDecoder<Sol>>(_ d: mut D) -> Self {
let owner = Address { inner: d.read_word() }
let index = d.read_word()
let coll = d.read_word()
let bold = d.read_word()
let upper = d.read_word()
let lower = d.read_word()
let rate = d.read_word()
let batch = Address { inner: d.read_word() }
let fee = d.read_word()
let add = Address { inner: d.read_word() }
let remove = Address { inner: d.read_word() }
let receiver = Address { inner: d.read_word() }
Self { owner, index, coll, bold, upper, lower, rate, batch, fee, add, remove, receiver }
} }
impl Encode<Sol> for OpenParams { fn encode(own self, _ p: *u8) {
<Address as Encode<Sol>>::encode(self.owner, core::ptr::offset_bytes(p, 0))
<u256 as Encode<Sol>>::encode(self.index, core::ptr::offset_bytes(p, 32))
<u256 as Encode<Sol>>::encode(self.coll, core::ptr::offset_bytes(p, 64))
<u256 as Encode<Sol>>::encode(self.bold, core::ptr::offset_bytes(p, 96))
<u256 as Encode<Sol>>::encode(self.upper, core::ptr::offset_bytes(p, 128))
<u256 as Encode<Sol>>::encode(self.lower, core::ptr::offset_bytes(p, 160))
<u256 as Encode<Sol>>::encode(self.rate, core::ptr::offset_bytes(p, 192))
<Address as Encode<Sol>>::encode(self.batch, core::ptr::offset_bytes(p, 224))
<u256 as Encode<Sol>>::encode(self.fee, core::ptr::offset_bytes(p, 256))
<Address as Encode<Sol>>::encode(self.add, core::ptr::offset_bytes(p, 288))
<Address as Encode<Sol>>::encode(self.remove, core::ptr::offset_bytes(p, 320))
<Address as Encode<Sol>>::encode(self.receiver, core::ptr::offset_bytes(p, 352))
} }
pub struct CloseParams { pub id: u256, pub amount: u256, pub minimum: u256, pub receiver: Address }
impl AbiSize for CloseParams { const HEAD_SIZE: u256 = 128
 const IS_DYNAMIC: bool = false }
impl AbiSpan<Sol> for CloseParams { fn payload_end<I: ByteInput>(_: I, base: u256, pos: u256) -> u256 { pos + 128 } }
impl Decode<Sol> for CloseParams { fn decode_payload<D: AbiDecoder<Sol>>(_ d: mut D) -> Self {
let id = d.read_word()
let amount = d.read_word()
let minimum = d.read_word()
let receiver = Address { inner: d.read_word() }
Self { id, amount, minimum, receiver }
} }
impl Encode<Sol> for CloseParams { fn encode(own self, _ p: *u8) {
<u256 as Encode<Sol>>::encode(self.id, core::ptr::offset_bytes(p, 0))
<u256 as Encode<Sol>>::encode(self.amount, core::ptr::offset_bytes(p, 32))
<u256 as Encode<Sol>>::encode(self.minimum, core::ptr::offset_bytes(p, 64))
<Address as Encode<Sol>>::encode(self.receiver, core::ptr::offset_bytes(p, 96))
} }
pub struct LeveragedOpenParams { pub owner: Address, pub index: u256, pub coll: u256, pub flash: u256, pub bold: u256, pub upper: u256, pub lower: u256, pub rate: u256, pub batch: Address, pub fee: u256, pub add: Address, pub remove: Address, pub receiver: Address }
impl AbiSize for LeveragedOpenParams { const HEAD_SIZE: u256 = 416
 const IS_DYNAMIC: bool = false }
impl AbiSpan<Sol> for LeveragedOpenParams { fn payload_end<I: ByteInput>(_: I, base: u256, pos: u256) -> u256 { pos + 416 } }
impl Decode<Sol> for LeveragedOpenParams { fn decode_payload<D: AbiDecoder<Sol>>(_ d: mut D) -> Self {
let owner_word = d.read_word()
let owner = Address { inner: owner_word }
let index = d.read_word()
let coll = d.read_word()
let flash = d.read_word()
let bold = d.read_word()
let upper = d.read_word()
let lower = d.read_word()
let rate = d.read_word()
let batch_word = d.read_word()
let batch = Address { inner: batch_word }
let fee = d.read_word()
let add_word = d.read_word()
let add = Address { inner: add_word }
let remove_word = d.read_word()
let remove = Address { inner: remove_word }
let receiver_word = d.read_word()
let receiver = Address { inner: receiver_word }
Self { owner, index, coll, flash, bold, upper, lower, rate, batch, fee, add, remove, receiver }
} }
impl Encode<Sol> for LeveragedOpenParams { fn encode(own self, _ p: *u8) {
<Address as Encode<Sol>>::encode(self.owner, core::ptr::offset_bytes(p, 0))
<u256 as Encode<Sol>>::encode(self.index, core::ptr::offset_bytes(p, 32))
<u256 as Encode<Sol>>::encode(self.coll, core::ptr::offset_bytes(p, 64))
<u256 as Encode<Sol>>::encode(self.flash, core::ptr::offset_bytes(p, 96))
<u256 as Encode<Sol>>::encode(self.bold, core::ptr::offset_bytes(p, 128))
<u256 as Encode<Sol>>::encode(self.upper, core::ptr::offset_bytes(p, 160))
<u256 as Encode<Sol>>::encode(self.lower, core::ptr::offset_bytes(p, 192))
<u256 as Encode<Sol>>::encode(self.rate, core::ptr::offset_bytes(p, 224))
<Address as Encode<Sol>>::encode(self.batch, core::ptr::offset_bytes(p, 256))
<u256 as Encode<Sol>>::encode(self.fee, core::ptr::offset_bytes(p, 288))
<Address as Encode<Sol>>::encode(self.add, core::ptr::offset_bytes(p, 320))
<Address as Encode<Sol>>::encode(self.remove, core::ptr::offset_bytes(p, 352))
<Address as Encode<Sol>>::encode(self.receiver, core::ptr::offset_bytes(p, 384))
} }

pub msg ZapperCalls {
    #[selector = sol("swapFromBold(uint256,uint256)")]
    SwapFrom { amount: u256, minimum: u256 },
    #[selector = sol("approve(address,uint256)")]
    Approve { spender: Address, amount: u256 } -> bool,
    #[selector = sol("deposit()")]
    Deposit,
    #[selector = sol("withdraw(uint256)")]
    Withdraw { amount: u256 },
    #[selector = sol("getLatestTroveData(uint256)")]
    Trove { id: u256 } -> LatestTroveData,
    #[selector = sol("openTrove(address,uint256,uint256,uint256,uint256,uint256,uint256,uint256,address,address,address)")]
    Open { owner: Address, index: u256, coll: u256, bold: u256, upper: u256, lower: u256, rate: u256, fee: u256, add: Address, remove: Address, receiver: Address } -> u256,
    #[selector = sol("openTroveAndJoinInterestBatchManager((address,uint256,uint256,uint256,uint256,uint256,address,uint256,address,address,address))")]
    OpenBatch { p: (Address, u256, u256, u256, u256, u256, Address, u256, Address, Address, Address) } -> u256,
    #[selector = sol("addColl(uint256,uint256)")]
    Add { id: u256, amount: u256 },
    #[selector = sol("withdrawColl(uint256,uint256)")]
    WithdrawColl { id: u256, amount: u256 },
    #[selector = sol("withdrawBold(uint256,uint256,uint256)")]
    WithdrawBold { id: u256, amount: u256, fee: u256 },
    #[selector = sol("repayBold(uint256,uint256)")]
    Repay { id: u256, amount: u256 },
    #[selector = sol("adjustTrove(uint256,uint256,bool,uint256,bool,uint256)")]
    Adjust { id: u256, coll: u256, coll_increase: bool, debt: u256, debt_increase: bool, fee: u256 },
    #[selector = sol("adjustZombieTrove(uint256,uint256,bool,uint256,bool,uint256,uint256,uint256)")]
    AdjustZombie { id: u256, coll: u256, coll_increase: bool, debt: u256, debt_increase: bool, upper: u256, lower: u256, fee: u256 },
    #[selector = sol("closeTrove(uint256)")]
    Close { id: u256 },
    #[selector = sol("swapToBold(uint256,uint256)")]
    Swap { amount: u256, minimum: u256 } -> u256,
    #[selector = sol("makeFlashLoan(address,uint256,uint8,bytes)")]
    Flash { token: Address, amount: u256, operation: u8, data: Bytes },
}

// Solidity calldata-struct addresses are validated when consumed, not eagerly.
// The no-op leverage callbacks therefore accept unused noncanonical fields.
pub fn checked_address(_ value: Address) -> Address {
    if value.inner >> 160 != 0 { std::evm::revert(()) }
    value
}
