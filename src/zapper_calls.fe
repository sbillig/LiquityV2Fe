// SPDX-License-Identifier: MIT
use std::abi::{sol, Bytes}
use std::evm::Address
use super::types::LatestTroveData
pub use super::address_word::{AddressWord, checked_address}

// These wire records deliberately defer address validation until consumption.
#[abi]
pub struct OpenParams { pub owner: AddressWord, pub index: u256, pub coll: u256, pub bold: u256, pub upper: u256, pub lower: u256, pub rate: u256, pub batch: AddressWord, pub fee: u256, pub add: AddressWord, pub remove: AddressWord, pub receiver: AddressWord }

#[abi]
pub struct CloseParams { pub id: u256, pub amount: u256, pub minimum: u256, pub receiver: AddressWord }

#[abi]
pub struct LeveragedOpenParams { pub owner: AddressWord, pub index: u256, pub coll: u256, pub flash: u256, pub bold: u256, pub upper: u256, pub lower: u256, pub rate: u256, pub batch: AddressWord, pub fee: u256, pub add: AddressWord, pub remove: AddressWord, pub receiver: AddressWord }

pub msg ZapperCalls {
    #[selector = sol("swapFromBold(uint256,uint256)")]
    SwapFrom { amount: u256, minimum: u256 },
    #[selector = sol("approve(address,uint256)")]
    Approve { spender: Address, amount: u256 } -> bool,
    #[selector = sol("deposit()")]
    Deposit,
    #[selector = sol("withdraw(uint256)")]
    Withdraw { amount: u256 },
    #[selector = sol("getLatestTroveData(uint256)")]
    Trove { id: u256 } -> LatestTroveData,
    #[selector = sol("openTrove(address,uint256,uint256,uint256,uint256,uint256,uint256,uint256,address,address,address)")]
    Open { owner: Address, index: u256, coll: u256, bold: u256, upper: u256, lower: u256, rate: u256, fee: u256, add: Address, remove: Address, receiver: Address } -> u256,
    #[selector = sol("openTroveAndJoinInterestBatchManager((address,uint256,uint256,uint256,uint256,uint256,address,uint256,address,address,address))")]
    OpenBatch { p: (Address, u256, u256, u256, u256, u256, Address, u256, Address, Address, Address) } -> u256,
    #[selector = sol("addColl(uint256,uint256)")]
    Add { id: u256, amount: u256 },
    #[selector = sol("withdrawColl(uint256,uint256)")]
    WithdrawColl { id: u256, amount: u256 },
    #[selector = sol("withdrawBold(uint256,uint256,uint256)")]
    WithdrawBold { id: u256, amount: u256, fee: u256 },
    #[selector = sol("repayBold(uint256,uint256)")]
    Repay { id: u256, amount: u256 },
    #[selector = sol("adjustTrove(uint256,uint256,bool,uint256,bool,uint256)")]
    Adjust { id: u256, coll: u256, coll_increase: bool, debt: u256, debt_increase: bool, fee: u256 },
    #[selector = sol("adjustZombieTrove(uint256,uint256,bool,uint256,bool,uint256,uint256,uint256)")]
    AdjustZombie { id: u256, coll: u256, coll_increase: bool, debt: u256, debt_increase: bool, upper: u256, lower: u256, fee: u256 },
    #[selector = sol("closeTrove(uint256)")]
    Close { id: u256 },
    #[selector = sol("swapToBold(uint256,uint256)")]
    Swap { amount: u256, minimum: u256 } -> u256,
    #[selector = sol("makeFlashLoan(address,uint256,uint8,bytes)")]
    Flash { token: Address, amount: u256, operation: u8, data: Bytes },
}
