use core::num::IntDowncast
use std::abi::{sol, Bytes, Bytes32}
use std::evm::{Address, Ctx, Call, Log, revert_error}
use super::bribe_initiative::GovernanceCalls
use super::curve_gauge_rewards::GaugeCalls
use super::leftovers_sweep::BalanceMsg
use super::revert_texts::require
use super::merkl_errors as error
const CREATOR: Address = Address::new(0x8bb4c975ff3c250e0ceea271728547f3802b36fd)
const SAFE: Address = Address::new(0xf06016d822943c42e3cb7fc3a6a3b1889c1045f8)
pub struct Config { pub governance: Address, pub bold: Address, pub threshold: u256, pub pool: Bytes32, pub fees: u32, pub weight0: u32, pub weight1: u32, pub start: u256, pub duration: u256 }
impl Copy for Config {}
pub msg MerklCalls {
    #[selector = sol("acceptConditions()")]
    Accept,
    #[selector = sol("claimForInitiative(address)")]
    Claim { initiative: Address } -> u256,
    #[selector = sol("createCampaign((bytes32,address,address,uint256,uint32,uint32,uint32,bytes))")]
    Create { params: (Bytes32, Address, Address, u256, u32, u32, u32, Bytes) } -> Bytes32,
}
#[event]
pub struct NewMerklCampaign {
    #[indexed]
    pub claim_epoch: u256,
    pub bold_amount: u256,
    pub campaing_id: Bytes32,
}
pub msg MerklMsg {
    #[selector = sol("LIQUITY_FUNDS_SAFE()")]
    Safe -> Address,
    #[selector = sol("CAMPAIGN_TYPE()")]
    Type -> u32,
    #[selector = sol("governance()")]
    Governance -> Address,
    #[selector = sol("boldToken()")]
    Bold -> Address,
    #[selector = sol("CAMPAIGN_BOLD_AMOUNT_THRESHOLD()")]
    Threshold -> u256,
    #[selector = sol("UNIV4_POOL_ID()")]
    Pool -> Bytes32,
    #[selector = sol("WEIGHT_FEES()")]
    Fees -> u32,
    #[selector = sol("WEIGHT_TOKEN_0()")]
    Weight0 -> u32,
    #[selector = sol("WEIGHT_TOKEN_1()")]
    Weight1 -> u32,
    #[selector = sol("getCampaignData()")]
    Data -> Bytes,
    #[selector = sol("onRegisterInitiative(uint256)")]
    Register { epoch: u256 },
    #[selector = sol("onUnregisterInitiative(uint256)")]
    Unregister { epoch: u256 },
    #[selector = sol("onClaimForInitiative(uint256,uint256)")]
    OnClaim { epoch: u256, amount: u256 },
    #[selector = sol("onAfterAllocateLQTY(uint256,address,(uint256,uint256,uint256,uint256),(uint256,uint256,uint256,uint256,uint256),(uint256,uint256,uint256,uint256,uint256))")]
    Allocate { epoch: u256, user: Address, user_state: (u256, u256, u256, u256), allocation: (u256, u256, u256, u256, u256), initiative: (u256, u256, u256, u256, u256) },
    #[selector = sol("claimForInitiative()")]
    Claim,
}
pub fn campaign_data(_ cfg: Config) -> Bytes {
    let p = core::ptr::alloc_bytes(640)
    let words: [u256; 20] = [416, 0, cfg.fees as u256, cfg.weight0 as u256, cfg.weight1 as u256, 480, 512, 576, 0, 0, 0, 0, 608, 32, cfg.pool.val, 0, 1, SAFE.word(), 0, 0]
    var i: usize = 0
    while i < 20 {
        unsafe { core::abi::store_word(ptr: core::ptr::offset_bytes(p, (i as u256) * 32), value: words[i]) }
        i += 1
    }
    Bytes::from_payload(source: unsafe { core::ptr::MemSpan::from_raw_parts(ptr: p, len: 640) })
}
pub contract UniV4MerklRewards {
    cfg: Config,
    init(governance: Address, bold: Address, threshold: u256, pool: Bytes32, fees: u32, weight0: u32, weight1: u32) uses (mut cfg, ctx: Ctx, call: mut Call) {
        require(fees + weight0 + weight1 == 10000, error::weights())
        let start = governance.static(GovernanceCalls::Start {})
        let duration = governance.static(GovernanceCalls::Duration {})
        cfg = Config { governance, bold, threshold, pool, fees, weight0, weight1, start, duration }
        let ignored = bold.call(GaugeCalls::Approve { spender: CREATOR, amount: ~0 })
        if ctx.extcodesize(CREATOR) == 0 { std::evm::revert(()) }
        CREATOR.call(MerklCalls::Accept {})
    }
    recv MerklMsg {
        Safe -> Address { SAFE }
        Type -> u32 { 13 }
        Governance -> Address uses (cfg) { cfg.governance }
        Bold -> Address uses (cfg) { cfg.bold }
        Threshold -> u256 uses (cfg) { cfg.threshold }
        Pool -> Bytes32 uses (cfg) { cfg.pool }
        Fees -> u32 uses (cfg) { cfg.fees }
        Weight0 -> u32 uses (cfg) { cfg.weight0 }
        Weight1 -> u32 uses (cfg) { cfg.weight1 }
        Data -> Bytes uses (cfg) { campaign_data(cfg) }
        Register { epoch } {}
        Unregister { epoch } {}
        Allocate { epoch, user, user_state, allocation, initiative } {}
        OnClaim { epoch, amount } uses (cfg, ctx: Ctx) { require(ctx.caller() == cfg.governance, error::sender()) }
        Claim uses (cfg, ctx: Ctx, call: mut Call, log: mut Log) {
            let claimable = cfg.governance.call(MerklCalls::Claim { initiative: ctx.address() })
            let amount = cfg.bold.static(BalanceMsg::Balance { account: ctx.address() })
            if amount < claimable { revert_error(std::evm::panic::Panic::from(1)) }
            require(amount > 0, error::funds())
            if amount < cfg.threshold { return }
            let epoch = cfg.governance.static(GovernanceCalls::Epoch {}) - 1
            let end = cfg.start + epoch * cfg.duration
            let id = CREATOR.call(MerklCalls::Create { params: (Bytes32 { val: 0 }, ctx.address(), cfg.bold, amount, 13, end.downcast_truncate(), cfg.duration.downcast_truncate(), campaign_data(cfg)) })
            log.emit(NewMerklCampaign { claim_epoch: epoch, bold_amount: amount, campaing_id: id })
        }
    }
}
