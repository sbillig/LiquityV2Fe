pub fn cdata_1(_ content: DynString) -> DynString { cat((cat((text(fragment("<![CDATA["))).as_bytes(), (content).as_bytes())).as_bytes(), (text(fragment("]]>"))).as_bytes()) }
#[inline(never)]
pub fn gradientStop_3(_ offset: u256, _ color: DynString, _ props: DynString) -> DynString { el_3(text(fragment("stop")), cat((cat((cat((cat((prop_2(text(fragment("stop-color")), color)).as_bytes(), (text(fragment(" "))).as_bytes())).as_bytes(), (prop_2(text(fragment("offset")), cat((decimal(offset)).as_bytes(), (text(fragment("%"))).as_bytes()))).as_bytes())).as_bytes(), (text(fragment(" "))).as_bytes())).as_bytes(), (props).as_bytes()), DynString::empty()) }
