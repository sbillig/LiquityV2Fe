#[inline(never)]
pub fn circle_3(_ cx: DynString, _ cy: DynString, _ r: DynString) -> DynString { el_2(text(fragment("circle")), cat((cat((prop_2(text(fragment("cx")), cx)).as_bytes(), (prop_2(text(fragment("cy")), cy)).as_bytes())).as_bytes(), (prop_3(text(fragment("r")), r, true)).as_bytes())) }
#[inline(never)]
pub fn circle_4(_ cx: DynString, _ cy: DynString, _ r: DynString, _ children: DynString) -> DynString { el_3(text(fragment("circle")), cat((cat((prop_2(text(fragment("cx")), cx)).as_bytes(), (prop_2(text(fragment("cy")), cy)).as_bytes())).as_bytes(), (prop_3(text(fragment("r")), r, true)).as_bytes()), children) }
#[inline(never)]
pub fn circle_5(_ cx: DynString, _ cy: DynString, _ r: DynString, _ props: DynString, _ children: DynString) -> DynString { el_3(text(fragment("circle")), cat((cat((cat((prop_2(text(fragment("cx")), cx)).as_bytes(), (prop_2(text(fragment("cy")), cy)).as_bytes())).as_bytes(), (prop_3(text(fragment("r")), r, false)).as_bytes())).as_bytes(), (props).as_bytes()), children) }
