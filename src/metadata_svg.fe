use std::abi::DynString
use super::metadata_string::{cat, fragment, text, decimal}
#[inline(never)]
pub fn el_2(_ tag: DynString, _ props: DynString) -> DynString { cat((cat((cat((cat((text(fragment("<"))).as_bytes(), (tag).as_bytes())).as_bytes(), (text(fragment(" "))).as_bytes())).as_bytes(), (props).as_bytes())).as_bytes(), (text(fragment("/>"))).as_bytes()) }
#[inline(never)]
pub fn el_3(_ tag: DynString, _ props: DynString, _ children: DynString) -> DynString { cat((cat((cat((cat((cat((cat((cat((cat((text(fragment("<"))).as_bytes(), (tag).as_bytes())).as_bytes(), (text(fragment(" "))).as_bytes())).as_bytes(), (props).as_bytes())).as_bytes(), (text(fragment(">"))).as_bytes())).as_bytes(), (children).as_bytes())).as_bytes(), (text(fragment("</"))).as_bytes())).as_bytes(), (tag).as_bytes())).as_bytes(), (text(fragment(">"))).as_bytes()) }
#[inline(never)]
pub fn prop_3(_ key: DynString, _ value: DynString, _ last: bool) -> DynString { cat((cat((cat((key).as_bytes(), (text(fragment("=\""))).as_bytes())).as_bytes(), (value).as_bytes())).as_bytes(), (if last { text(fragment("\"")) } else { text(fragment("\" ")) }).as_bytes()) }
#[inline(never)]
pub fn prop_2(_ key: DynString, _ value: DynString) -> DynString { prop_3(key, value, false) }
#[inline(never)]
pub fn g_2(_ props: DynString, _ children: DynString) -> DynString { el_3(text(fragment("g")), props, children) }
