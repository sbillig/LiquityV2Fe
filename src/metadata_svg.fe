pub fn svg_2(_ props: DynString, _ children: DynString) -> DynString { el_3(text(fragment("svg")), cat((cat((text(fragment("xmlns=\"http://www.w3.org/2000/s"))).as_bytes(), (text(fragment("vg\" "))).as_bytes())).as_bytes(), (props).as_bytes()), children) }
#[inline(never)]
pub fn style_2(_ title: DynString, _ props: DynString) -> DynString { el_2(text(fragment("style")), cat((cat((cat((text(fragment("."))).as_bytes(), (title).as_bytes())).as_bytes(), (text(fragment(" "))).as_bytes())).as_bytes(), (props).as_bytes())) }
#[inline(never)]
pub fn path_1(_ d: DynString) -> DynString { el_2(text(fragment("path")), prop_3(text(fragment("d")), d, true)) }
#[inline(never)]
