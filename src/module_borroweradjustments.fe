use std::abi::sol
use std::evm::{Address, Ctx, Call, Log, RawStorage, revert_error}
use super::borrower_open as opening
use super::borrower_open::Config
use super::borrower_data as data
use super::borrower_checks as checks
use super::borrower_errors::*
use super::borrower_adjust as adjust
use super::borrower_lifecycle as life
use super::borrower_batch as batch
use super::add_remove_managers as managers
use super::trove_nft::TroveNFTMsg
use super::trove_manager::TroveManagerMsg
use super::trove_redemption::require_code
use super::coll_surplus_pool::CollSurplusPoolMsg
use super::gas_pool::TokenApprovalMsg
use super::liquity_base as base
use super::types::TroveChange
use super::addresses_registry::*
pub msg BorrowerAdjustmentsMsg {
    #[selector = sol("addColl(uint256,uint256)")]
    addColl { id: u256, amount: u256 },
    #[selector = sol("withdrawColl(uint256,uint256)")]
    withdrawColl { id: u256, amount: u256 },
    #[selector = sol("withdrawBold(uint256,uint256,uint256)")]
    withdrawBold { id: u256, amount: u256, max_fee: u256 },
    #[selector = sol("repayBold(uint256,uint256)")]
    repayBold { id: u256, amount: u256 },
    #[selector = sol("adjustTrove(uint256,uint256,bool,uint256,bool,uint256)")]
    adjustTrove { id: u256, coll: u256, coll_inc: bool, debt: u256, debt_inc: bool, max_fee: u256 },
    #[selector = sol("adjustZombieTrove(uint256,uint256,bool,uint256,bool,uint256,uint256,uint256)")]
    adjustZombieTrove { id: u256, coll: u256, coll_inc: bool, debt: u256, debt_inc: bool, upper: u256, lower: u256, max_fee: u256 },
    #[selector = sol("adjustTroveInterestRate(uint256,uint256,uint256,uint256,uint256)")]
    AdjustRate { id: u256, rate: u256, upper: u256, lower: u256, max_fee: u256 },
}
pub contract BorrowerAdjustments {
    cfg: Config,
    init(registry: Address) uses (mut cfg, call: mut Call) {
        let nft = registry.static(RegistryMsg::GettroveNFT {})
        let coll = registry.static(RegistryMsg::GetcollToken {})
        let weth = registry.call(RegistryMsg::GetWETH {})
        let ccr = registry.static(RegistryMsg::GetCCR {})
        let scr = registry.static(RegistryMsg::GetSCR {})
        let mcr = registry.static(RegistryMsg::GetMCR {})
        let bcr = registry.static(RegistryMsg::GetBCR {})
        cfg = Config { nft, coll, weth, ccr, scr, mcr, bcr }
    }
    recv BorrowerAdjustmentsMsg {
        addColl { id, amount } uses (cfg, ctx: Ctx, call: mut Call, storage: mut RawStorage, log: mut Log) {
            let manager = data::address_at(5)
            checks::active(manager, id)
            var change = TroveChange::zero()
            change.coll_increase = amount
            adjust::adjust(cfg, manager, id, change, 0)
        }
        withdrawColl { id, amount } uses (cfg, ctx: Ctx, call: mut Call, storage: mut RawStorage, log: mut Log) {
            let manager = data::address_at(5)
            checks::active(manager, id)
            var change = TroveChange::zero()
            change.coll_decrease = amount
            adjust::adjust(cfg, manager, id, change, 0)
        }
        withdrawBold { id, amount, max_fee } uses (cfg, ctx: Ctx, call: mut Call, storage: mut RawStorage, log: mut Log) {
            let manager = data::address_at(5)
            checks::active(manager, id)
            var change = TroveChange::zero()
            change.debt_increase = amount
            adjust::adjust(cfg, manager, id, change, max_fee)
        }
        repayBold { id, amount } uses (cfg, ctx: Ctx, call: mut Call, storage: mut RawStorage, log: mut Log) {
            let manager = data::address_at(5)
            checks::active(manager, id)
            var change = TroveChange::zero()
            change.debt_decrease = amount
            adjust::adjust(cfg, manager, id, change, 0)
        }
        adjustTrove { id, coll, coll_inc, debt, debt_inc, max_fee } uses (cfg, ctx: Ctx, call: mut Call, storage: mut RawStorage, log: mut Log) {
            let manager = data::address_at(5)
            checks::active(manager, id)
            var change = TroveChange::zero()
            if coll_inc { change.coll_increase = coll } else { change.coll_decrease = coll }
            if debt_inc { change.debt_increase = debt } else { change.debt_decrease = debt }
            adjust::adjust(cfg, manager, id, change, max_fee)
        }
        adjustZombieTrove { id, coll, coll_inc, debt, debt_inc, upper, lower, max_fee } uses (cfg, ctx: Ctx, call: mut Call, storage: mut RawStorage, log: mut Log) {
            let manager = data::address_at(5)
            checks::zombie(manager, id)
            var change = TroveChange::zero()
            if coll_inc { change.coll_increase = coll } else { change.coll_decrease = coll }
            if debt_inc { change.debt_increase = debt } else { change.debt_decrease = debt }
            adjust::adjust(cfg, manager, id, change, max_fee)
            require_code(manager)
            manager.call(TroveManagerMsg::HookSetTroveStatusToActive { id })
            let batch = data::batch_of(id)
            var batch_rate = 0
            if batch != Address::zero() { batch_rate = manager.static(TroveManagerMsg::LatestBatch { manager: batch }).annual_interest_rate }
            let rate = manager.static(TroveManagerMsg::AnnualRate { id })
            life::insert(id, rate, upper, lower, batch, batch_rate)
        }
        AdjustRate { id, rate, upper, lower, max_fee } uses (cfg, ctx: Ctx, call: mut Call, storage: mut RawStorage, log: mut Log) {
            adjust::interest_rate(cfg, id, rate, upper, lower, max_fee)
        }
    }
}
