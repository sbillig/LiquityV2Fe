use std::abi::DynString
use std::evm::RawMem
pub fn not_receiver() -> DynString uses (mem: mut RawMem) {
    let p = core::ptr::alloc_bytes(64)
    mem.mstore(addr: core::ptr::offset_bytes(p, 0), value: 0x425a3a205a6170706572206973206e6f7420726563656976657220666f722074)
    mem.mstore(addr: core::ptr::offset_bytes(p, 32), value: 0x6869732074726f76650000000000000000000000000000000000000000000000)
    DynString::from_payload(source: core::ptr::MemSpan::from_raw_parts(ptr: p, len: 41))
}
