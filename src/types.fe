use core::abi::{AbiSize, AbiSpan, AbiDecoder, ByteInput, Decode, Encode}
use std::abi::Sol
pub struct LatestBatchData {
    pub total_debt_shares: u256,
    pub entire_debt_without_redistribution: u256,
    pub entire_coll_without_redistribution: u256,
    pub accrued_interest: u256,
    pub recorded_debt: u256,
    pub annual_interest_rate: u256,
    pub weighted_recorded_debt: u256,
    pub annual_management_fee: u256,
    pub accrued_management_fee: u256,
    pub weighted_recorded_batch_management_fee: u256,
    pub last_debt_update_time: u256,
    pub last_interest_rate_adj_time: u256,
}

pub struct LatestTroveData {
    pub entire_debt: u256,
    pub entire_coll: u256,
    pub redist_bold_debt_gain: u256,
    pub redist_coll_gain: u256,
    pub accrued_interest: u256,
    pub recorded_debt: u256,
    pub annual_interest_rate: u256,
    pub weighted_recorded_debt: u256,
    pub accrued_batch_management_fee: u256,
    pub last_interest_rate_adj_time: u256,
}

pub struct TroveChange {
    pub applied_redist_bold_debt_gain: u256,
    pub applied_redist_coll_gain: u256,
    pub coll_increase: u256,
    pub coll_decrease: u256,
    pub debt_increase: u256,
    pub debt_decrease: u256,
    pub new_weighted_recorded_debt: u256,
    pub old_weighted_recorded_debt: u256,
    pub upfront_fee: u256,
    pub batch_accrued_management_fee: u256,
    pub new_weighted_recorded_batch_management_fee: u256,
    pub old_weighted_recorded_batch_management_fee: u256,
}

impl AbiSize for TroveChange {
    const HEAD_SIZE: u256 = 384
    const IS_DYNAMIC: bool = false
}
impl AbiSpan<Sol> for TroveChange {
    fn payload_end<I: ByteInput>(_: I, base: u256, pos: u256) -> u256 { pos + 384 }
}
impl Decode<Sol> for TroveChange {
    fn decode_payload<D: AbiDecoder<Sol>, I: core::abi::ByteInput>(_ d: mut D, _ input: I) -> Self {
        let applied_redist_bold_debt_gain = d.read_word(input)
        let applied_redist_coll_gain = d.read_word(input)
        let coll_increase = d.read_word(input)
        let coll_decrease = d.read_word(input)
        let debt_increase = d.read_word(input)
        let debt_decrease = d.read_word(input)
        let new_weighted_recorded_debt = d.read_word(input)
        let old_weighted_recorded_debt = d.read_word(input)
        let upfront_fee = d.read_word(input)
        let batch_accrued_management_fee = d.read_word(input)
        let new_weighted_recorded_batch_management_fee = d.read_word(input)
        let old_weighted_recorded_batch_management_fee = d.read_word(input)
        Self { applied_redist_bold_debt_gain, applied_redist_coll_gain, coll_increase, coll_decrease, debt_increase, debt_decrease, new_weighted_recorded_debt, old_weighted_recorded_debt, upfront_fee, batch_accrued_management_fee, new_weighted_recorded_batch_management_fee, old_weighted_recorded_batch_management_fee }
    }
}
impl Encode<Sol> for TroveChange {
    fn encode(own self, _ out: core::abi::AbiFrame) {
        <u256 as Encode<Sol>>::encode(self.applied_redist_bold_debt_gain, out.slice(offset: 0, len: <u256 as core::abi::AbiSize>::HEAD_SIZE))
        <u256 as Encode<Sol>>::encode(self.applied_redist_coll_gain, out.slice(offset: 32, len: <u256 as core::abi::AbiSize>::HEAD_SIZE))
        <u256 as Encode<Sol>>::encode(self.coll_increase, out.slice(offset: 64, len: <u256 as core::abi::AbiSize>::HEAD_SIZE))
        <u256 as Encode<Sol>>::encode(self.coll_decrease, out.slice(offset: 96, len: <u256 as core::abi::AbiSize>::HEAD_SIZE))
        <u256 as Encode<Sol>>::encode(self.debt_increase, out.slice(offset: 128, len: <u256 as core::abi::AbiSize>::HEAD_SIZE))
        <u256 as Encode<Sol>>::encode(self.debt_decrease, out.slice(offset: 160, len: <u256 as core::abi::AbiSize>::HEAD_SIZE))
        <u256 as Encode<Sol>>::encode(self.new_weighted_recorded_debt, out.slice(offset: 192, len: <u256 as core::abi::AbiSize>::HEAD_SIZE))
        <u256 as Encode<Sol>>::encode(self.old_weighted_recorded_debt, out.slice(offset: 224, len: <u256 as core::abi::AbiSize>::HEAD_SIZE))
        <u256 as Encode<Sol>>::encode(self.upfront_fee, out.slice(offset: 256, len: <u256 as core::abi::AbiSize>::HEAD_SIZE))
        <u256 as Encode<Sol>>::encode(self.batch_accrued_management_fee, out.slice(offset: 288, len: <u256 as core::abi::AbiSize>::HEAD_SIZE))
        <u256 as Encode<Sol>>::encode(self.new_weighted_recorded_batch_management_fee, out.slice(offset: 320, len: <u256 as core::abi::AbiSize>::HEAD_SIZE))
        <u256 as Encode<Sol>>::encode(self.old_weighted_recorded_batch_management_fee, out.slice(offset: 352, len: <u256 as core::abi::AbiSize>::HEAD_SIZE))
    }
}

impl Copy for TroveChange {}
impl Copy for LatestBatchData {}
impl Copy for LatestTroveData {}

impl AbiSize for LatestTroveData {
    const HEAD_SIZE: u256 = 320
    const IS_DYNAMIC: bool = false
}
impl AbiSpan<Sol> for LatestTroveData {
    fn payload_end<I: ByteInput>(_: I, base: u256, pos: u256) -> u256 { pos + 320 }
}
impl Decode<Sol> for LatestTroveData {
    fn decode_payload<D: AbiDecoder<Sol>, I: core::abi::ByteInput>(_ d: mut D, _ input: I) -> Self {
        let entire_debt = d.read_word(input)
        let entire_coll = d.read_word(input)
        let redist_bold_debt_gain = d.read_word(input)
        let redist_coll_gain = d.read_word(input)
        let accrued_interest = d.read_word(input)
        let recorded_debt = d.read_word(input)
        let annual_interest_rate = d.read_word(input)
        let weighted_recorded_debt = d.read_word(input)
        let accrued_batch_management_fee = d.read_word(input)
        let last_interest_rate_adj_time = d.read_word(input)
        Self { entire_debt, entire_coll, redist_bold_debt_gain, redist_coll_gain, accrued_interest, recorded_debt, annual_interest_rate, weighted_recorded_debt, accrued_batch_management_fee, last_interest_rate_adj_time }
    }
}
impl Encode<Sol> for LatestTroveData {
    fn encode(own self, _ out: core::abi::AbiFrame) {
        <u256 as Encode<Sol>>::encode(self.entire_debt, out.slice(offset: 0, len: <u256 as core::abi::AbiSize>::HEAD_SIZE))
        <u256 as Encode<Sol>>::encode(self.entire_coll, out.slice(offset: 32, len: <u256 as core::abi::AbiSize>::HEAD_SIZE))
        <u256 as Encode<Sol>>::encode(self.redist_bold_debt_gain, out.slice(offset: 64, len: <u256 as core::abi::AbiSize>::HEAD_SIZE))
        <u256 as Encode<Sol>>::encode(self.redist_coll_gain, out.slice(offset: 96, len: <u256 as core::abi::AbiSize>::HEAD_SIZE))
        <u256 as Encode<Sol>>::encode(self.accrued_interest, out.slice(offset: 128, len: <u256 as core::abi::AbiSize>::HEAD_SIZE))
        <u256 as Encode<Sol>>::encode(self.recorded_debt, out.slice(offset: 160, len: <u256 as core::abi::AbiSize>::HEAD_SIZE))
        <u256 as Encode<Sol>>::encode(self.annual_interest_rate, out.slice(offset: 192, len: <u256 as core::abi::AbiSize>::HEAD_SIZE))
        <u256 as Encode<Sol>>::encode(self.weighted_recorded_debt, out.slice(offset: 224, len: <u256 as core::abi::AbiSize>::HEAD_SIZE))
        <u256 as Encode<Sol>>::encode(self.accrued_batch_management_fee, out.slice(offset: 256, len: <u256 as core::abi::AbiSize>::HEAD_SIZE))
        <u256 as Encode<Sol>>::encode(self.last_interest_rate_adj_time, out.slice(offset: 288, len: <u256 as core::abi::AbiSize>::HEAD_SIZE))
    }
}

