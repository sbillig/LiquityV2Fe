use core::abi::{AbiSize, AbiSpan, ByteInput, AbiDecoder, Decode, store_word}
use std::abi::{sol, Sol, DynArray, DynArrayAccess, DynString}
use std::evm::{Address, Call, Ctx, RawOps, RawStorage, SolArray, encode_abi_payload, revert_error}
use std::evm::packed::keccak_packed
use std::evm::panic::Panic
use super::types::LatestTroveData
use super::bytes_builder::BytesBuilder
use super::trove_memory_array::TroveMemoryArray
use super::token_calls::{TokenMsg, safe_transfer}
use super::revert_texts::{Error, require}
// Match Solidity's eager memory-array allocation and address validation.
pub struct AddressMemoryArray { pub values: DynArray<Address> }
impl AbiSize for AddressMemoryArray {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = true
}
impl AbiSpan<Sol> for AddressMemoryArray {
    fn payload_end<I: ByteInput>(_ input: I, base: u256, pos: u256) -> u256 {
        <TroveMemoryArray as AbiSpan<Sol>>::payload_end(input, base: base, pos: pos)
    }
}
impl Decode<Sol> for AddressMemoryArray {
    fn decode_payload<D: AbiDecoder<Sol>, I: core::abi::ByteInput>(_ d: mut D, _ input: I) -> Self {
        let pos = d.pos()
        let end = <TroveMemoryArray as AbiSpan<Sol>>::payload_end(input, base: 0, pos: pos)
        let values = <DynArray<Address> as Decode<Sol>>::decode_from(input, pos)
        Self { values }
    }
}
pub msg RedemptionHelperCalls {
    #[selector = sol("totalCollaterals()")]
    Count -> u256,
    #[selector = sol("boldToken()")]
    Bold -> Address,
    #[selector = sol("getTroveManager(uint256)")]
    ManagerAt { index: u256 } -> Address,
    #[selector = sol("getToken(uint256)")]
    TokenAt { index: u256 } -> Address,
    #[selector = sol("troveManager()")]
    Manager -> Address,
    #[selector = sol("sortedTroves()")]
    Sorted -> Address,
    #[selector = sol("priceFeed()")]
    Feed -> Address,
    #[selector = sol("getUnbackedPortionPriceAndRedeemability()")]
    Unbacked -> (u256, u256, bool),
    #[selector = sol("getEntireBranchDebt()")]
    Debt -> u256,
    #[selector = sol("lastZombieTroveId()")]
    Zombie -> u256,
    #[selector = sol("getLast()")]
    Last -> u256,
    #[selector = sol("getPrev(uint256)")]
    Prev { id: u256 } -> u256,
    #[selector = sol("getLatestTroveData(uint256)")]
    Trove { id: u256 } -> LatestTroveData,
    #[selector = sol("getRedemptionRateForRedeemedAmount(uint256)")]
    Fee { amount: u256 } -> u256,
    #[selector = sol("fetchRedemptionPrice()")]
    Price -> (u256, bool),
    #[selector = sol("redeemCollateral(uint256,uint256,uint256)")]
    Redeem { amount: u256, iterations: u256, fee: u256 },
    #[selector = sol("balanceOf(address)")]
    Balance { account: Address } -> u256,
}
pub struct SimulationContext {
    pub trove_manager: Address, pub sorted_troves: Address, pub redeemable: bool,
    pub price: u256, pub proportion: u256, pub attempted_bold: u256,
    pub redeemed_bold: u256, pub iterations: u256,
}
pub struct Redeemed { pub bold: u256, pub coll: u256 }
impl AbiSize for SimulationContext { const HEAD_SIZE: u256 = 256
    const IS_DYNAMIC: bool = false }
impl AbiSpan<Sol> for SimulationContext {
    fn payload_end<I: ByteInput>(_: I, base: u256, pos: u256) -> u256 { pos + 256 }
}
impl AbiSize for Redeemed { const HEAD_SIZE: u256 = 64
    const IS_DYNAMIC: bool = false }
impl AbiSpan<Sol> for Redeemed {
    fn payload_end<I: ByteInput>(_: I, base: u256, pos: u256) -> u256 { pos + 64 }
}
fn array(_ n: u256, _ stride: u256) -> BytesBuilder {
    if n > 0xffffffffffffffff { revert_error(Panic { code: 0x41 }) }
    BytesBuilder::zeroed(n * stride)
}
fn branch_address(_ index: u256) -> Address uses (branch_list: SolArray<Address>) {
    branch_list[index]
}
fn simulate(_ count: u256, _ amount: u256, _ limit: u256) -> (BytesBuilder, u256)
uses (branch_list: SolArray<Address>, call: mut Call) {
    var p = array(count, 256)
    var total = 0
    var i = 0
    while i < count {
        let base = 256 * i
        let registry = branch_address(i)
        let manager = registry.static(RedemptionHelperCalls::Manager {})
        let sorted = registry.static(RedemptionHelperCalls::Sorted {})
        p.write_word(at: base, value: manager.inner)
        p.write_word(at: base + 32, value: sorted.inner)
        let (proportion, price, active) = manager.call(RedemptionHelperCalls::Unbacked {})
        p.write_word(at: base + 64, value: if active { 1 } else { 0 })
        p.write_word(at: base + 96, value: price)
        p.write_word(at: base + 128, value: proportion)
        if active { total += proportion }
        i += 1
    }
    let bold = if total > 0 && total < amount { total } else { amount }
    if total == 0 {
        i = 0
        while i < count {
            let base = 256 * i
            let manager = Address { inner: p.read_word(at: base) }
            let debt = manager.static(RedemptionHelperCalls::Debt {})
            p.write_word(at: base + 128, value: debt)
            if p.read_word(at: base + 64) != 0 { total += debt }
            i += 1
        }
    }
    if total == 0 { return (p, total) }
    i = 0
    while i < count {
        let base = 256 * i
        i += 1
        if p.read_word(at: base + 64) == 0 { continue }
        let attempted = bold * p.read_word(at: base + 128) / total
        p.write_word(at: base + 160, value: attempted)
        if attempted == 0 { continue }
        let manager = Address { inner: p.read_word(at: base) }
        let sorted = Address { inner: p.read_word(at: base + 32) }
        let zombie = manager.static(RedemptionHelperCalls::Zombie {})
        let last = sorted.static(RedemptionHelperCalls::Last {})
        var current = if zombie != 0 { zombie } else { last }
        var next = if zombie != 0 { last } else { sorted.static(RedemptionHelperCalls::Prev { id: last }) }
        var iterations = 0
        var redeemed = 0
        while iterations < limit || limit == 0 {
            if redeemed == attempted || current == 0 { break }
            let trove = manager.static(RedemptionHelperCalls::Trove { id: current })
            if trove.entire_coll * p.read_word(at: base + 96) / trove.entire_debt >= 1000000000000000000 {
                let remaining = attempted - redeemed
                redeemed += if remaining < trove.entire_debt { remaining } else { trove.entire_debt }
            }
            current = next
            next = sorted.static(RedemptionHelperCalls::Prev { id: next })
            iterations += 1
        }
        p.write_word(at: base + 192, value: redeemed)
        p.write_word(at: base + 224, value: iterations)
    }
    (p, total)
}
pub msg RedemptionHelperMsg {
    #[selector = sol("numBranches()")]
    Count -> u256,
    #[selector = sol("collateralRegistry()")]
    Registry -> Address,
    #[selector = sol("boldToken()")]
    Bold -> Address,
    #[selector = sol("addresses(uint256)")]
    Branch { index: u256 } -> Address,
    #[selector = sol("simulateRedemption(uint256,uint256)")]
    Simulate { amount: u256, iterations: u256 } -> (DynArray<SimulationContext>, u256),
    #[selector = sol("truncateRedemption(uint256,uint256)")]
    Truncate { amount: u256, iterations: u256 } -> (u256, u256, DynArray<Redeemed>),
    // Numeric selector preserves the custom Solidity memory-array decoder.
    #[selector = 0xc8c52fb7]
    Redeem { amount: u256, iterations: u256, fee: u256, minimum: TroveMemoryArray },
}
pub contract RedemptionHelper {
    count: u256,
    registry: Address,
    bold: Address,
    mut branch_list: SolArray<Address>,
    init(collateral_registry: Address, branches: AddressMemoryArray)
    uses (mut count, mut registry, mut bold, mut branch_list, call: mut Call) {
        var i = 0
        while i < branches.values.len() { let validated = branches.values.get(i)
            i += 1 }
        require(branches.values.len() == collateral_registry.static(RedemptionHelperCalls::Count {}), error_count())
        count = branches.values.len()
        registry = collateral_registry
        bold = collateral_registry.static(RedemptionHelperCalls::Bold {})
        i = 0
        while i < branches.values.len() {
            let branch = branches.values.get(i)
            require(collateral_registry.static(RedemptionHelperCalls::ManagerAt { index: i }) == branch.static(RedemptionHelperCalls::Manager {}), error_manager())
            branch_list.push(branch)
            i += 1
        }
    }
    recv RedemptionHelperMsg {
        Count -> u256 uses (count) { count }
        Registry -> Address uses (registry) { registry }
        Bold -> Address uses (bold) { bold }
        Branch { index } -> Address uses (branch_list, ops: mut RawOps) {
            if index >= branch_list.len() { ops.revert(data: core::ptr::MemSpan::empty()) }
            branch_address(index)
        }
        Simulate { amount, iterations } -> (DynArray<SimulationContext>, u256)
        uses (count, branch_list, call: mut Call, ops: mut RawOps) {
            let (p, total) = simulate(count, amount, iterations)
            let values: DynArray<SimulationContext> = p.into_dyn_array(count)
            let output = encode_abi_payload((values, total))
            ops.return_data(data: output.span())
        }
        Truncate { amount, iterations } -> (u256, u256, DynArray<Redeemed>)
        uses (count, registry, branch_list, call: mut Call, ops: mut RawOps) {
            let (p, total) = simulate(count, amount, iterations)
            if total == 0 {
                let values: DynArray<Redeemed> = array(0, 64).into_dyn_array(0)
                let output = encode_abi_payload((0 as u256, 0 as u256, values))
                ops.return_data(data: output.span())
            }
            var truncated = amount
            var i = 0
            while i < count {
                let base = 256 * i
                if p.read_word(at: base + 64) != 0 && p.read_word(at: base + 128) > 0 {
                    let extrapolated = p.read_word(at: base + 192) * total / p.read_word(at: base + 128)
                    if extrapolated < truncated { truncated = extrapolated }
                }
                i += 1
            }
            let fee = registry.static(RedemptionHelperCalls::Fee { amount: truncated })
            var result = array(count, 64)
            i = 0
            while i < count {
                let base = 256 * i
                if p.read_word(at: base + 64) != 0 && p.read_word(at: base + 128) > 0 {
                    let feed = branch_address(i).static(RedemptionHelperCalls::Feed {})
                    let (price, _) = feed.call(RedemptionHelperCalls::Price {})
                    let debt = truncated * p.read_word(at: base + 128) / total
                    result.write_word(at: 64 * i, value: debt)
                    result.write_word(at: 64 * i + 32, value: debt * (1000000000000000000 - fee) / price)
                }
                i += 1
            }
            let values: DynArray<Redeemed> = result.into_dyn_array(count)
            let output = encode_abi_payload((truncated, fee, values))
            ops.return_data(data: output.span())
        }
        Redeem { amount, iterations, fee, minimum }
        uses (count, registry, bold, ctx: Ctx, call: mut Call) {
            require(amount > 0, error_zero())
            require(minimum.values.len() == count, error_minimum())
            var p = array(count, 64)
            var i = 0
            while i < count {
                let token = registry.static(RedemptionHelperCalls::TokenAt { index: i })
                p.write_word(at: 64 * i, value: token.inner)
                p.write_word(at: 64 * i + 32, value: token.static(RedemptionHelperCalls::Balance { account: ctx.address() }))
                i += 1
            }
            let before = bold.static(RedemptionHelperCalls::Balance { account: ctx.address() })
            let ignored = bold.call(TokenMsg::TransferFrom { owner: ctx.caller(), receiver: ctx.address(), amount })
            registry.call(RedemptionHelperCalls::Redeem { amount, iterations, fee })
            i = 0
            while i < count {
                let token = Address { inner: p.read_word(at: 64 * i) }
                let received = token.static(RedemptionHelperCalls::Balance { account: ctx.address() }) - p.read_word(at: 64 * i + 32)
                require(received >= minimum.values.get(i), error_slippage())
                if received > 0 { safe_transfer(token, ctx.caller(), received) }
                i += 1
            }
            let remaining = bold.static(RedemptionHelperCalls::Balance { account: ctx.address() }) - before
            if remaining > 0 { let ignored = bold.call(TokenMsg::Transfer { receiver: ctx.caller(), amount: remaining }) }
        }
    }
}

fn error_count() -> DynString { "Wrong number of registries" }

fn error_manager() -> DynString { "TroveManager mismatch" }

fn error_zero() -> DynString { "Redeemed amount must be non-zero" }

fn error_minimum() -> DynString { "Wrong _minCollRedeemed length" }

fn error_slippage() -> DynString { "Insufficient collateral redeemed" }
