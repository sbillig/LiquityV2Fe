// SPDX-License-Identifier: BUSL-1.1
// Full TroveManager public interface and registry configuration.
use std::abi::{sol, DynArray}
use std::evm::{Address, Ctx, Call, Log, RawMem, RawStorage, RawOps}
use super::trove_memory_array::TroveMemoryArray
use super::trove_hooks as hooks
use super::types::{TroveChange, LatestTroveData, LatestBatchData}
use super::trove_data as data
use super::trove_state as state
use super::addresses_registry::*
use super::liquity_base as base
use super::liquity_math as math
use super::active_pool::ActivePoolMsg
use super::stability_pool::StabilityPoolMsg
use super::trove_redemption::{PriceMsg, require_code}
// Modules are fixed at construction: no upgrade or arbitrary delegate target.
#[inline(never)]
fn forward(_ target: Address) -> ! uses (ctx: Ctx, ops: mut RawOps, call: mut Call) {
    let len = ops.calldatasize()
    let mut args = core::ptr::MemBuffer::with_capacity(len)
    ops.calldatacopy(dest: mut args, dest_offset: 0, src_offset: 0, len: len)
    args.set_len(len)
    let mut output = core::ptr::MemBuffer::empty()
    let result = call.raw_delegatecall(addr: target, gas: ctx.gas(), args: args.span(), ret: mut output)
    let size = result.returndata_len()
    let mut returned = core::ptr::MemBuffer::with_capacity(size)
    ops.returndatacopy(dest: mut returned, dest_offset: 0, src_offset: 0, len: size)
    returned.set_len(size)
    if result.success() { ops.return_data(data: returned.span()) }
    else { ops.revert(data: returned.span()) }
}
pub msg TroveManagerMsg {
    #[selector = sol("activePool()")]
    GetactivePool -> Address,
    #[selector = sol("troveNFT()")]
    GettroveNFT -> Address,
    #[selector = sol("borrowerOperations()")]
    GetborrowerOperations -> Address,
    #[selector = sol("stabilityPool()")]
    GetstabilityPool -> Address,
    #[selector = sol("sortedTroves()")]
    GetsortedTroves -> Address,
    #[selector = sol("shutdownTime()")]
    GetshutdownTime -> u256,
    #[selector = sol("lastZombieTroveId()")]
    GetlastZombieTroveId -> u256,
    #[selector = sol("getTroveIdsCount()")]
    GetgetTroveIdsCount -> u256,
    #[selector = sol("CCR()")]
    CCR -> u256,
    #[selector = sol("batchIds(uint256)")]
    BatchIds { index: u256 } -> Address,
    #[selector = sol("getTroveFromTroveIdsArray(uint256)")]
    TroveIds { index: u256 } -> u256,
    #[selector = sol("getEntireBranchColl()")]
    GetgetEntireBranchColl -> u256,
    #[selector = sol("getEntireBranchDebt()")]
    GetgetEntireBranchDebt -> u256,
    #[selector = sol("getLatestTroveData(uint256)")]
    LatestTrove { id: u256 } -> LatestTroveData,
    #[selector = sol("getLatestBatchData(address)")]
    LatestBatch { manager: Address } -> LatestBatchData,
    #[selector = sol("getTroveAnnualInterestRate(uint256)")]
    AnnualRate { id: u256 } -> u256,
    #[selector = sol("getCurrentICR(uint256,uint256)")]
    CurrentICR { id: u256, price: u256 } -> u256,
    #[selector = sol("getTroveStatus(uint256)")]
    Status { id: u256 } -> u8,
    #[selector = sol("Troves(uint256)")]
    Troves { id: u256 } -> (u256, u256, u256, u8, u64, u64, u64, u256, Address, u256),
    #[selector = sol("rewardSnapshots(uint256)")]
    RewardSnapshots { id: u256 } -> (u256, u256),

    #[selector = sol("shutdown()")]
    Shutdown,
    #[selector = sol("getUnbackedPortionPriceAndRedeemability()")]
    Unbacked -> (u256, u256, bool),
    // batchLiquidateTroves(uint256[]): custom memory-array decoder retains the wire shape.
    #[selector = 0xef49a6b4]
    batchLiquidateTroves { ids: TroveMemoryArray },
    #[selector = sol("redeemCollateral(address,uint256,uint256,uint256,uint256)")]
    Redeem { user: Address, amount: u256, price: u256, rate: u256, iterations: u256 } -> u256,
    #[selector = sol("urgentRedemption(uint256,uint256[],uint256)")]
    Urgent { amount: u256, ids: DynArray<u256>, min_coll: u256 },
    #[selector = sol("onSetInterestBatchManager((uint256,uint256,uint256,(uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256),address,uint256,uint256))")]
    SetBatch { params: (u256, u256, u256, TroveChange, Address, u256, u256) },
    #[selector = sol("onOpenTrove(address,uint256,(uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256),uint256)")]
    HookOnOpenTrove { owner: Address, id: u256, change: TroveChange, rate: u256 },
    #[selector = sol("onOpenTroveAndJoinBatch(address,uint256,(uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256),address,uint256,uint256)")]
    HookOnOpenTroveAndJoinBatch { owner: Address, id: u256, change: TroveChange, manager: Address, batch_coll: u256, batch_debt: u256 },
    #[selector = sol("setTroveStatusToActive(uint256)")]
    HookSetTroveStatusToActive { id: u256 },
    #[selector = sol("onAdjustTroveInterestRate(uint256,uint256,uint256,uint256,(uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256))")]
    HookOnAdjustTroveInterestRate { id: u256, coll: u256, debt: u256, rate: u256, change: TroveChange },
    #[selector = sol("onAdjustTrove(uint256,uint256,uint256,(uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256))")]
    HookOnAdjustTrove { id: u256, coll: u256, debt: u256, change: TroveChange },
    #[selector = sol("onCloseTrove(uint256,(uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256),address,uint256,uint256)")]
    HookOnCloseTrove { id: u256, change: TroveChange, manager: Address, batch_coll: u256, batch_debt: u256 },
    #[selector = sol("onAdjustTroveInsideBatch(uint256,uint256,uint256,(uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256),address,uint256,uint256)")]
    HookOnAdjustTroveInsideBatch { id: u256, coll: u256, debt: u256, change: TroveChange, manager: Address, batch_coll: u256, batch_debt: u256 },
    #[selector = sol("onApplyTroveInterest(uint256,uint256,uint256,address,uint256,uint256,(uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256))")]
    HookOnApplyTroveInterest { id: u256, coll: u256, debt: u256, manager: Address, batch_coll: u256, batch_debt: u256, change: TroveChange },
    #[selector = sol("onRegisterBatchManager(address,uint256,uint256)")]
    HookOnRegisterBatchManager { manager: Address, rate: u256, fee: u256 },
    #[selector = sol("onLowerBatchManagerAnnualFee(address,uint256,uint256,uint256)")]
    HookOnLowerBatchManagerAnnualFee { manager: Address, coll: u256, debt: u256, fee: u256 },
    #[selector = sol("onSetBatchManagerAnnualInterestRate(address,uint256,uint256,uint256,uint256)")]
    HookOnSetBatchManagerAnnualInterestRate { manager: Address, coll: u256, debt: u256, rate: u256, upfront: u256 },
    #[selector = sol("onRemoveFromBatch(uint256,uint256,uint256,(uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256),address,uint256,uint256,uint256)")]
    HookOnRemoveFromBatch { id: u256, coll: u256, debt: u256, change: TroveChange, manager: Address, batch_coll: u256, batch_debt: u256, rate: u256 },
}
pub contract TroveManager {
    operations: Address,
    redemptions: Address,
    liquidations: Address,
    ccr: u256,
    mcr: u256,
    scr: u256,
    sp_penalty: u256,
    redist_penalty: u256,
    weth: Address,
    init(registry: Address, operations_module: Address, redemptions_module: Address, liquidations_module: Address) uses (mut operations, mut redemptions, mut liquidations, ctx: Ctx, mut ccr, mut mcr, mut scr, mut sp_penalty, mut redist_penalty, mut weth, storage: mut RawStorage, call: mut Call, log: mut Log) {
        require_code(operations_module)
        require_code(redemptions_module)
        require_code(liquidations_module)
        operations = operations_module
        redemptions = redemptions_module
        liquidations = liquidations_module
        let active = registry.static(RegistryMsg::GetactivePool {})
        storage.sstore(slot: 0, value: active.inner)
        let default_pool = registry.static(RegistryMsg::GetdefaultPool {})
        storage.sstore(slot: 1, value: default_pool.inner)
        let feed = registry.static(RegistryMsg::GetpriceFeed {})
        storage.sstore(slot: 2, value: feed.inner)
        log.emit(ActivePoolAddressChanged { value: active })
        log.emit(DefaultPoolAddressChanged { value: default_pool })
        log.emit(PriceFeedAddressChanged { value: feed })
        ccr = registry.static(RegistryMsg::GetCCR {})
        mcr = registry.static(RegistryMsg::GetMCR {})
        scr = registry.static(RegistryMsg::GetSCR {})
        sp_penalty = registry.static(RegistryMsg::GetLIQUIDATION_PENALTY_SP {})
        redist_penalty = registry.static(RegistryMsg::GetLIQUIDATION_PENALTY_REDISTRIBUTION {})
        let nft = registry.static(RegistryMsg::GettroveNFT {})
        storage.sstore(slot: 3, value: nft.inner)
        let bo = registry.static(RegistryMsg::GetborrowerOperations {})
        storage.sstore(slot: 4, value: bo.inner)
        let sp = registry.static(RegistryMsg::GetstabilityPool {})
        storage.sstore(slot: 5, value: sp.inner)
        let gas_pool = registry.static(RegistryMsg::GetgasPoolAddress {})
        storage.sstore(slot: 6, value: gas_pool.inner)
        let surplus = registry.static(RegistryMsg::GetcollSurplusPool {})
        storage.sstore(slot: 7, value: surplus.inner)
        let bold = registry.static(RegistryMsg::GetboldToken {})
        storage.sstore(slot: 8, value: bold.inner)
        let sorted = registry.static(RegistryMsg::GetsortedTroves {})
        storage.sstore(slot: 9, value: sorted.inner)
        weth = registry.static(RegistryMsg::GetWETH {})
        let collateral_registry = registry.static(RegistryMsg::GetcollateralRegistry {})
        storage.sstore(slot: 10, value: collateral_registry.inner)
        log.emit(TroveNFTAddressChanged { value: nft })
        log.emit(BorrowerOperationsAddressChanged { value: bo })
        log.emit(StabilityPoolAddressChanged { value: sp })
        log.emit(GasPoolAddressChanged { value: gas_pool })
        log.emit(CollSurplusPoolAddressChanged { value: surplus })
        log.emit(BoldTokenAddressChanged { value: bold })
        log.emit(SortedTrovesAddressChanged { value: sorted })
        log.emit(CollateralRegistryAddressChanged { value: collateral_registry })
    }
    recv TroveManagerMsg {
        GetactivePool -> Address uses (storage: RawStorage) { Address { inner: storage.sload(0) } }
        GettroveNFT -> Address uses (storage: RawStorage) { Address { inner: storage.sload(3) } }
        GetborrowerOperations -> Address uses (storage: RawStorage) { Address { inner: storage.sload(4) } }
        GetstabilityPool -> Address uses (storage: RawStorage) { Address { inner: storage.sload(5) } }
        GetsortedTroves -> Address uses (storage: RawStorage) { Address { inner: storage.sload(9) } }
        GetshutdownTime -> u256 uses (storage: RawStorage) { storage.sload(24) }
        GetlastZombieTroveId -> u256 uses (storage: RawStorage) { storage.sload(21) }
        GetgetTroveIdsCount -> u256 uses (storage: RawStorage) { storage.sload(19) }
        CCR -> u256 uses (ccr) { ccr }
        BatchIds { index } -> Address uses (mem: mut RawMem, storage: RawStorage) { Address { inner: state::array_get(data::BATCH_IDS, index) & data::MASK160 } }
        TroveIds { index } -> u256 uses (mem: mut RawMem, storage: RawStorage) { state::array_get(data::TROVE_IDS, index) }
        GetgetEntireBranchColl -> u256 uses (storage: RawStorage, call: mut Call) { base::entire_coll(Address { inner: storage.sload(0) }, Address { inner: storage.sload(1) }) }
        GetgetEntireBranchDebt -> u256 uses (storage: RawStorage, call: mut Call) { base::entire_debt(Address { inner: storage.sload(0) }, Address { inner: storage.sload(1) }) }
        LatestTrove { id } -> LatestTroveData uses (ctx: Ctx, mem: mut RawMem, storage: RawStorage) { data::latest_trove(id) }
        LatestBatch { manager } -> LatestBatchData uses (ctx: Ctx, mem: mut RawMem, storage: RawStorage) { data::latest_batch(manager) }
        AnnualRate { id } -> u256 uses (mem: mut RawMem, storage: RawStorage) { data::annual_rate(id) }
        CurrentICR { id, price } -> u256 uses (ctx: Ctx, mem: mut RawMem, storage: RawStorage) {
            let t = data::latest_trove(id)
            math::compute_cr(t.entire_coll, t.entire_debt, price)
        }
        Status { id } -> u8 uses (mem: mut RawMem, storage: RawStorage) { data::load_trove(id).status }
        Troves { id } -> (u256, u256, u256, u8, u64, u64, u64, u256, Address, u256) uses (mem: mut RawMem, storage: RawStorage) {
            let t = data::load_trove(id)
            (t.debt, t.coll, t.stake, t.status, t.array_index, t.last_debt_update, t.last_rate_adjustment, t.annual_rate, t.batch_manager, t.batch_shares)
        }
        RewardSnapshots { id } -> (u256, u256) uses (mem: mut RawMem, storage: RawStorage) {
            let slot = data::reward_slot(id)
            (storage.sload(slot), storage.sload(slot + 1))
        }

        Shutdown uses (ctx: Ctx, mem: mut RawMem, storage: mut RawStorage, call: mut Call) { hooks::require_bo()
            storage.sstore(slot: data::SHUTDOWN, value: ctx.timestamp())
            let active = Address { inner: storage.sload(0) }
            require_code(active)
            active.call(ActivePoolMsg::SetShutdownFlag {}) }
        Unbacked -> (u256, u256, bool) uses (scr, storage: RawStorage, call: mut Call) { let debt = base::entire_debt(Address { inner: storage.sload(0) }, Address { inner: storage.sload(1) })
            let sp = Address { inner: storage.sload(5) }
            let deposits = sp.static(StabilityPoolMsg::TotalBoldDeposits {})
            let unbacked = if debt > deposits { debt - deposits } else { 0 }
            let feed = Address { inner: storage.sload(2) }
            let price = feed.call(PriceMsg::Price {}).0
            let redeemable = base::tcr(Address { inner: storage.sload(0) }, Address { inner: storage.sload(1) }, price) >= scr && storage.sload(data::SHUTDOWN) == 0
            (unbacked, price, redeemable) }
        batchLiquidateTroves { ids } uses (liquidations, ctx: Ctx, ops: mut RawOps, call: mut Call) { forward(liquidations) }
        Redeem { user, amount, price, rate, iterations } -> u256 uses (redemptions, ctx: Ctx, ops: mut RawOps, call: mut Call) { forward(redemptions) }
        Urgent { amount, ids, min_coll } uses (redemptions, ctx: Ctx, ops: mut RawOps, call: mut Call) { forward(redemptions) }
        SetBatch { params } uses (operations, ctx: Ctx, ops: mut RawOps, call: mut Call) { forward(operations) }
        HookOnOpenTrove { owner, id, change, rate } uses (operations, ctx: Ctx, ops: mut RawOps, call: mut Call) { forward(operations) }
        HookOnOpenTroveAndJoinBatch { owner, id, change, manager, batch_coll, batch_debt } uses (operations, ctx: Ctx, ops: mut RawOps, call: mut Call) { forward(operations) }
        HookSetTroveStatusToActive { id } uses (operations, ctx: Ctx, ops: mut RawOps, call: mut Call) { forward(operations) }
        HookOnAdjustTroveInterestRate { id, coll, debt, rate, change } uses (operations, ctx: Ctx, ops: mut RawOps, call: mut Call) { forward(operations) }
        HookOnAdjustTrove { id, coll, debt, change } uses (operations, ctx: Ctx, ops: mut RawOps, call: mut Call) { forward(operations) }
        HookOnCloseTrove { id, change, manager, batch_coll, batch_debt } uses (operations, ctx: Ctx, ops: mut RawOps, call: mut Call) { forward(operations) }
        HookOnAdjustTroveInsideBatch { id, coll, debt, change, manager, batch_coll, batch_debt } uses (operations, ctx: Ctx, ops: mut RawOps, call: mut Call) { forward(operations) }
        HookOnApplyTroveInterest { id, coll, debt, manager, batch_coll, batch_debt, change } uses (operations, ctx: Ctx, ops: mut RawOps, call: mut Call) { forward(operations) }
        HookOnRegisterBatchManager { manager, rate, fee } uses (operations, ctx: Ctx, ops: mut RawOps, call: mut Call) { forward(operations) }
        HookOnLowerBatchManagerAnnualFee { manager, coll, debt, fee } uses (operations, ctx: Ctx, ops: mut RawOps, call: mut Call) { forward(operations) }
        HookOnSetBatchManagerAnnualInterestRate { manager, coll, debt, rate, upfront } uses (operations, ctx: Ctx, ops: mut RawOps, call: mut Call) { forward(operations) }
        HookOnRemoveFromBatch { id, coll, debt, change, manager, batch_coll, batch_debt, rate } uses (operations, ctx: Ctx, ops: mut RawOps, call: mut Call) { forward(operations) }
    }
}
