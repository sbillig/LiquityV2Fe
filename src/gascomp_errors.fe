    let p = core::ptr::alloc_bytes(32)
    mem.mstore(addr: core::ptr::offset_bytes(p, 0), value: 0x47435a3a2057726f6e6720455448000000000000000000000000000000000000)
    DynString::from_payload(source: core::ptr::MemSpan::from_raw_parts(ptr: p, len: 14))
}
