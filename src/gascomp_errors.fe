use std::abi::DynString
use std::evm::RawMem
pub fn wrong_branch() -> DynString uses (mem: mut RawMem) {
    let p = core::ptr::alloc_bytes(32)
    mem.mstore(addr: core::ptr::offset_bytes(p, 0), value: 0x47435a3a2057726f6e6720636f6c6c206272616e636800000000000000000000)
    DynString::from_payload(source: core::ptr::MemSpan::from_raw_parts(ptr: p, len: 22))
}
