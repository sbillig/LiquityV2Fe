use std::evm::read_storage_word
// BorrowerOperations layout verified with solc 0.8.24 storage-layout output.
// The delegate/batch maps are read and written as typed entries through one
// raw projection per function; readers use `storage_at`, writers use the
// map's mutable `at` projection. Scalar BO slots stay raw words.
use std::evm::{Address, RawStorage, StorageMap, storage_at}
use std::evm::packed::keccak_packed
use super::add_remove_managers::ManagerSlots
pub const DELEGATES: u256 = 10
pub const BATCH_OF: u256 = 11
pub const BATCH_MANAGERS: u256 = 12
pub const MASK128: u256 = 0xffffffffffffffffffffffffffffffff
pub const MASK160: u256 = 0xffffffffffffffffffffffffffffffffffffffff
pub fn managers() -> ManagerSlots { ManagerSlots { add: 3, remove: 4 } }
pub fn map_slot(_ key: u256, _ root: u256) -> u256 { keccak_packed((key, root)) }
pub fn address_at(_ slot: u256) -> Address uses (storage: RawStorage) { Address::new(read_storage_word(slot) & MASK160) }
pub fn is_shutdown() -> bool uses (storage: RawStorage) { ((read_storage_word(9) >> 160) & 255) != 0 }
pub fn shutdown() uses (storage: mut RawStorage) { unsafe { storage.sstore(slot: 9, value: (read_storage_word(9) & ~(255 << 160)) | (1 << 160)) } }
pub fn batch_of(_ id: u256) -> Address uses (storage: RawStorage) {
    let batches = unsafe { ref storage_at<StorageMap<u256, u256>>(BATCH_OF) }
    Address::new(batches[id] & MASK160)
}
pub fn set_batch(_ id: u256, _ manager: Address) uses (storage: mut RawStorage) {
    let batches = unsafe { StorageMap<u256, u256>::at(BATCH_OF) }
    batches[id] = (batches[id] & ~MASK160) | manager.word()
}
pub struct IndividualDelegate {
    pub account: Address, pub min_rate: u128, pub max_rate: u128, pub min_period: u256,
}
impl Copy for IndividualDelegate {}
pub struct BatchManager {
    pub min_rate: u128, pub max_rate: u128, pub min_period: u256,
}
impl Copy for BatchManager {}

// `account_word` keeps the Solidity padding above the address; the rate pair
// packs into one word as typed `u128` fields.
struct DelegateEntry {
    pub account_word: u256, pub min_rate: u128, pub max_rate: u128, pub min_period: u256,
}
impl Copy for DelegateEntry {}
struct BatchManagerEntry {
    pub min_rate: u128, pub max_rate: u128, pub min_period: u256,
}
impl Copy for BatchManagerEntry {}

pub fn delegate(_ id: u256) -> IndividualDelegate uses (storage: RawStorage) {
    let delegates = unsafe { ref storage_at<StorageMap<u256, DelegateEntry>>(DELEGATES) }
    let e = delegates[id]
    IndividualDelegate { account: Address::new(e.account_word & MASK160), min_rate: e.min_rate, max_rate: e.max_rate, min_period: e.min_period }
}
pub fn set_delegate(_ id: u256, _ value: IndividualDelegate) uses (storage: mut RawStorage) {
    let delegates = unsafe { StorageMap<u256, DelegateEntry>::at(DELEGATES) }
    delegates[id].account_word = (delegates[id].account_word & ~MASK160) | value.account.word()
    delegates[id].min_rate = value.min_rate
    delegates[id].max_rate = value.max_rate
    delegates[id].min_period = value.min_period
}
pub fn clear_delegate(_ id: u256) uses (storage: mut RawStorage) {
    set_delegate(id, IndividualDelegate { account: Address::zero(), min_rate: 0, max_rate: 0, min_period: 0 })
}
pub fn batch_manager(_ manager: Address) -> BatchManager uses (storage: RawStorage) {
    let managers = unsafe { ref storage_at<StorageMap<Address, BatchManagerEntry>>(BATCH_MANAGERS) }
    let e = managers[manager]
    BatchManager { min_rate: e.min_rate, max_rate: e.max_rate, min_period: e.min_period }
}
pub fn set_batch_manager(_ manager: Address, _ value: BatchManager) uses (storage: mut RawStorage) {
    let managers = unsafe { StorageMap<Address, BatchManagerEntry>::at(BATCH_MANAGERS) }
    managers[manager] = BatchManagerEntry { min_rate: value.min_rate, max_rate: value.max_rate, min_period: value.min_period }
}
