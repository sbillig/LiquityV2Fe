// TroveManager packed writes, indexed arrays and exact batch-share accounting.
use core::num::IntDowncast
use std::evm::{Address, Ctx, RawStorage, revert_error, storage_at_mut}
use super::trove_data::TroveManagerLayout
use std::evm::panic::{Panic, PANIC_INDEX_OUT_OF_BOUNDS}
use std::evm::packed::keccak_packed
use super::trove_data as data
use super::types::TroveChange
use super::constants::MAX_BATCH_SHARES_RATIO
#[error]
pub struct BatchSharesRatioTooHigh {}
pub fn set_status(_ id: u256, _ status: u8) uses (storage: mut RawStorage) {
    let tm = unsafe { storage_at_mut<TroveManagerLayout>(0) }
    tm.troves[id].status = status
}
pub fn set_trove_index(_ id: u256, _ index: u64) uses (storage: mut RawStorage) {
    let tm = unsafe { storage_at_mut<TroveManagerLayout>(0) }
    tm.troves[id].array_index = index
}
pub fn set_trove_debt_time(_ id: u256, _ time: u256) uses (storage: mut RawStorage) {
    let tm = unsafe { storage_at_mut<TroveManagerLayout>(0) }
    tm.troves[id].last_debt_update = time.downcast_truncate()
}
pub fn set_trove_rate_time(_ id: u256, _ time: u256) uses (storage: mut RawStorage) {
    let tm = unsafe { storage_at_mut<TroveManagerLayout>(0) }
    tm.troves[id].last_rate_adjustment = time.downcast_truncate()
}
pub fn set_batch_index(_ manager: Address, _ index: u64) uses (storage: mut RawStorage) {
    let tm = unsafe { storage_at_mut<TroveManagerLayout>(0) }
    tm.batches[manager].array_index = index
}
pub fn set_batch_debt_time(_ manager: Address, _ time: u256) uses (storage: mut RawStorage) {
    let tm = unsafe { storage_at_mut<TroveManagerLayout>(0) }
    tm.batches[manager].last_debt_update = time.downcast_truncate()
}
pub fn set_batch_rate_time(_ manager: Address, _ time: u256) uses (storage: mut RawStorage) {
    let tm = unsafe { storage_at_mut<TroveManagerLayout>(0) }
    tm.batches[manager].last_rate_adjustment = time.downcast_truncate()
}
pub fn set_manager(_ id: u256, _ manager: Address) uses (storage: mut RawStorage) {
    let tm = unsafe { storage_at_mut<TroveManagerLayout>(0) }
    tm.troves[id].batch_word = (tm.troves[id].batch_word & ~data::MASK160) | manager.inner
}
#[arithmetic(unchecked)]
fn array_slot(_ root: u256, _ index: u256) -> u256 { keccak_packed(root) + index }
pub fn array_get(_ root: u256, _ index: u256) -> u256 uses ( storage: RawStorage) {
    if index >= unsafe { storage.sload(root) } { revert_error(Panic::from(PANIC_INDEX_OUT_OF_BOUNDS)) }
    unsafe { storage.sload(array_slot(root, index)) }
}
pub fn push_trove_id(_ id: u256) uses (storage: mut RawStorage) {
    let tm = unsafe { storage_at_mut<TroveManagerLayout>(0) }
    tm.trove_ids.push(id)
}
pub fn push_batch_id(_ manager: Address) uses (storage: mut RawStorage) {
    let tm = unsafe { storage_at_mut<TroveManagerLayout>(0) }
    tm.batch_ids.push(manager)
}
pub fn remove_trove_id(_ id: u256, _ len: u256) uses (storage: mut RawStorage) {
    let index = data::load_trove(id).array_index
    let tm = unsafe { storage_at_mut<TroveManagerLayout>(0) }
    let moved = tm.trove_ids.get(len - 1)
    tm.trove_ids.set(index: index as u256, value: moved)
    tm.trove_ids.pop()
    set_trove_index(moved, index)
}
pub fn update_batch_shares(_ id: u256, _ manager: Address, _ change: TroveChange, _ new_debt: u256, _ batch_coll: u256, _ batch_debt: u256, _ check_ratio: bool)
uses (ctx: Ctx, storage: mut RawStorage) {
    var increase = change.debt_increase + change.upfront_fee + change.applied_redist_bold_debt_gain
    var decrease: u256 = 0
    if increase > change.debt_decrease { increase -= change.debt_decrease }
    else { decrease = change.debt_decrease - increase
        increase = 0
    }
    let tm = unsafe { storage_at_mut<TroveManagerLayout>(0) }
    let shares = tm.batches[manager].total_shares
    if increase == 0 && decrease == 0 { tm.batches[manager].debt = batch_debt }
    else if increase > 0 {
        let delta = if batch_debt == 0 { increase } else {
            // Keep the multiplication first, even when the ratio check is disabled.
            if shares * MAX_BATCH_SHARES_RATIO < batch_debt && check_ratio { revert_error(BatchSharesRatioTooHigh {}) }
            shares * increase / batch_debt
        }
        tm.troves[id].batch_shares += delta
        tm.batches[manager].debt = batch_debt + increase
        tm.batches[manager].total_shares = shares + delta
    } else if decrease > 0 {
        if new_debt == 0 {
            tm.batches[manager].debt = batch_debt - decrease
            tm.batches[manager].total_shares = shares - tm.troves[id].batch_shares
            tm.troves[id].batch_shares = 0
        } else {
            let delta = shares * decrease / batch_debt
            tm.troves[id].batch_shares -= delta
            tm.batches[manager].debt = batch_debt - decrease
            tm.batches[manager].total_shares = shares - delta
        }
    }
    tm.batches[manager].last_debt_update = ctx.timestamp().downcast_truncate()
    var coll_increase = change.coll_increase + change.applied_redist_coll_gain
    var coll_decrease: u256 = 0
    if coll_increase > change.coll_decrease { coll_increase -= change.coll_decrease }
    else { coll_decrease = change.coll_decrease - coll_increase
        coll_increase = 0
    }
    if coll_increase == 0 && coll_decrease == 0 { tm.batches[manager].coll = batch_coll }
    else if coll_increase > 0 { tm.batches[manager].coll = batch_coll + coll_increase }
    else if coll_decrease > 0 { tm.batches[manager].coll = batch_coll - coll_decrease }
}
pub fn remove_batch_shares(_ id: u256, _ coll: u256, _ debt: u256, _ change: TroveChange, _ manager: Address, _ batch_coll: u256, _ batch_debt: u256)
uses (ctx: Ctx, storage: mut RawStorage) {
    let t = data::load_trove(id)
    let decrease_debt = debt - change.upfront_fee - change.applied_redist_bold_debt_gain
    let decrease_coll = coll - change.applied_redist_coll_gain
    let tm = unsafe { storage_at_mut<TroveManagerLayout>(0) }
    tm.batches[manager].total_shares -= t.batch_shares
    tm.batches[manager].debt = batch_debt - decrease_debt
    tm.batches[manager].coll = batch_coll - decrease_coll
    tm.batches[manager].last_debt_update = ctx.timestamp().downcast_truncate()
    tm.troves[id].batch_word &= ~data::MASK160
    tm.troves[id].batch_shares = 0
}
