// SPDX-License-Identifier: MIT
// Port of contracts/src/Dependencies/LiquityMath.sol.
use super::constants::{DECIMAL_PRECISION, ONE_YEAR}

pub fn min(_ a: u256, _ b: u256) -> u256 { if a < b { a } else { b } }
pub fn max(_ a: u256, _ b: u256) -> u256 { if a >= b { a } else { b } }
pub fn sub_min_zero(_ a: u256, _ b: u256) -> u256 { if a > b { a - b } else { 0 } }
pub fn absolute_difference(_ a: u256, _ b: u256) -> u256 {
    if a >= b { a - b } else { b - a }
}
pub fn dec_mul(_ x: u256, _ y: u256) -> u256 {
    (x * y + DECIMAL_PRECISION / 2) / DECIMAL_PRECISION
}
pub fn dec_pow(_ base: u256, _ minutes: u256) -> u256 {
    var n = min(minutes, 525600000)
    if n == 0 { return DECIMAL_PRECISION }
    var y = DECIMAL_PRECISION
    var x = base
    while n > 1 {
        if n % 2 == 0 {
            x = dec_mul(x, x)
            n = n / 2
        } else {
            y = dec_mul(x, y)
            x = dec_mul(x, x)
            n = (n - 1) / 2
        }
    }
    dec_mul(x, y)
}
pub fn compute_cr(_ coll: u256, _ debt: u256, _ price: u256) -> u256 {
    if debt > 0 { coll * price / debt } else { 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff }
}
// LiquityBase._calcInterest preserves the Solidity order of operations.
pub fn calc_interest(_ weighted_debt: u256, _ period: u256) -> u256 {
    weighted_debt * period / ONE_YEAR / DECIMAL_PRECISION
}

#[test]
fn decay_and_rounding() {
    assert(dec_pow(0, 0) == DECIMAL_PRECISION)
    assert(dec_pow(0, 1) == 0)
    assert(dec_mul(1, DECIMAL_PRECISION / 2) == 1)
    assert(dec_mul(1, DECIMAL_PRECISION / 2 - 1) == 0)
    assert(dec_pow(998076443575628800, 360) == 500000000000011054)
    assert(dec_pow(998076443575628800, 525600001) == dec_pow(998076443575628800, 525600000))
}
#[test]
fn debt_and_interest() {
    assert(compute_cr(0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff, 0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff) == 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff)
    assert(compute_cr(2, 4, DECIMAL_PRECISION) == DECIMAL_PRECISION / 2)
    assert(calc_interest(2000 * DECIMAL_PRECISION * DECIMAL_PRECISION / 20, ONE_YEAR) == 100 * DECIMAL_PRECISION)
    assert(sub_min_zero(1, 2) == 0)
    assert(absolute_difference(1, 3) == 2)
}
