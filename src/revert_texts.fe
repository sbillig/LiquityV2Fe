// SPDX-License-Identifier: MIT
// Exact ABI strings from the pinned Solidity reference.
use std::abi::DynString
use std::evm::{RawMem, revert_error}
#[error]
pub struct Error { pub reason: DynString }
pub fn require(_ condition: bool, _ reason: own DynString) {
    if !condition { revert_error(Error { reason }) }
}

pub fn default_name() -> DynString uses (mem: mut RawMem) {
    let data = core::ptr::alloc_bytes(32)
    mem.mstore(addr: core::ptr::offset_bytes(data, 0), value: 0x44656661756c74506f6f6c000000000000000000000000000000000000000000)
    DynString::from_payload(source: core::ptr::MemSpan::from_raw_parts(ptr: data, len: 11))
}

