// Exact ABI strings from the pinned Solidity reference.
use std::abi::DynString
use std::evm::{revert_error}
#[error]
pub struct Error { pub reason: DynString }
pub fn require(_ condition: bool, _ reason: own DynString) {
    if !condition { revert_error(Error { reason }) }
}

pub fn default_name() -> DynString { "DefaultPool" }

pub fn default_active_only() -> DynString { "DefaultPool: Caller is not the ActivePool" }

pub fn default_manager_only() -> DynString { "DefaultPool: Caller is not the TroveManager" }

