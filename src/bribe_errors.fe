use std::abi::DynString
pub fn current() -> DynString { "BribeInitiative: cannot-claim-for-current-epoch" }
pub fn claimed() -> DynString { "BribeInitiative: already-claimed" }
pub fn empty() -> DynString { "BribeInitiative: no-bribe" }
pub fn user_epoch() -> DynString { "BribeInitiative: invalid-prev-lqty-allocation-epoch" }
pub fn total_epoch() -> DynString { "BribeInitiative: invalid-prev-total-lqty-allocation-epoch" }
pub fn total_zero() -> DynString { "BribeInitiative: total-lqty-allocation-zero" }
pub fn user_zero() -> DynString { "BribeInitiative: lqty-allocation-zero" }
pub fn same_token() -> DynString { "BribeInitiative: bribe-token-cannot-be-bold" }
pub fn sender() -> DynString { "BribeInitiative: invalid-sender" }
pub fn past() -> DynString { "BribeInitiative: now-or-future-epochs" }
