use std::abi::DynString
use std::evm::RawMem
pub fn current() -> DynString uses (mem: mut RawMem) {
    let p = core::ptr::alloc_bytes(64)
    mem.mstore(addr: core::ptr::offset_bytes(p, 0), value: 0x4272696265496e69746961746976653a2063616e6e6f742d636c61696d2d666f)
    mem.mstore(addr: core::ptr::offset_bytes(p, 32), value: 0x722d63757272656e742d65706f63680000000000000000000000000000000000)
    DynString::from_payload(source: core::ptr::MemSpan::from_raw_parts(ptr: p, len: 47))
}
