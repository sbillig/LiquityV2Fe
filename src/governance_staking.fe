use std::evm::read_storage_word
use std::evm::{Address, Ctx, Call, Create, RawStorage, Log}
use super::governance_snapshots::map
use super::user_proxy_factory as factory
use super::user_proxy::{UserProxyMsg, PermitParams}
use super::governance_guard as guard
use super::revert_texts::require
use super::governance_errors as error
#[event]
pub struct DepositLQTY {
    #[indexed]
    pub user: Address,
    pub reward_recipient: Address, pub lqty_amount: u256,
    pub lusd_received: u256, pub lusd_sent: u256, pub eth_received: u256, pub eth_sent: u256,
}
#[event]
pub struct WithdrawLQTY {
    #[indexed]
    pub user: Address,
    pub recipient: Address, pub lqty_received: u256, pub lqty_sent: u256,
    pub lusd_received: u256, pub lusd_sent: u256, pub eth_received: u256, pub eth_sent: u256,
}
#[inline(never)]
pub fn increase(_ implementation: Address, _ amount: u256) -> Address
uses (ctx: Ctx, storage: mut RawStorage, create: mut Create, log: mut Log) {
    require(amount > 0, error::zero_amount())
    let proxy = factory::derive(implementation, ctx.caller())
    if ctx.extcodesize(proxy) == 0 { let deployed = factory::deploy(implementation) }
    let s = map(ctx.caller(), 8)
    unsafe { storage.sstore(slot: s, value: read_storage_word(s) + amount) }
    unsafe { storage.sstore(slot: s + 1, value: read_storage_word(s + 1) + ctx.timestamp() * amount) }
    proxy
}
fn deposit_event(_ amount: u256, _ recipient: Address, _ rewards: (u256, u256, u256, u256)) uses (ctx: Ctx, log: mut Log) {
    log.emit(DepositLQTY { user: ctx.caller(), reward_recipient: recipient, lqty_amount: amount,
        lusd_received: rewards.0, lusd_sent: rewards.1, eth_received: rewards.2, eth_sent: rewards.3 })
}
#[inline(never)]
fn withdrawal(_ proxy: Address, _ amount: u256, _ send: bool, _ recipient: Address) -> (u256, u256)
uses (ctx: Ctx, call: mut Call, log: mut Log) {
    let r = proxy.call(UserProxyMsg::Unstake { amount, send, recipient })
    log.emit(WithdrawLQTY { user: ctx.caller(), recipient, lqty_received: r.0, lqty_sent: r.1,
        lusd_received: r.2, lusd_sent: r.3, eth_received: r.4, eth_sent: r.5 })
    (r.3, r.5)
}
pub fn deposit(_ implementation: Address, _ amount: u256, _ send: bool, _ recipient: Address)
uses (ctx: Ctx, storage: mut RawStorage, create: mut Create, log: mut Log, call: mut Call) {
    guard::enter()
    let proxy = increase(implementation, amount)
    let rewards = proxy.call(UserProxyMsg::Stake { amount, from: ctx.caller(), send, recipient })
    deposit_event(amount, recipient, rewards)
    guard::exit()
}
pub fn deposit_permit(_ implementation: Address, _ amount: u256, _ p: PermitParams, _ send: bool, _ recipient: Address)
uses (ctx: Ctx, storage: mut RawStorage, create: mut Create, log: mut Log, call: mut Call) {
    guard::enter()
    let proxy = increase(implementation, amount)
    // Solidity validates calldata tuple fields while encoding the outgoing call.
    if p.owner.word() >> 160 != 0 || p.spender.word() >> 160 != 0 || p.v > 255 { std::evm::revert(()) }
    let rewards = proxy.call(UserProxyMsg::StakePermit { amount, from: ctx.caller(), p, send, recipient })
    deposit_event(amount, recipient, rewards)
    guard::exit()
}
pub fn withdraw(_ implementation: Address, _ amount: u256, _ send: bool, _ recipient: Address)
uses (ctx: Ctx, storage: mut RawStorage, log: mut Log, call: mut Call) {
    guard::enter()
    let s = map(ctx.caller(), 8)
    let proxy = factory::derive(implementation, ctx.caller())
    require(ctx.extcodesize(proxy) != 0, error::no_proxy())
    let unallocated = read_storage_word(s)
    require(amount <= unallocated, error::insufficient())
    if amount < unallocated {
        let decrease = amount * read_storage_word(s + 1) / unallocated
        unsafe { storage.sstore(slot: s + 1, value: read_storage_word(s + 1) - decrease) }
    } else { unsafe { storage.sstore(slot: s + 1, value: 0) } }
    unsafe { storage.sstore(slot: s, value: unallocated - amount) }
    let ignored = withdrawal(proxy, amount, send, recipient)
    guard::exit()
}
pub fn rewards(_ implementation: Address, _ recipient: Address) -> (u256, u256)
uses (ctx: Ctx, log: mut Log, call: mut Call) {
    let proxy = factory::derive(implementation, ctx.caller())
    require(ctx.extcodesize(proxy) != 0, error::no_proxy())
    withdrawal(proxy, 0, true, recipient)
}
