use std::abi::DynString
use std::evm::RawMem
pub fn owner() -> DynString uses (mem: mut RawMem) {
    let p = core::ptr::alloc_bytes(32)
    mem.mstore(addr: core::ptr::offset_bytes(p, 0), value: 0x4f776e61626c653a2063616c6c6572206973206e6f7420746865206f776e6572)
    DynString::from_payload(source: core::ptr::MemSpan::from_raw_parts(ptr: p, len: 32))
}
