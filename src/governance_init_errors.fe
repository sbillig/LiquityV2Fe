pub fn cutoff() -> DynString uses (mem: mut RawMem) {
    let p = core::ptr::alloc_bytes(64)
    mem.mstore(addr: core::ptr::offset_bytes(p, 0), value: 0x476f763a2065706f63682d766f74696e672d6375746f66662d67742d65706f63)
    mem.mstore(addr: core::ptr::offset_bytes(p, 32), value: 0x682d6475726174696f6e00000000000000000000000000000000000000000000)
