// SPDX-License-Identifier: BUSL-1.1
use core::abi::{AbiSize, AbiSpan, ByteInput}
use core::num::IntDowncast
use std::abi::{sol, Sol, DynArray, DynString}
use std::evm::{Address, Call, RawOps, encode_abi_payload, revert_error}
use std::evm::panic::Panic
use super::bytes_builder::BytesBuilder
use super::helper_calls::*
pub struct CombinedTroveData {
    pub id: u256, pub entire_debt: u256, pub entire_coll: u256,
    pub redist_bold_debt_gain: u256, pub redist_coll_gain: u256,
    pub accrued_interest: u256, pub recorded_debt: u256, pub annual_interest_rate: u256,
    pub accrued_batch_management_fee: u256, pub last_interest_rate_adj_time: u256,
    pub stake: u256, pub last_debt_update_time: u256, pub interest_batch_manager: Address,
    pub batch_debt_shares: u256, pub snapshot_eth: u256, pub snapshot_bold_debt: u256,
}
impl AbiSize for CombinedTroveData { const HEAD_SIZE: u256 = 512
    const IS_DYNAMIC: bool = false }
pub struct DebtPerInterestRate { pub interest_batch_manager: Address, pub interest_rate: u256, pub debt: u256 }
impl AbiSize for DebtPerInterestRate { const HEAD_SIZE: u256 = 96
    const IS_DYNAMIC: bool = false }
impl AbiSpan<Sol> for CombinedTroveData {
    fn payload_end<I: ByteInput>(_: I, base: u256, pos: u256) -> u256 { pos + 512 }
}
impl AbiSpan<Sol> for DebtPerInterestRate {
    fn payload_end<I: ByteInput>(_: I, base: u256, pos: u256) -> u256 { pos + 96 }
}
#[error]
pub struct Error { pub reason: DynString }
pub fn resolve(_ registry: Address, _ index: u256) -> (Address, Address) uses (call: mut Call) {
    let manager = registry.static(HelperRegistryMsg::Manager { index })
    if manager == Address::zero() {
        revert_error(Error { reason: "Invalid collateral index" })
    }
    let sorted = manager.static(HelperManagerMsg::Sorted {})
    assert(sorted != Address::zero())
    (manager, sorted)
}
fn allocate(_ count: u256, _ stride: u256) -> BytesBuilder {
    // Solidity rejects memory-array lengths larger than uint64 before allocation.
    if count > 0xffffffffffffffff { revert_error(Panic { code: 0x41 }) }
    BytesBuilder::zeroed(count * stride)
}
fn one(_ manager: Address, _ id: u256, _ out: mut BytesBuilder, _ base: u256) uses (call: mut Call) {
    out.write_word(at: base, value: id)
    let t = manager.static(HelperManagerMsg::Trove { id })
    out.write_word(at: base + 32, value: t.entire_debt)
    out.write_word(at: base + 64, value: t.entire_coll)
    out.write_word(at: base + 96, value: t.redist_bold_debt_gain)
    out.write_word(at: base + 128, value: t.redist_coll_gain)
    out.write_word(at: base + 160, value: t.accrued_interest)
    out.write_word(at: base + 192, value: t.recorded_debt)
    out.write_word(at: base + 224, value: t.annual_interest_rate)
    out.write_word(at: base + 256, value: t.accrued_batch_management_fee)
    out.write_word(at: base + 288, value: t.last_interest_rate_adj_time)
    let stored = manager.static(HelperManagerMsg::Stored { id })
    out.write_word(at: base + 320, value: stored.2)
    out.write_word(at: base + 352, value: stored.5 as u256)
    out.write_word(at: base + 384, value: stored.8.inner)
    out.write_word(at: base + 416, value: stored.9)
    let snapshot = manager.static(HelperManagerMsg::Snapshot { id })
    out.write_word(at: base + 448, value: snapshot.0)
    out.write_word(at: base + 480, value: snapshot.1)
}
pub msg MultiTroveGetterMsg {
    #[selector = sol("collateralRegistry()")]
    Registry -> Address,
    #[selector = sol("getMultipleSortedTroves(uint256,int256,uint256)")]
    Multiple { index: u256, start: i256, count: u256 } -> DynArray<CombinedTroveData>,
    #[selector = sol("getDebtPerInterestRateAscending(uint256,uint256,uint256)")]
    Ascending { index: u256, start: u256, count: u256 } -> (DynArray<DebtPerInterestRate>, u256),
}
pub contract MultiTroveGetter {
    registry: Address,
    init(collateral_registry: Address) uses (mut registry) { registry = collateral_registry }
    recv MultiTroveGetterMsg {
        Registry -> Address uses (registry) { registry }
        Multiple { index, start, count } -> DynArray<CombinedTroveData> uses (registry, call: mut Call) {
            let (manager, sorted) = resolve(registry, index)
            let descend = start >= 0
            let offset: u256 = if descend { start.downcast_truncate() } else { (-(start + 1)).downcast_truncate() }
            let total = sorted.static(HelperSortedMsg::Size {})
            if offset >= total { return DynArray::empty() }
            let limit = total - offset
            let count = if count > limit { limit } else { count }
            var current = if descend { sorted.static(HelperSortedMsg::First {}) } else { sorted.static(HelperSortedMsg::Last {}) }
            var i = 0
            while i < offset {
                current = if descend { sorted.static(HelperSortedMsg::Next { id: current }) } else { sorted.static(HelperSortedMsg::Prev { id: current }) }
                i += 1
            }
            var out = allocate(count, 512)
            i = 0
            while i < count {
                one(manager, current, mut out, i * 512)
                current = if descend { sorted.static(HelperSortedMsg::Next { id: current }) } else { sorted.static(HelperSortedMsg::Prev { id: current }) }
                i += 1
            }
            out.into_dyn_array(count)
        }
        Ascending { index, start, count } -> (DynArray<DebtPerInterestRate>, u256) uses (registry, call: mut Call, ops: mut RawOps) {
            let (manager, sorted) = resolve(registry, index)
            var out = allocate(count, 96)
            var current = if start == 0 { sorted.static(HelperSortedMsg::Last {}) } else { start }
            var i = 0
            while i < count {
                if current == 0 { break }
                let node = sorted.static(HelperSortedMsg::Node { id: current })
                let t = manager.static(HelperManagerMsg::Trove { id: current })
                out.write_word(at: i * 96, value: node.2.inner)
                out.write_word(at: i * 96 + 32, value: t.annual_interest_rate)
                out.write_word(at: i * 96 + 64, value: t.entire_debt)
                current = node.1
                i += 1
            }
            let values: DynArray<DebtPerInterestRate> = out.into_dyn_array(count)
            // Solidity returns two top-level values, not one dynamic tuple value.
            let output = encode_abi_payload((values, current))
            ops.return_data(data: output.span())
        }
    }
}
