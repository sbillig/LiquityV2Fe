// SPDX-License-Identifier: MIT
use std::abi::{sol, DynString, Bytes}
use super::metadata_json as json
pub msg JsonMsg {
    #[selector = sol("property(string,string,bool)")]
    Property { key: DynString, value: DynString, last: bool } -> DynString,
    #[selector = sol("property(string,string)")]
    PropertyMore { key: DynString, value: DynString } -> DynString,
    #[selector = sol("object(string,string)")]
    Object { key: DynString, value: DynString } -> DynString,
    #[selector = sol("xmlImage(string)")]
    Image { value: DynString } -> DynString,
    #[selector = sol("encode(bytes)")]
    Encode { value: Bytes } -> DynString,
    #[selector = sol("formattedMetadata(string,string,string,string)")]
    Format { name: DynString, description: DynString, svg: DynString, attributes: DynString } -> DynString,
}
pub contract MetadataJsonHarness {
    recv JsonMsg {
        Property { key, value, last } -> DynString { json::property(key, value, last) }
        PropertyMore { key, value } -> DynString { json::property(key, value, false) }
        Object { key, value } -> DynString { json::object(key, value) }
        Image { value } -> DynString { json::xml_image(value) }
        Encode { value } -> DynString { super::metadata_string::base64(DynString::from_payload(source: value.payload_span())) }
        Format { name, description, svg, attributes } -> DynString { json::formatted_metadata(name, description, svg, attributes) }
    }
}
