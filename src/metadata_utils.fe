use core::ptr
use core::abi::{Decode, ByteInput}
use std::abi::{Sol, DynString, DynArray}
use std::evm::{revert_error}
use std::evm::packed::keccak_packed
use super::metadata_string::{cat, fragment, text, decimal, slice}
#[error]
pub struct Error { pub reason: DynString }
fn require(_ condition: bool, _ reason: DynString) { if !condition { revert_error(Error { reason }) } }
pub fn to_locale(_ value: DynString) -> DynString {
    let len = value.len()
    if len < 4 { return value }
    let size = len + (len - 1) / 3
    let out = ptr::alloc_bytes(size)
    var i = 0
    var j = 0
    while i < len {
        if i > 0 && (len - i) % 3 == 0 { unsafe { *ptr::offset_bytes(out, j) = 44 }
            j += 1 }
        unsafe { *ptr::offset_bytes(out, j) = unsafe { *ptr::offset_bytes(value.payload_span().ptr(), i) } }
        i += 1
        j += 1
    }
    DynString::from_payload(source: unsafe { ptr::MemSpan::from_raw_parts(ptr: out, len: size) })
}
pub fn set_css_var(_ key: DynString, _ value: DynString) -> DynString {
    let a = cat(fragment("--"), key.as_bytes())
    let b = cat(a.as_bytes(), fragment(":"))
    cat(cat(b.as_bytes(), value.as_bytes()).as_bytes(), fragment(";"))
}
pub fn get_css_var(_ key: DynString) -> DynString { cat(cat(fragment("var(--"), key.as_bytes()).as_bytes(), fragment(")")) }
pub fn get_def_url(_ key: DynString) -> DynString { cat(cat(fragment("url(#"), key.as_bytes()).as_bytes(), fragment(")")) }
pub fn rgba(_ r: u256, _ g: u256, _ b: u256, _ a: u256) -> DynString {
    let alpha = if a < 100 { cat(fragment("0."), decimal(a).as_bytes()) } else { text(fragment("1")) }
    let out = cat(fragment("rgba("), decimal(r).as_bytes())
    let out = cat(cat(out.as_bytes(), fragment(",")).as_bytes(), decimal(g).as_bytes())
    let out = cat(cat(out.as_bytes(), fragment(",")).as_bytes(), decimal(b).as_bytes())
    let out = cat(cat(out.as_bytes(), fragment(",")).as_bytes(), alpha.as_bytes())
    cat(out.as_bytes(), fragment(")"))
}
pub fn white_a(_ alpha: u256) -> DynString { rgba(255, 255, 255, alpha) }
pub fn black_a(_ alpha: u256) -> DynString { rgba(0, 0, 0, alpha) }
pub fn css_braces(_ key: DynString, _ value: DynString) -> DynString {
    let out = cat(fragment(" {"), key.as_bytes())
    let out = cat(cat(out.as_bytes(), fragment(": ")).as_bytes(), value.as_bytes())
    cat(out.as_bytes(), fragment("}"))
}
fn string_at(_ values: DynArray<DynString>, _ i: u256) -> DynString {
    let input = values.encoded_span()
    let offset = input.word_at(32 + i * 32)
    <DynString as Decode<Sol>>::decode_from(input, 32 + offset)
}
pub fn css_braces_many(_ keys: DynArray<DynString>, _ values: DynArray<DynString>) -> DynString {
    require(keys.len() == values.len(), text(fragment("Utils: Unbalanced Arrays")))
    var out = text(fragment(" {"))
    var i = 0
    while i < keys.len() {
        out = cat(out.as_bytes(), string_at(keys, i).as_bytes())
        out = cat(out.as_bytes(), fragment(": "))
        out = cat(out.as_bytes(), string_at(values, i).as_bytes())
        out = cat(out.as_bytes(), fragment("; "))
        i += 1
    }
    cat(out.as_bytes(), fragment("}"))
}
pub fn to_string(_ value: u256, _ precision: u256) -> DynString {
    if value == 0 { return text(fragment("0")) }
    let digits = decimal(value)
    require(precision > 0 && precision <= digits.len(), text(fragment("Utils: precision invalid")))
    if precision == digits.len() { return cat(fragment("0."), digits.as_bytes()) }
    let split = digits.len() - precision
    let out = cat(slice(digits, 0, split).as_bytes(), fragment("."))
    cat(out.as_bytes(), slice(digits, split, digits.len()).as_bytes())
}
pub fn points(_ values: DynArray<[u256; 2]>, _ use_precision: bool, _ precision: u256) -> DynString {
    require(values.len() >= 3, text(fragment("Utils: Array too short")))
    var out = text(fragment("points=\""))
    var i = 0
    while i < values.len() {
        if i > 0 { out = cat(out.as_bytes(), fragment(" ")) }
        let point = <[u256; 2] as Decode<Sol>>::decode_from(values.encoded_span(), 32 + i * 64)
        let x = if use_precision { to_string(point[0], precision) } else { decimal(point[0]) }
        let y = if use_precision { to_string(point[1], precision) } else { decimal(point[1]) }
        out = cat(out.as_bytes(), x.as_bytes())
        out = cat(out.as_bytes(), fragment(","))
        out = cat(out.as_bytes(), y.as_bytes())
        i += 1
    }
    cat(out.as_bytes(), fragment("\""))
}
pub fn strings_equal(_ a: DynString, _ b: DynString) -> bool { keccak_packed(a.as_bytes()) == keccak_packed(b.as_bytes()) }
pub fn utf_string_length(_ value: DynString) -> u256 {
    var i = 0
    var length = 0
    while i < value.len() {
        let first = unsafe { *ptr::offset_bytes(value.payload_span().ptr(), i) }
        i += if first >> 7 == 0 { 1 } else if first >> 5 == 6 { 2 } else if first >> 4 == 14 { 3 } else if first >> 3 == 30 { 4 } else { 1 }
        length += 1
    }
    length
}
