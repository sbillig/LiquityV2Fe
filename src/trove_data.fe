// SPDX-License-Identifier: BUSL-1.1
// TroveManager storage layout and exact individual/batch debt calculations.
use core::num::IntDowncast
use std::evm::{Address, Ctx, RawStorage, SolArray, StorageMap, storage_at, storage_at_mut}
use std::evm::packed::keccak_packed
use super::constants::DECIMAL_PRECISION
use super::liquity_math as math
use super::types::{LatestTroveData, LatestBatchData}
pub const TROVES: u256 = 11
pub const BATCHES: u256 = 12
pub const TOTAL_STAKES: u256 = 13
pub const STAKES_SNAPSHOT: u256 = 14
pub const COLL_SNAPSHOT: u256 = 15
pub const L_COLL: u256 = 16
pub const L_DEBT: u256 = 17
pub const REWARDS: u256 = 18
pub const TROVE_IDS: u256 = 19
pub const BATCH_IDS: u256 = 20
pub const LAST_ZOMBIE: u256 = 21
pub const COLL_ERROR: u256 = 22
pub const DEBT_ERROR: u256 = 23
pub const SHUTDOWN: u256 = 24
pub const MASK64: u256 = 0xffffffffffffffff
pub const MASK160: u256 = 0xffffffffffffffffffffffffffffffffffffffff
pub fn map_slot(_ key: u256, _ root: u256) -> u256 { keccak_packed((key, root)) }
pub fn trove_slot(_ id: u256) -> u256 { map_slot(id, TROVES) }
pub fn batch_slot(_ manager: Address) -> u256 { map_slot(manager.word(), BATCHES) }
pub fn reward_slot(_ id: u256) -> u256 { map_slot(id, REWARDS) }

// The TroveManager storage region reinterpreted as typed places. One
// raw `storage_at` or `storage_at_mut` projection establishes the region; every
// field and entry access after that is a checked place. Entries model the
// Solidity-packed word explicitly (`packed`), as in `sorted_troves.fe`.
// `status`/`array_index`/timestamps pack into the fourth word exactly as in
// Solidity: small-integer struct fields share a slot in declaration order.
pub struct TroveEntry {
    pub debt: u256,
    pub coll: u256,
    pub stake: u256,
    pub status: u8,
    pub array_index: u64,
    pub last_debt_update: u64,
    pub last_rate_adjustment: u64,
    pub annual_rate: u256,
    // The batch manager occupies the low 160 bits; bits above are padding
    // that Solidity field writes preserve. A typed `Address` field would
    // overwrite the whole word (its storage lane is the full `u256`), so
    // this word stays explicit until Fe lanes `Address` at 160 bits.
    pub batch_word: u256,
    pub batch_shares: u256,
}
impl Copy for TroveEntry {}

pub struct BatchEntry {
    pub debt: u256,
    pub coll: u256,
    pub array_index: u64,
    pub last_debt_update: u64,
    pub last_rate_adjustment: u64,
    pub annual_rate: u256,
    pub annual_fee: u256,
    pub total_shares: u256,
}
impl Copy for BatchEntry {}

pub struct RewardSnapshot {
    pub coll: u256,
    pub debt: u256,
}
impl Copy for RewardSnapshot {}

pub struct TroveManagerLayout {
    pub active_pool: Address,
    pub default_pool: Address,
    pub price_feed: Address,
    pub trove_nft: Address,
    pub borrower_operations: Address,
    pub stability_pool: Address,
    pub gas_pool: Address,
    pub coll_surplus_pool: Address,
    pub bold_token: Address,
    pub sorted_troves: Address,
    pub collateral_registry: Address,
    pub troves: StorageMap<u256, TroveEntry>,
    pub batches: StorageMap<Address, BatchEntry>,
    pub total_stakes: u256,
    pub total_stakes_snapshot: u256,
    pub total_coll_snapshot: u256,
    pub l_coll: u256,
    pub l_bold_debt: u256,
    pub reward_snapshots: StorageMap<u256, RewardSnapshot>,
    pub trove_ids: SolArray<u256>,
    pub batch_ids: SolArray<Address>,
    pub last_zombie_trove_id: u256,
    pub last_coll_error: u256,
    pub last_debt_error: u256,
    pub shutdown_time: u256,
}
pub struct TroveRecord {
    pub debt: u256, pub coll: u256, pub stake: u256, pub status: u8,
    pub array_index: u64, pub last_debt_update: u64, pub last_rate_adjustment: u64,
    pub annual_rate: u256, pub batch_manager: Address, pub batch_shares: u256,
}
impl Copy for TroveRecord {}
pub struct BatchRecord {
    pub debt: u256, pub coll: u256, pub array_index: u64,
    pub last_debt_update: u64, pub last_rate_adjustment: u64,
    pub annual_rate: u256, pub annual_fee: u256, pub total_shares: u256,
}
impl Copy for BatchRecord {}
pub fn load_trove(_ id: u256) -> TroveRecord uses (storage: RawStorage) {
    let tm = unsafe { ref storage_at<TroveManagerLayout>(0) }
    let e = tm.troves[id]
    TroveRecord { debt: e.debt, coll: e.coll, stake: e.stake,
        status: e.status, array_index: e.array_index,
        last_debt_update: e.last_debt_update, last_rate_adjustment: e.last_rate_adjustment,
        annual_rate: e.annual_rate, batch_manager: Address::new(e.batch_word & MASK160), batch_shares: e.batch_shares }
}
pub fn load_batch(_ manager: Address) -> BatchRecord uses (storage: RawStorage) {
    let tm = unsafe { ref storage_at<TroveManagerLayout>(0) }
    let e = tm.batches[manager]
    BatchRecord { debt: e.debt, coll: e.coll, array_index: e.array_index,
        last_debt_update: e.last_debt_update, last_rate_adjustment: e.last_rate_adjustment,
        annual_rate: e.annual_rate, annual_fee: e.annual_fee, total_shares: e.total_shares }
}
pub fn interest_period(_ last: u256) -> u256 uses (ctx: Ctx, storage: RawStorage) {
    let tm = unsafe { ref storage_at<TroveManagerLayout>(0) }
    let stop = tm.shutdown_time
    if stop == 0 { ctx.timestamp() - last } else if last < stop { stop - last } else { 0 }
}
pub fn latest_batch(_ manager: Address) -> LatestBatchData uses (ctx: Ctx, storage: RawStorage) {
    let b = load_batch(manager)
    var result = LatestBatchData::zero()
    result.total_debt_shares = b.total_shares
    result.recorded_debt = b.debt
    result.annual_interest_rate = b.annual_rate
    result.weighted_recorded_debt = b.debt * b.annual_rate
    let period = interest_period(b.last_debt_update as u256)
    result.accrued_interest = math::calc_interest(result.weighted_recorded_debt, period)
    result.annual_management_fee = b.annual_fee
    result.weighted_recorded_batch_management_fee = b.debt * b.annual_fee
    result.accrued_management_fee = math::calc_interest(result.weighted_recorded_batch_management_fee, period)
    result.entire_debt_without_redistribution = result.recorded_debt + result.accrued_interest + result.accrued_management_fee
    result.entire_coll_without_redistribution = b.coll
    result.last_debt_update_time = b.last_debt_update as u256
    result.last_interest_rate_adj_time = b.last_rate_adjustment as u256
    result
}
pub fn latest_from_batch(_ id: u256, _ batch: LatestBatchData) -> LatestTroveData uses (storage: RawStorage) {
    let t = load_trove(id)
    let tm = unsafe { ref storage_at<TroveManagerLayout>(0) }
    var result = LatestTroveData::zero()
    result.redist_bold_debt_gain = t.stake * (tm.l_bold_debt - tm.reward_snapshots[id].debt) / DECIMAL_PRECISION
    result.redist_coll_gain = t.stake * (tm.l_coll - tm.reward_snapshots[id].coll) / DECIMAL_PRECISION
    if batch.total_debt_shares > 0 {
        result.recorded_debt = batch.recorded_debt * t.batch_shares / batch.total_debt_shares
        result.weighted_recorded_debt = result.recorded_debt * batch.annual_interest_rate
        result.accrued_interest = batch.accrued_interest * t.batch_shares / batch.total_debt_shares
        result.accrued_batch_management_fee = batch.accrued_management_fee * t.batch_shares / batch.total_debt_shares
    }
    result.annual_interest_rate = batch.annual_interest_rate
    result.entire_debt = result.recorded_debt + result.redist_bold_debt_gain + result.accrued_interest + result.accrued_batch_management_fee
    result.entire_coll = t.coll + result.redist_coll_gain
    result.last_interest_rate_adj_time = math::max(batch.last_interest_rate_adj_time, t.last_rate_adjustment as u256)
    result
}
pub fn latest_trove(_ id: u256) -> LatestTroveData uses (ctx: Ctx, storage: RawStorage) {
    let t = load_trove(id)
    if t.batch_manager != Address::zero() { return latest_from_batch(id, latest_batch(t.batch_manager)) }
    let tm = unsafe { ref storage_at<TroveManagerLayout>(0) }
    var result = LatestTroveData::zero()
    result.redist_bold_debt_gain = t.stake * (tm.l_bold_debt - tm.reward_snapshots[id].debt) / DECIMAL_PRECISION
    result.redist_coll_gain = t.stake * (tm.l_coll - tm.reward_snapshots[id].coll) / DECIMAL_PRECISION
    result.recorded_debt = t.debt
    result.annual_interest_rate = t.annual_rate
    result.weighted_recorded_debt = t.debt * t.annual_rate
    result.accrued_interest = math::calc_interest(result.weighted_recorded_debt, interest_period(t.last_debt_update as u256))
    result.entire_debt = result.recorded_debt + result.redist_bold_debt_gain + result.accrued_interest
    result.entire_coll = t.coll + result.redist_coll_gain
    result.last_interest_rate_adj_time = t.last_rate_adjustment as u256
    result
}
pub fn annual_rate(_ id: u256) -> u256 uses (storage: RawStorage) {
    let t = load_trove(id)
    let tm = unsafe { ref storage_at<TroveManagerLayout>(0) }
    if t.batch_manager != Address::zero() { tm.batches[t.batch_manager].annual_rate } else { t.annual_rate }
}
pub fn new_stake(_ coll: u256) -> u256 uses (storage: RawStorage) {
    let tm = unsafe { ref storage_at<TroveManagerLayout>(0) }
    if tm.total_coll_snapshot == 0 { coll } else { coll * tm.total_stakes_snapshot / tm.total_coll_snapshot }
}
pub fn update_stake(_ id: u256, _ coll: u256) -> u256 uses (storage: mut RawStorage) {
    let stake = new_stake(coll)
    let tm = unsafe { storage_at_mut<TroveManagerLayout>(0) }
    let old = tm.troves[id].stake
    tm.troves[id].stake = stake
    tm.total_stakes = tm.total_stakes - old + stake
    stake
}
pub fn update_rewards(_ id: u256) uses (storage: mut RawStorage) {
    let tm = unsafe { storage_at_mut<TroveManagerLayout>(0) }
    tm.reward_snapshots[id] = RewardSnapshot { coll: tm.l_coll, debt: tm.l_bold_debt }
}
