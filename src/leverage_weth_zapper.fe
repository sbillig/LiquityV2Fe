use std::abi::{sol, Bytes}
use std::evm::{Address, Ctx, Create, Call, Log, RawOps, RawStorage, encode_abi_payload}
use std::evm::packed::keccak_packed
use super::zapper_calls::*
use super::leverage_weth_zapper_module::LeverageWETHZapperLeverage
use super::zapper_forward::forward
use super::zapper_base::{Config, slots, initialize, remove_receiver, check_adjust}
use super::add_remove_managers as managers
use super::add_remove_managers::AddRemoveManagersMsg
use super::addresses_registry::RegistryMsg
use super::trove_nft::TroveNFTMsg
use super::token_calls::TokenMsg
use super::leftovers_sweep::{BalanceMsg, InitialBalances, snapshot, return_leftovers}
use super::revert_texts::require
use super::zapper_errors as error
use super::constants::{ETH_GAS_COMPENSATION, MAX_UINT256}
pub msg LeverageWETHZapperMsg {
    #[selector = sol("openLeveragedTroveWithRawETH((address,uint256,uint256,uint256,uint256,uint256,uint256,uint256,address,uint256,address,address,address))")]
    LeveragedOpen { p: LeveragedOpenParams },
    #[selector = sol("leverUpTrove((uint256,uint256,uint256,uint256))")]
    LeverUp { p: (u256, u256, u256, u256) },
    #[selector = sol("leverDownTrove((uint256,uint256,uint256))")]
    LeverDown { p: (u256, u256, u256) },
    #[selector = sol("leverageRatioToCollateralRatio(uint256)")]
    LeverageRatio { ratio: u256 } -> u256,

    #[selector = sol("borrowerOperations()")]
    Borrower -> Address,
    #[selector = sol("troveManager()")]
    Manager -> Address,
    #[selector = sol("WETH()")]
    Weth -> Address,
    #[selector = sol("boldToken()")]
    Bold -> Address,
    #[selector = sol("flashLoanProvider()")]
    FlashProvider -> Address,
    #[selector = sol("exchange()")]
    Exchange -> Address,
    #[selector = sol("openTroveWithRawETH((address,uint256,uint256,uint256,uint256,uint256,uint256,address,uint256,address,address,address))")]
    Open { p: OpenParams } -> u256,
    #[selector = sol("addCollWithRawETH(uint256)")]
    Add { id: u256 },
    #[selector = sol("withdrawCollToRawETH(uint256,uint256)")]
    WithdrawColl { id: u256, amount: u256 },
    #[selector = sol("withdrawBold(uint256,uint256,uint256)")]
    WithdrawBold { id: u256, amount: u256, fee: u256 },
    #[selector = sol("repayBold(uint256,uint256)")]
    Repay { id: u256, amount: u256 },
    #[selector = sol("adjustTroveWithRawETH(uint256,uint256,bool,uint256,bool,uint256)")]
    Adjust { id: u256, coll: u256, coll_increase: bool, debt: u256, debt_increase: bool, fee: u256 },
    #[selector = sol("adjustZombieTroveWithRawETH(uint256,uint256,bool,uint256,bool,uint256,uint256,uint256)")]
    AdjustZombie { id: u256, coll: u256, coll_increase: bool, debt: u256, debt_increase: bool, upper: u256, lower: u256, fee: u256 },
    #[selector = sol("closeTroveToRawETH(uint256)")]
    Close { id: u256 },
    #[selector = sol("closeTroveFromCollateral(uint256,uint256,uint256)")]
    CloseFromColl { id: u256, amount: u256, minimum: u256 },
    #[selector = sol("receiveFlashLoanOnCloseTroveFromCollateral((uint256,uint256,uint256,address),uint256)")]
    FlashClose { p: CloseParams, effective: u256 },
    #[selector = sol("receiveFlashLoanOnOpenLeveragedTrove((address,uint256,uint256,uint256,uint256,uint256,uint256,uint256,address,uint256,address,address,address),uint256)")]
    FlashOpen { p: LeveragedOpenParams, effective: u256 },
    #[selector = sol("receiveFlashLoanOnLeverUpTrove((uint256,uint256,uint256,uint256),uint256)")]
    FlashUp { p: (u256, u256, u256, u256), effective: u256 },
    #[selector = sol("receiveFlashLoanOnLeverDownTrove((uint256,uint256,uint256),uint256)")]
    FlashDown { p: (u256, u256, u256), effective: u256 },
}
fn balances(_ cfg: Config, _ receiver: Address) -> InitialBalances uses (ctx: Ctx, call: mut Call) {
    snapshot([cfg.weth, cfg.bold, Address::zero(), Address::zero()], receiver)
}
fn send_eth(_ receiver: Address, _ amount: u256) uses (ctx: Ctx, call: mut Call) {
    var out = core::ptr::MemBuffer::empty()
    let result = call.raw_call(addr: receiver, gas: ctx.gas(), value: amount, args: core::ptr::MemSpan::empty(), ret: mut out)
    require(result.success(), error::send_failed())
}
fn require_code(_ target: Address) uses (ctx: Ctx) {
    if ctx.extcodesize(target) == 0 { std::evm::revert(()) }
}
fn deposit(_ weth: Address, _ amount: u256) uses (ctx: Ctx, call: mut Call) {
    require_code(weth)
    call.call(addr: weth, gas: ctx.gas(), value: amount, message: ZapperCalls::Deposit {})
}
fn pre(_ cfg: Config, _ id: u256, _ coll: u256, _ coll_increase: bool, _ debt: u256, _ debt_increase: bool) -> (Address, InitialBalances)
uses (ctx: Ctx, call: mut Call, storage: RawStorage) {
    if coll_increase { require(coll == ctx.value(), error::wrong_coll()) }
    else { require(ctx.value() == 0, error::no_eth()) }
    let receiver = check_adjust(cfg, id, coll, coll_increase, debt_increase)
    let initial = balances(cfg, ctx.caller())
    if coll_increase { deposit(cfg.weth, coll) }
    if !debt_increase { let ignored = cfg.bold.call(TokenMsg::TransferFrom { owner: ctx.caller(), receiver: ctx.address(), amount: debt }) }
    (receiver, initial)
}
fn post(_ cfg: Config, _ coll: u256, _ coll_increase: bool, _ debt: u256, _ debt_increase: bool, _ receiver: Address, _ initial: InitialBalances)
uses (ctx: Ctx, call: mut Call) {
    if debt_increase { let ignored = cfg.bold.call(TokenMsg::Transfer { receiver, amount: debt }) }
    let current = cfg.bold.static(BalanceMsg::Balance { account: ctx.address() })
    if current > initial.balances[1] { let ignored = cfg.bold.call(TokenMsg::Transfer { receiver: initial.receiver, amount: current - initial.balances[1] }) }
    if !coll_increase && coll > 0 {
        require_code(cfg.weth)
        cfg.weth.call(ZapperCalls::Withdraw { amount: coll })
        send_eth(receiver, coll)
    }
}
pub contract LeverageWETHZapper {
    leverage_module: Address,
    cfg: Config,
    init(registry: Address, flash: Address, exchange: Address) uses (mut leverage_module, create: mut Create, mut cfg, call: mut Call, log: mut Log) {
        let config = initialize(registry, flash, exchange)
        require(config.weth == registry.static(RegistryMsg::GetcollToken {}), error::wrong_branch())
        let ignored = config.weth.call(ZapperCalls::Approve { spender: config.bo, amount: MAX_UINT256 })
        let ignored2 = config.weth.call(ZapperCalls::Approve { spender: exchange, amount: MAX_UINT256 })
        let ignored_bold = config.bold.call(ZapperCalls::Approve { spender: exchange, amount: MAX_UINT256 })
        leverage_module = create.create<LeverageWETHZapperLeverage>(value: 0, args: (config.nft, config.bo, config.manager, config.bold, config.weth, config.flash, config.exchange))
        cfg = config
    }
    recv {
        LeverageWETHZapperMsg::Borrower {} -> Address uses (cfg) { cfg.bo }
        LeverageWETHZapperMsg::Manager {} -> Address uses (cfg) { cfg.manager }
        LeverageWETHZapperMsg::Weth {} -> Address uses (cfg) { cfg.weth }
        LeverageWETHZapperMsg::Bold {} -> Address uses (cfg) { cfg.bold }
        LeverageWETHZapperMsg::FlashProvider {} -> Address uses (cfg) { cfg.flash }
        LeverageWETHZapperMsg::Exchange {} -> Address uses (cfg) { cfg.exchange }
        #[payable]
        LeverageWETHZapperMsg::Open { p } -> u256 uses (cfg, ctx: Ctx, call: mut Call, storage: mut RawStorage, log: mut Log) {
            require(ctx.value() > ETH_GAS_COMPENSATION, error::insufficient_eth())
            require(checked_address(p.batch) == Address::zero() || p.rate == 0, error::batch_rate())
            deposit(cfg.weth, ctx.value())
            let index = keccak_packed((ctx.caller().word(), p.index))
            let this = ctx.address()
            let id = if checked_address(p.batch) == Address::zero() {
                cfg.bo.call(ZapperCalls::Open { owner: checked_address(p.owner), index, coll: ctx.value() - ETH_GAS_COMPENSATION, bold: p.bold, upper: p.upper, lower: p.lower, rate: p.rate, fee: p.fee, add: this, remove: this, receiver: this })
            } else {
                cfg.bo.call(ZapperCalls::OpenBatch { p: (checked_address(p.owner), index, ctx.value() - ETH_GAS_COMPENSATION, p.bold, p.upper, p.lower, checked_address(p.batch), p.fee, this, this, this) })
            }
            let ignored = cfg.bold.call(TokenMsg::Transfer { receiver: ctx.caller(), amount: p.bold })
            managers::set_add(slots(), id, checked_address(p.add))
            managers::set_remove(slots(), id, checked_address(p.remove), checked_address(p.receiver))
            id
        }
        #[payable]
        LeverageWETHZapperMsg::Add { id } uses (cfg, ctx: Ctx, call: mut Call, storage: RawStorage) {
            let owner = cfg.nft.static(TroveNFTMsg::OwnerOf { id })
            managers::require_owner_or_add(slots(), id, owner)
            deposit(cfg.weth, ctx.value())
            require_code(cfg.bo)
            cfg.bo.call(ZapperCalls::Add { id, amount: ctx.value() })
        }
        LeverageWETHZapperMsg::WithdrawColl { id, amount } uses (cfg, ctx: Ctx, call: mut Call, storage: RawStorage) {
            let receiver = remove_receiver(cfg, id)
            require_code(cfg.bo)
            cfg.bo.call(ZapperCalls::WithdrawColl { id, amount })
            require_code(cfg.weth)
            cfg.weth.call(ZapperCalls::Withdraw { amount })
            send_eth(receiver, amount)
        }
        LeverageWETHZapperMsg::WithdrawBold { id, amount, fee } uses (cfg, ctx: Ctx, call: mut Call, storage: RawStorage) {
            let receiver = remove_receiver(cfg, id)
            require_code(cfg.bo)
            cfg.bo.call(ZapperCalls::WithdrawBold { id, amount, fee })
            let ignored = cfg.bold.call(TokenMsg::Transfer { receiver, amount })
        }
        LeverageWETHZapperMsg::Repay { id, amount } uses (cfg, ctx: Ctx, call: mut Call, storage: RawStorage) {
            let owner = cfg.nft.static(TroveNFTMsg::OwnerOf { id })
            managers::require_owner_or_add(slots(), id, owner)
            let initial = balances(cfg, ctx.caller())
            let ignored = cfg.bold.call(TokenMsg::TransferFrom { owner: ctx.caller(), receiver: ctx.address(), amount })
            require_code(cfg.bo)
            cfg.bo.call(ZapperCalls::Repay { id, amount })
            return_leftovers(initial)
        }
        #[payable]
        LeverageWETHZapperMsg::Adjust { id, coll, coll_increase, debt, debt_increase, fee } uses (cfg, ctx: Ctx, call: mut Call, storage: RawStorage) {
            let (receiver, initial) = pre(cfg, id, coll, coll_increase, debt, debt_increase)
            require_code(cfg.bo)
            cfg.bo.call(ZapperCalls::Adjust { id, coll, coll_increase, debt, debt_increase, fee })
            post(cfg, coll, coll_increase, debt, debt_increase, receiver, initial)
        }
        #[payable]
        LeverageWETHZapperMsg::AdjustZombie { id, coll, coll_increase, debt, debt_increase, upper, lower, fee } uses (cfg, ctx: Ctx, call: mut Call, storage: RawStorage) {
            let (receiver, initial) = pre(cfg, id, coll, coll_increase, debt, debt_increase)
            require_code(cfg.bo)
            cfg.bo.call(ZapperCalls::AdjustZombie { id, coll, coll_increase, debt, debt_increase, upper, lower, fee })
            post(cfg, coll, coll_increase, debt, debt_increase, receiver, initial)
        }
        LeverageWETHZapperMsg::Close { id } uses (cfg, ctx: Ctx, call: mut Call, storage: RawStorage) {
            let receiver = remove_receiver(cfg, id)
            let trove = cfg.manager.static(ZapperCalls::Trove { id })
            let ignored = cfg.bold.call(TokenMsg::TransferFrom { owner: ctx.caller(), receiver: ctx.address(), amount: trove.entire_debt })
            require_code(cfg.bo)
            cfg.bo.call(ZapperCalls::Close { id })
            let amount = trove.entire_coll + ETH_GAS_COMPENSATION
            require_code(cfg.weth)
            cfg.weth.call(ZapperCalls::Withdraw { amount })
            send_eth(receiver, amount)
        }
        LeverageWETHZapperMsg::CloseFromColl { id, amount, minimum } uses (cfg, ctx: Ctx, call: mut Call, storage: RawStorage) {
            let receiver = remove_receiver(cfg, id)
            let p = CloseParams { id, amount, minimum, receiver: AddressWord::from_address(receiver) }
            let initial = balances(cfg, receiver)
            let encoded = encode_abi_payload(p)
            require_code(cfg.flash)
            cfg.flash.call(ZapperCalls::Flash { token: cfg.weth, amount, operation: 1, data: Bytes::from_payload(source: encoded.span()) })
            return_leftovers(initial)
        }
        LeverageWETHZapperMsg::FlashClose { p, effective } uses (cfg, ctx: Ctx, call: mut Call) {
            require(ctx.caller() == cfg.flash, error::flash_caller())
            let trove = cfg.manager.static(ZapperCalls::Trove { id: p.id })
            let left = trove.entire_coll - p.amount
            require(left >= p.minimum, error::coll_minimum())
            let ignored = cfg.exchange.call(ZapperCalls::Swap { amount: effective, minimum: trove.entire_debt })
            require_code(cfg.bo)
            cfg.bo.call(ZapperCalls::Close { id: p.id })
            let ignored2 = cfg.weth.call(TokenMsg::Transfer { receiver: cfg.flash, amount: p.amount })
            let amount = left + ETH_GAS_COMPENSATION
            require_code(cfg.weth)
            cfg.weth.call(ZapperCalls::Withdraw { amount })
            send_eth(checked_address(p.receiver), amount)
        }
        #[payable]
        LeverageWETHZapperMsg::LeveragedOpen { p } uses (leverage_module, ctx: Ctx, ops: mut RawOps, call: mut Call) { forward(leverage_module) }
        LeverageWETHZapperMsg::FlashOpen { p, effective } uses (leverage_module, ctx: Ctx, ops: mut RawOps, call: mut Call) { forward(leverage_module) }
        LeverageWETHZapperMsg::LeverUp { p } uses (leverage_module, ctx: Ctx, ops: mut RawOps, call: mut Call) { forward(leverage_module) }
        LeverageWETHZapperMsg::LeverDown { p } uses (leverage_module, ctx: Ctx, ops: mut RawOps, call: mut Call) { forward(leverage_module) }
        LeverageWETHZapperMsg::FlashUp { p, effective } uses (leverage_module, ctx: Ctx, ops: mut RawOps, call: mut Call) { forward(leverage_module) }
        LeverageWETHZapperMsg::FlashDown { p, effective } uses (leverage_module, ctx: Ctx, ops: mut RawOps, call: mut Call) { forward(leverage_module) }
        LeverageWETHZapperMsg::LeverageRatio { ratio } -> u256 { ratio * 1000000000000000000 / (ratio - 1000000000000000000) }
        AddRemoveManagersMsg::AddManagerOf { id } -> Address uses ( storage: RawStorage) { managers::get_add(slots(), id) }
        AddRemoveManagersMsg::RemoveManagerReceiverOf { id } -> (Address, Address) uses ( storage: RawStorage) { managers::get_remove(slots(), id) }
        AddRemoveManagersMsg::SetAddManager { id, manager } uses (cfg, ctx: Ctx, call: mut Call, storage: mut RawStorage, log: mut Log) {
            managers::require_borrower(cfg.nft, id)
            managers::set_add(slots(), id, manager)
        }
        AddRemoveManagersMsg::SetRemoveManager { id, manager } uses (cfg, ctx: Ctx, call: mut Call, storage: mut RawStorage, log: mut Log) {
            let receiver = cfg.nft.static(TroveNFTMsg::OwnerOf { id })
            managers::require_borrower(cfg.nft, id)
            managers::set_remove(slots(), id, manager, receiver)
        }
        AddRemoveManagersMsg::SetRemoveManagerWithReceiver { id, manager, receiver } uses (cfg, ctx: Ctx, call: mut Call, storage: mut RawStorage, log: mut Log) {
            managers::require_borrower(cfg.nft, id)
            managers::set_remove(slots(), id, manager, receiver)
        }
        #[payable]
        _ uses (ops: mut RawOps) {
            if ops.calldatasize() != 0 { ops.revert(data: core::ptr::MemSpan::empty()) }
        }
    }
}
