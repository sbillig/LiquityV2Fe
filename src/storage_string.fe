// SPDX-License-Identifier: MIT
// Solidity-compatible string storage for ERC721 constructor metadata.
use std::evm::read_storage_word
use std::abi::{Bytes, DynString}
use std::evm::{RawStorage}
use std::evm::packed::keccak_packed
use super::bytes_builder::BytesBuilder

/// Initialize a fresh slot. This is not a general replacement/clearing operation.
pub fn initialize(_ slot: u256, _ value: Bytes) uses (storage: mut RawStorage) {
    let len = value.len()
    if len < 32 {
        let word = if len == 0 { 0 } else { value.word_at(0) }
        unsafe { storage.sstore(slot: slot, value: word | (len * 2)) }
    } else {
        unsafe { storage.sstore(slot: slot, value: len * 2 + 1) }
        let base = keccak_packed(slot)
        var offset: u256 = 0
        while offset < len {
            unsafe { storage.sstore(slot: base + offset / 32, value: value.word_at(offset)) }
            offset += 32
        }
    }
}

pub fn load(_ slot: u256) -> DynString uses (storage: RawStorage) {
    let head = read_storage_word(slot)
    let short = head & 1 == 0
    let len = if short { (head & 0xff) / 2 } else { head / 2 }
    var out = BytesBuilder::zeroed(((len + 31) / 32) * 32)
    if short {
        if len != 0 { out.write_word(at: 0, value: head & !(0xff as u256)) }
    } else {
        let base = keccak_packed(slot)
        var offset: u256 = 0
        while offset < len {
            out.write_word(at: offset, value: read_storage_word(base + offset / 32))
            offset += 32
        }
    }
    DynString::from_payload(source: out.span().slice(offset: 0, len))
}
