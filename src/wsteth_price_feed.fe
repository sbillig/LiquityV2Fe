use std::abi::sol
use std::evm::{Address, Ctx, Call, Log, RawStorage}
use super::price_feed_core as feeds
pub msg WSTETHPriceFeedMsg {
    #[selector = sol("priceSource()")]
    Source -> u8,
    #[selector = sol("lastGoodPrice()")]
    LastGood -> u256,
    #[selector = sol("ethUsdOracle()")]
    EthOracle -> (Address, u256, u8),
    #[selector = sol("rateProviderAddress()")]
    Provider -> Address,
    #[selector = sol("stEthUsdOracle()")]
    LstOracle -> (Address, u256, u8),
    #[selector = sol("STETH_USD_DEVIATION_THRESHOLD()")]
    Deviation -> u256,
    #[selector = sol("fetchPrice()")]
    Price -> (u256, bool),
    #[selector = sol("fetchRedemptionPrice()")]
    Redemption -> (u256, bool),
}
pub contract WSTETHPriceFeed {
    init(eth: Address, lst: Address, provider: Address, eth_threshold: u256, lst_threshold: u256, borrower: Address) uses (ctx: Ctx, storage: mut RawStorage, call: mut Call, log: mut Log) {
        feeds::init_base(eth, eth_threshold, borrower)
        storage.sstore(slot: 6, value: provider.inner)
        feeds::init_oracle(7, lst, lst_threshold)
        let _initial = feeds::composite(false, false)
        assert(feeds::source() == 0)
    }
    recv WSTETHPriceFeedMsg {
        Source -> u8 uses (storage: RawStorage) { feeds::source() }
        LastGood -> u256 uses (storage: RawStorage) { storage.sload(1) }
        EthOracle -> (Address, u256, u8) uses (storage: RawStorage) { feeds::oracle(2) }
        Provider -> Address uses (storage: RawStorage) { feeds::address_at(6) }
        LstOracle -> (Address, u256, u8) uses (storage: RawStorage) { feeds::oracle(7) }
        Deviation -> u256 { 10000000000000000 }
        Price -> (u256, bool) uses (ctx: Ctx, storage: mut RawStorage, call: mut Call, log: mut Log) { feeds::composite(false, false) }
        Redemption -> (u256, bool) uses (ctx: Ctx, storage: mut RawStorage, call: mut Call, log: mut Log) { feeds::composite(false, true) }
    }
}
