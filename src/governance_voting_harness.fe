use std::abi::{sol, DynArray}
use std::evm::{Address, Ctx, RawStorage, Call, Log, Create}
use super::governance_actions::{self as action, ActionConfig}
use super::governance_snapshots::SnapshotConfig
use super::user_proxy::UserProxy
use super::user_proxy_factory::derive
pub msg VotingMsg {
    #[selector = sol("allocateLQTY(address[],address[],int256[],int256[])")]
    Allocate { reset: DynArray<Address>, targets: DynArray<Address>, votes: DynArray<i256>, vetos: DynArray<i256> },
    #[selector = sol("resetAllocations(address[],bool)")]
    Reset { targets: DynArray<Address>, check_all: bool },
    #[selector = sol("userStates(address)")]
    User { user: Address } -> (u256, u256, u256, u256),
    #[selector = sol("registerInitiative(address)")]
    Register { target: Address },
    #[selector = sol("unregisterInitiative(address)")]
    Unregister { target: Address },
    #[selector = sol("claimForInitiative(address)")]
    Claim { target: Address } -> u256,
    #[selector = sol("deriveUserProxyAddress(address)")]
    Derive { user: Address } -> Address,
}
use super::governance_voting as voting
use super::governance_allocation::read_user
pub contract GovernanceVotingHarness {
    cfg: ActionConfig,
    init(bold: Address, staking: Address, fee: u256, factor: u256) uses (mut cfg, create: mut Create, storage: mut RawStorage) {
        let implementation = create.create<UserProxy>(value: 0, args: (Address { inner: 1 }, Address { inner: 2 }, staking))
        cfg = ActionConfig { snapshots: SnapshotConfig { bold, start: 1000, duration: 100, min_claim: 1000000000000000000, min_accrual: 5000000000000000000, voting_factor: 10000000000000000, unregister_factor: 2000000000000000000, unregister_epochs: 4 }, implementation, staking, fee, factor }
        unsafe { storage.sstore(slot: 0, value: 1) }
    }
    recv VotingMsg {
        User { user } -> (u256, u256, u256, u256) uses ( storage: RawStorage) { read_user(user) }
        Allocate { reset, targets, votes, vetos } uses (cfg, ctx: Ctx, storage: mut RawStorage, call: mut Call, log: mut Log) { voting::allocate(cfg, 90, reset, targets, votes, vetos) }
        Reset { targets, check_all } uses (cfg, ctx: Ctx, storage: mut RawStorage, call: mut Call, log: mut Log) { voting::reset(cfg, targets, check_all) }
        Register { target } uses (cfg, ctx: Ctx, storage: mut RawStorage, call: mut Call, log: mut Log) { action::register(cfg, target) }
        Unregister { target } uses (cfg, ctx: Ctx, storage: mut RawStorage, call: mut Call, log: mut Log) { action::unregister(cfg.snapshots, target) }
        Claim { target } -> u256 uses (cfg, ctx: Ctx, storage: mut RawStorage, call: mut Call, log: mut Log) { action::claim(cfg.snapshots, target) }
        Derive { user } -> Address uses (cfg, ctx: Ctx) { derive(cfg.implementation, user) }
    }
}
