// SPDX-License-Identifier: MIT
use std::abi::{DynString, Bytes4}
use std::evm::{Address, Call}
use std::evm::packed::keccak_packed
use super::metadata_string::{cat, fragment, text, decimal, checksum, slice, locale}
use super::metadata_svg as svg
use super::metadata_literals as lit
use super::fixed_asset_reader::FixedAssetReaderMsg
pub const GEIST: String<31> = "style=\"font-family: Geist\" "
pub const DARK_BLUE: String<7> = "#121B44"
pub const STOIC_WHITE: String<7> = "#DEE4FB"
#[inline(never)]
pub fn svg_props() -> DynString {
    let out = cat(svg::prop_2(text(fragment("width")), text(fragment("300"))).as_bytes(), svg::prop_2(text(fragment("height")), text(fragment("484"))).as_bytes())
    let out = cat(out.as_bytes(), svg::prop_2(text(fragment("viewBox")), text(fragment("0 0 300 484"))).as_bytes())
    cat(out.as_bytes(), svg::prop_2(text(fragment("style")), text(fragment("background:none"))).as_bytes())
}
#[inline(never)]
fn asset(_ reader: Address, _ name: DynString) -> DynString uses (call: mut Call) {
    reader.static(FixedAssetReaderMsg::ReadAsset { sig: Bytes4 { val: keccak_packed(name.as_bytes()) >> 224 } })
}
#[inline(never)]
pub fn leverage_logo() -> DynString { lit::leverage_logo() }
#[inline(never)]
pub fn static_text_els() -> DynString { lit::static_text() }
#[inline(never)]
pub fn bold_logo(_ reader: Address) -> DynString uses (call: mut Call) {
    cat(cat(lit::bold_logo_open().as_bytes(), asset(reader, text(fragment("BOLD"))).as_bytes()).as_bytes(), lit::image_close().as_bytes())
}
#[inline(never)]
pub fn coll_logo(_ name: DynString, _ reader: Address) -> DynString uses (call: mut Call) {
    cat(cat(lit::coll_logo_open().as_bytes(), asset(reader, name).as_bytes()).as_bytes(), lit::image_close().as_bytes())
}
#[inline(never)]
pub fn base_elements(_ reader: Address) -> DynString uses (call: mut Call) {
    let font = asset(reader, text(fragment("geist")))
    let out = cat(lit::background().as_bytes(), lit::font_open().as_bytes())
    let out = cat(out.as_bytes(), font.as_bytes())
    let out = cat(out.as_bytes(), lit::font_close().as_bytes())
    let out = cat(out.as_bytes(), leverage_logo().as_bytes())
    let out = cat(out.as_bytes(), bold_logo(reader).as_bytes())
    cat(out.as_bytes(), static_text_els().as_bytes())
}
#[inline(never)]
pub fn formatted_dynamic_el(_ value: DynString, _ x: u256, _ y: u256) -> DynString {
    let out = cat(fragment(GEIST), svg::prop_2(text(fragment("text-anchor")), text(fragment("end"))).as_bytes())
    let out = cat(out.as_bytes(), svg::prop_2(text(fragment("x")), decimal(x)).as_bytes())
    let out = cat(out.as_bytes(), svg::prop_2(text(fragment("y")), decimal(y)).as_bytes())
    let out = cat(out.as_bytes(), svg::prop_2(text(fragment("font-size")), text(fragment("20"))).as_bytes())
    let out = cat(out.as_bytes(), svg::prop_2(text(fragment("fill")), text(fragment("white"))).as_bytes())
    svg::text_2(out, value)
}
#[inline(never)]
pub fn formatted_id_el(_ id: DynString) -> DynString {
    cat(cat(lit::id_open().as_bytes(), id.as_bytes()).as_bytes(), fragment("</text>"))
}
#[inline(never)]
pub fn formatted_address_el(_ address: Address) -> DynString {
    let full = checksum(address)
    let short = cat(cat(slice(full, 0, 6).as_bytes(), fragment("...")).as_bytes(), slice(full, 38, 42).as_bytes())
    cat(cat(lit::owner_open().as_bytes(), short.as_bytes()).as_bytes(), fragment("</text>"))
}
#[inline(never)]
pub fn status_el(_ status: DynString) -> DynString {
    cat(cat(lit::status_open().as_bytes(), status.as_bytes()).as_bytes(), fragment("</text>"))
}
#[inline(never)]
pub fn dynamic_text_els(_ debt: u256, _ coll: u256, _ interest: u256) -> DynString {
    let out = formatted_dynamic_el(locale(coll, 18, 4), 256, 360)
    let out = cat(out.as_bytes(), formatted_dynamic_el(locale(debt, 18, 2), 256, 391).as_bytes())
    cat(out.as_bytes(), formatted_dynamic_el(locale(interest, 16, 2), 256, 422).as_bytes())
}
