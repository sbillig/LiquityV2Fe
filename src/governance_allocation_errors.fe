    mem.mstore(addr: core::ptr::offset_bytes(p, 0), value: 0x476f7665726e616e63653a20696e73756666696369656e742d6f722d616c6c6f)
    mem.mstore(addr: core::ptr::offset_bytes(p, 32), value: 0x63617465642d6c71747900000000000000000000000000000000000000000000)
    DynString::from_payload(source: core::ptr::MemSpan::from_raw_parts(ptr: p, len: 42))
}
