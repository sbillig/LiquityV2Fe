use std::abi::DynString
use std::evm::RawMem
pub fn active() -> DynString uses (mem: mut RawMem) {
    let p = core::ptr::alloc_bytes(32)
    mem.mstore(addr: core::ptr::offset_bytes(p, 0), value: 0x476f7665726e616e63653a206163746976652d766f74652d66736d0000000000)
    DynString::from_payload(source: core::ptr::MemSpan::from_raw_parts(ptr: p, len: 27))
}
pub fn withdrawal() -> DynString uses (mem: mut RawMem) {
    let p = core::ptr::alloc_bytes(32)
    mem.mstore(addr: core::ptr::offset_bytes(p, 0), value: 0x4d7573742062652061207769746864726177616c000000000000000000000000)
    DynString::from_payload(source: core::ptr::MemSpan::from_raw_parts(ptr: p, len: 20))
}
