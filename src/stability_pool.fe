// SPDX-License-Identifier: BUSL-1.1
// StabilityPool.sol: exact P/S/B accounting, scale transitions and depositor flows.
use core::num::IntDowncast
use std::abi::{sol, DynString}
use std::evm::{Address, Call, Ctx, Log, RawMem, RawStorage}
use std::evm::packed::keccak_packed
use super::addresses_registry::{RegistryMsg, ActivePoolAddressChanged, DefaultPoolAddressChanged, PriceFeedAddressChanged, TroveManagerAddressChanged, BoldTokenAddressChanged}
use super::active_pool::ActivePoolMsg
use super::bold_token::BoldTokenMsg
use super::liquity_base::{entire_coll, entire_debt}
use super::liquity_math as math
use super::token_calls::safe_transfer
use super::revert_texts as text
use super::constants::MIN_BOLD_IN_SP
const P_PRECISION: u256 = 1000000000000000000000000000000000000
const SCALE_FACTOR: u256 = 1000000000
const MAX_SCALE_FACTOR_EXPONENT: u256 = 8
const SCALE_SPAN: u256 = 2
// Solidity layout: inherited pool addresses 0..2; coll/total/owed/pending 3..6;
// deposits/snapshots/stash maps 7..9; P/scale 10..11; S/B maps 12..13.
fn map_slot(_ key: u256, _ root: u256) -> u256 uses (mem: mut RawMem) { keccak_packed((key, root)) }
fn deposit(_ user: Address) -> u256 uses (mem: mut RawMem, storage: RawStorage) { storage.sload(map_slot(user.inner, 7)) }
fn stash(_ user: Address) -> u256 uses (mem: mut RawMem, storage: RawStorage) { storage.sload(map_slot(user.inner, 9)) }
fn sum(_ scale: u256, _ root: u256) -> u256 uses (mem: mut RawMem, storage: RawStorage) { storage.sload(map_slot(scale, root)) }
fn scale_power(_ exponent: u256) -> u256 {
    let mut output: u256 = 1
    let mut i: u256 = 0
    while i < exponent { output *= SCALE_FACTOR
        i += 1
    }
    output
}
fn normalized_gain(_ snapshot: u256, _ root: u256, _ snapshot_sum: u256) -> u256 uses (mem: mut RawMem, storage: RawStorage) {
    let scale = storage.sload(snapshot + 3)
    let mut result = sum(scale, root) - storage.sload(snapshot + snapshot_sum)
    let mut i: u256 = 1
    while i <= SCALE_SPAN { result += sum(scale + i, root) / scale_power(i)
        i += 1
    }
    result
}
fn gain(_ user: Address, _ root: u256, _ snapshot_sum: u256, _ cap_slot: u256) -> u256 uses (mem: mut RawMem, storage: RawStorage) {
    let initial = deposit(user)
    if initial == 0 { return 0 }
    let snapshot = map_slot(user.inner, 8)
    let normalized = normalized_gain(snapshot, root, snapshot_sum)
    math::min(initial * normalized / storage.sload(snapshot + 1), storage.sload(cap_slot))
}
fn coll_gain(_ user: Address) -> u256 uses (mem: mut RawMem, storage: RawStorage) { gain(user, 12, 0, 3) }
fn yield_gain(_ user: Address) -> u256 uses (mem: mut RawMem, storage: RawStorage) { gain(user, 13, 2, 5) }
fn compounded(_ user: Address) -> u256 uses (mem: mut RawMem, storage: RawStorage) {
    let initial = deposit(user)
    if initial == 0 { return 0 }
    let snapshot = map_slot(user.inner, 8)
    let diff = storage.sload(11) - storage.sload(snapshot + 3)
    if diff > MAX_SCALE_FACTOR_EXPONENT { return 0 }
    initial * storage.sload(10) / storage.sload(snapshot + 1) / scale_power(diff)
}
fn yield_with_pending(_ user: Address) -> u256 uses (mem: mut RawMem, storage: RawStorage, call: mut Call) {
    if storage.sload(4) < MIN_BOLD_IN_SP { return 0 }
    let initial = deposit(user)
    if initial == 0 { return 0 }
    let snapshot = map_slot(user.inner, 8)
    let mut owed = storage.sload(5)
    let mut normalized = normalized_gain(snapshot, 13, 2)
    let active = Address { inner: storage.sload(0) }
    let pending = active.static(ActivePoolMsg::PendingSPYield {})
    owed += pending
    let scale = storage.sload(11)
    let snapshot_scale = storage.sload(snapshot + 3)
    if scale <= snapshot_scale + SCALE_SPAN {
        normalized += storage.sload(10) * pending / storage.sload(4) / scale_power(scale - snapshot_scale)
    }
    math::min(initial * normalized / storage.sload(snapshot + 1), owed)
}
#[event]
pub struct StabilityPoolCollBalanceUpdated { pub value: u256 }
#[event]
pub struct StabilityPoolBoldBalanceUpdated { pub value: u256 }
#[event]
pub struct P_Updated { pub value: u256 }
#[event]
pub struct S_Updated { pub value: u256, pub scale: u256 }
#[event]
pub struct B_Updated { pub value: u256, pub scale: u256 }
#[event]
pub struct ScaleUpdated { pub value: u256 }
#[event]
pub struct DepositUpdated {
    #[indexed]
    pub user: Address,
    pub deposit: u256, pub stash: u256, pub p: u256, pub s: u256, pub b: u256, pub scale: u256,
}
#[event]
pub struct DepositOperation {
    #[indexed]
    pub user: Address,
    pub operation: u8, pub loss: u256, pub change: i256,
    pub yield_gain: u256, pub yield_claimed: u256, pub coll_gain: u256, pub coll_claimed: u256,
}
fn update_yield(_ amount: u256) uses (mem: mut RawMem, storage: mut RawStorage, log: mut Log) {
    let accumulated = storage.sload(6) + amount
    if accumulated == 0 { return }
    let total = storage.sload(4)
    if total < MIN_BOLD_IN_SP { storage.sstore(slot: 6, value: accumulated)
        return
    }
    storage.sstore(slot: 5, value: storage.sload(5) + accumulated)
    storage.sstore(slot: 6, value: 0)
    let scale = storage.sload(11)
    let slot = map_slot(scale, 13)
    let value = storage.sload(slot) + storage.sload(10) * accumulated / total
    storage.sstore(slot: slot, value: value)
    log.emit(B_Updated { value, scale })
}
fn update_total(_ increase: u256, _ decrease: u256) -> u256 uses (storage: mut RawStorage, log: mut Log) {
    let total = storage.sload(4)
    if increase == 0 && decrease == 0 { return total }
    let value = total + increase - decrease
    storage.sstore(slot: 4, value: value)
    log.emit(StabilityPoolBoldBalanceUpdated { value })
    value
}
fn decrease_owed(_ amount: u256) uses (storage: mut RawStorage) {
    if amount == 0 { return }
    storage.sstore(slot: 5, value: storage.sload(5) - amount)
}
fn update_deposit(_ user: Address, _ amount: u256, _ stashed: u256) uses (mem: mut RawMem, storage: mut RawStorage, log: mut Log) {
    storage.sstore(slot: map_slot(user.inner, 7), value: amount)
    storage.sstore(slot: map_slot(user.inner, 9), value: stashed)
    let snapshot = map_slot(user.inner, 8)
    if amount == 0 {
        storage.sstore(slot: snapshot, value: 0)
        storage.sstore(slot: snapshot + 1, value: 0)
        storage.sstore(slot: snapshot + 2, value: 0)
        storage.sstore(slot: snapshot + 3, value: 0)
        log.emit(DepositUpdated { user, deposit: 0, stash: stashed, p: 0, s: 0, b: 0, scale: 0 })
        return
    }
    let scale = storage.sload(11)
    let p = storage.sload(10)
    let s = sum(scale, 12)
    let b = sum(scale, 13)
    storage.sstore(slot: snapshot + 1, value: p)
    storage.sstore(slot: snapshot, value: s)
    storage.sstore(slot: snapshot + 2, value: b)
    storage.sstore(slot: snapshot + 3, value: scale)
    log.emit(DepositUpdated { user, deposit: amount, stash: stashed, p, s, b, scale })
}
fn send_bold(_ token: Address, _ user: Address, _ amount: u256) uses (ctx: Ctx, call: mut Call) {
    if amount == 0 { return }
    token.call(BoldTokenMsg::ReturnFromPool { pool: ctx.address(), receiver: user, amount })
}
fn send_coll(_ token: Address, _ amount: u256) uses (ctx: Ctx, call: mut Call, mem: mut RawMem, storage: mut RawStorage, log: mut Log) {
    if amount == 0 { return }
    let value = storage.sload(3) - amount
    storage.sstore(slot: 3, value: value)
    log.emit(StabilityPoolCollBalanceUpdated { value })
    safe_transfer(token, ctx.caller(), amount)
}
fn provide(_ bold: Address, _ coll: Address, _ amount: u256, _ claim: bool) uses (ctx: Ctx, call: mut Call, mem: mut RawMem, storage: mut RawStorage, log: mut Log) {
    text::require(amount > 0, text::stability_nonzero())
    Address { inner: storage.sload(0) }.call(ActivePoolMsg::MintAggInterest {})
    let user = ctx.caller()
    let initial = deposit(user)
    let coll_reward = coll_gain(user)
    let yield_reward = yield_gain(user)
    let compounded_deposit = compounded(user)
    let kept = if claim { 0 } else { yield_reward }
    let sent = if claim { yield_reward } else { 0 }
    let amount_new = compounded_deposit + amount + kept
    let coll_total = stash(user) + coll_reward
    let stashed = if claim { 0 } else { coll_total }
    let coll_sent = if claim { coll_total } else { 0 }
    log.emit(DepositOperation { user, operation: 0, loss: initial - compounded_deposit, change: amount.downcast_truncate(), yield_gain: yield_reward, yield_claimed: sent, coll_gain: coll_reward, coll_claimed: coll_sent })
    update_deposit(user, amount_new, stashed)
    bold.call(BoldTokenMsg::SendToPool { sender: user, pool: ctx.address(), amount })
    update_total(amount + kept, 0)
    decrease_owed(yield_reward)
    send_bold(bold, user, sent)
    send_coll(coll, coll_sent)
    update_yield(0)
}
fn withdraw(_ bold: Address, _ coll: Address, _ amount: u256, _ claim: bool) uses (ctx: Ctx, call: mut Call, mem: mut RawMem, storage: mut RawStorage, log: mut Log) {
    let user = ctx.caller()
    let initial = deposit(user)
    text::require(initial > 0, text::stability_has_deposit())
    Address { inner: storage.sload(0) }.call(ActivePoolMsg::MintAggInterest {})
    let coll_reward = coll_gain(user)
    let yield_reward = yield_gain(user)
    let compounded_deposit = compounded(user)
    let withdrawn = math::min(amount, compounded_deposit)
    let kept = if claim { 0 } else { yield_reward }
    let sent = if claim { yield_reward } else { 0 }
    let amount_new = compounded_deposit - withdrawn + kept
    let coll_total = stash(user) + coll_reward
    let stashed = if claim { 0 } else { coll_total }
    let coll_sent = if claim { coll_total } else { 0 }
    let signed_withdrawal: i256 = withdrawn.downcast_truncate()
    log.emit(DepositOperation { user, operation: 1, loss: initial - compounded_deposit, change: -signed_withdrawal, yield_gain: yield_reward, yield_claimed: sent, coll_gain: coll_reward, coll_claimed: coll_sent })
    update_deposit(user, amount_new, stashed)
    decrease_owed(yield_reward)
    let new_total = update_total(kept, withdrawn)
    send_bold(bold, user, withdrawn + sent)
    send_coll(coll, coll_sent)
    text::require(new_total >= MIN_BOLD_IN_SP, text::stability_minimum())
}
fn claim_coll(_ coll: Address) uses (ctx: Ctx, call: mut Call, mem: mut RawMem, storage: mut RawStorage, log: mut Log) {
    let user = ctx.caller()
    text::require(deposit(user) == 0, text::stability_no_deposit())
    Address { inner: storage.sload(0) }.call(ActivePoolMsg::MintAggInterest {})
    let amount = stash(user)
    text::require(amount > 0, text::stability_nonzero())
    storage.sstore(slot: map_slot(user.inner, 9), value: 0)
    log.emit(DepositOperation { user, operation: 2, loss: 0, change: 0, yield_gain: 0, yield_claimed: 0, coll_gain: 0, coll_claimed: amount })
    log.emit(DepositUpdated { user, deposit: 0, stash: 0, p: 0, s: 0, b: 0, scale: 0 })
    send_coll(coll, amount)
}
fn offset(_ bold: Address, _ debt: u256, _ coll: u256) uses (ctx: Ctx, call: mut Call, mem: mut RawMem, storage: mut RawStorage, log: mut Log) {
    let scale = storage.sload(11)
    let slot = map_slot(scale, 12)
    let value = storage.sload(slot) + storage.sload(10) * coll / storage.sload(4)
    storage.sstore(slot: slot, value: value)
    log.emit(S_Updated { value, scale })
    let mut numerator = storage.sload(10) * (storage.sload(4) - debt)
    let mut new_p = numerator / storage.sload(4)
    text::require(new_p > 0, text::stability_nonzero_p())
    while new_p < P_PRECISION / SCALE_FACTOR {
        numerator *= SCALE_FACTOR
        new_p = numerator / storage.sload(4)
        let value = storage.sload(11) + 1
        storage.sstore(slot: 11, value: value)
        log.emit(ScaleUpdated { value })
    }
    log.emit(P_Updated { value: new_p })
    storage.sstore(slot: 10, value: new_p)
    update_total(0, debt)
    bold.call(BoldTokenMsg::Burn { account: ctx.address(), amount: debt })
    let new_coll = storage.sload(3) + coll
    storage.sstore(slot: 3, value: new_coll)
    Address { inner: storage.sload(0) }.call(ActivePoolMsg::SendColl { account: ctx.address(), amount: coll })
    log.emit(StabilityPoolCollBalanceUpdated { value: new_coll })
}

pub msg StabilityPoolMsg {
    #[selector = sol("NAME()")]
    Name -> DynString,
    #[selector = sol("collToken()")]
    CollToken -> Address,
    #[selector = sol("troveManager()")]
    TroveManager -> Address,
    #[selector = sol("boldToken()")]
    BoldToken -> Address,
    #[selector = sol("activePool()")]
    ActivePool -> Address,
    #[selector = sol("getCollBalance()")]
    CollBalance -> u256,
    #[selector = sol("getTotalBoldDeposits()")]
    TotalBoldDeposits -> u256,
    #[selector = sol("getYieldGainsOwed()")]
    YieldGainsOwed -> u256,
    #[selector = sol("getYieldGainsPending()")]
    YieldGainsPending -> u256,
    #[selector = sol("P()")]
    Product -> u256,
    #[selector = sol("currentScale()")]
    CurrentScale -> u256,
    #[selector = sol("P_PRECISION()")]
    PPrecision -> u256,
    #[selector = sol("SCALE_FACTOR()")]
    ScaleFactor -> u256,
    #[selector = sol("MAX_SCALE_FACTOR_EXPONENT()")]
    MaxScaleFactorExponent -> u256,
    #[selector = sol("SCALE_SPAN()")]
    ScaleSpan -> u256,
    #[selector = sol("getEntireBranchColl()")]
    EntireBranchColl -> u256,
    #[selector = sol("getEntireBranchDebt()")]
    EntireBranchDebt -> u256,
    #[selector = sol("deposits(address)")]
    Deposits { user: Address } -> u256,
    #[selector = sol("stashedColl(address)")]
    StashedColl { user: Address } -> u256,
    #[selector = sol("getDepositorCollGain(address)")]
    DepositorCollGain { user: Address } -> u256,
    #[selector = sol("getDepositorYieldGain(address)")]
    DepositorYieldGain { user: Address } -> u256,
    #[selector = sol("getCompoundedBoldDeposit(address)")]
    CompoundedBoldDeposit { user: Address } -> u256,
    #[selector = sol("getDepositorYieldGainWithPending(address)")]
    DepositorYieldGainWithPending { user: Address } -> u256,
    #[selector = sol("depositSnapshots(address)")]
    DepositSnapshots { user: Address } -> (u256, u256, u256, u256),
    #[selector = sol("scaleToS(uint256)")]
    ScaleToS { scale: u256 } -> u256,
    #[selector = sol("scaleToB(uint256)")]
    ScaleToB { scale: u256 } -> u256,
    #[selector = sol("provideToSP(uint256,bool)")]
    Provide { amount: u256, claim: bool },
    #[selector = sol("withdrawFromSP(uint256,bool)")]
    Withdraw { amount: u256, claim: bool },
    #[selector = sol("claimAllCollGains()")]
    Claim {  },
    #[selector = sol("triggerBoldRewards(uint256)")]
    TriggerRewards { amount: u256 },
    #[selector = sol("offset(uint256,uint256)")]
    Offset { debt: u256, amount: u256 },
}
pub contract StabilityPool {
    coll: Address,
    manager: Address,
    bold: Address,
    init(registry: Address) uses (mut coll, mut manager, mut bold, storage: mut RawStorage, call: mut Call, log: mut Log) {
        let active = registry.static(RegistryMsg::GetactivePool {})
        storage.sstore(slot: 0, value: active.inner)
        let default = registry.static(RegistryMsg::GetdefaultPool {})
        storage.sstore(slot: 1, value: default.inner)
        let feed = registry.static(RegistryMsg::GetpriceFeed {})
        storage.sstore(slot: 2, value: feed.inner)
        log.emit(ActivePoolAddressChanged { value: active })
        log.emit(DefaultPoolAddressChanged { value: default })
        log.emit(PriceFeedAddressChanged { value: feed })
        storage.sstore(slot: 10, value: P_PRECISION)
        coll = registry.static(RegistryMsg::GetcollToken {})
        manager = registry.static(RegistryMsg::GettroveManager {})
        bold = registry.static(RegistryMsg::GetboldToken {})
        log.emit(TroveManagerAddressChanged { value: manager })
        log.emit(BoldTokenAddressChanged { value: bold })
    }
    recv StabilityPoolMsg {
        Name -> DynString uses (mem: mut RawMem) { text::stability_name() }
        CollToken -> Address uses (coll) { coll }
        TroveManager -> Address uses (manager) { manager }
        BoldToken -> Address uses (bold) { bold }
        ActivePool -> Address uses (storage: RawStorage) { Address { inner: storage.sload(0) } }
        CollBalance -> u256 uses (storage: RawStorage) { storage.sload(3) }
        TotalBoldDeposits -> u256 uses (storage: RawStorage) { storage.sload(4) }
        YieldGainsOwed -> u256 uses (storage: RawStorage) { storage.sload(5) }
        YieldGainsPending -> u256 uses (storage: RawStorage) { storage.sload(6) }
        Product -> u256 uses (storage: RawStorage) { storage.sload(10) }
        CurrentScale -> u256 uses (storage: RawStorage) { storage.sload(11) }
        PPrecision -> u256  { P_PRECISION }
        ScaleFactor -> u256  { SCALE_FACTOR }
        MaxScaleFactorExponent -> u256  { MAX_SCALE_FACTOR_EXPONENT }
        ScaleSpan -> u256  { SCALE_SPAN }
        EntireBranchColl -> u256 uses (storage: RawStorage, call: mut Call) { entire_coll(Address { inner: storage.sload(0) }, Address { inner: storage.sload(1) }) }
        EntireBranchDebt -> u256 uses (storage: RawStorage, call: mut Call) { entire_debt(Address { inner: storage.sload(0) }, Address { inner: storage.sload(1) }) }
        Deposits { user } -> u256 uses (mem: mut RawMem, storage: RawStorage) { deposit(user) }
        StashedColl { user } -> u256 uses (mem: mut RawMem, storage: RawStorage) { stash(user) }
        DepositorCollGain { user } -> u256 uses (mem: mut RawMem, storage: RawStorage) { coll_gain(user) }
        DepositorYieldGain { user } -> u256 uses (mem: mut RawMem, storage: RawStorage) { yield_gain(user) }
        CompoundedBoldDeposit { user } -> u256 uses (mem: mut RawMem, storage: RawStorage) { compounded(user) }
        DepositorYieldGainWithPending { user } -> u256 uses (mem: mut RawMem, storage: RawStorage, call: mut Call) { yield_with_pending(user) }
        DepositSnapshots { user } -> (u256, u256, u256, u256) uses (mem: mut RawMem, storage: RawStorage) { let slot = map_slot(user.inner, 8)
            (storage.sload(slot), storage.sload(slot + 1), storage.sload(slot + 2), storage.sload(slot + 3)) }
        ScaleToS { scale } -> u256 uses (mem: mut RawMem, storage: RawStorage) { sum(scale, 12) }
        ScaleToB { scale } -> u256 uses (mem: mut RawMem, storage: RawStorage) { sum(scale, 13) }
        Provide { amount, claim } uses (bold, coll, ctx: Ctx, call: mut Call, mem: mut RawMem, storage: mut RawStorage, log: mut Log) { provide(bold, coll, amount, claim) }
        Withdraw { amount, claim } uses (bold, coll, ctx: Ctx, call: mut Call, mem: mut RawMem, storage: mut RawStorage, log: mut Log) { withdraw(bold, coll, amount, claim) }
        Claim { } uses (coll, ctx: Ctx, call: mut Call, mem: mut RawMem, storage: mut RawStorage, log: mut Log) { claim_coll(coll) }
        TriggerRewards { amount } uses (ctx: Ctx, mem: mut RawMem, storage: mut RawStorage, log: mut Log) {
            text::require(ctx.caller().inner == storage.sload(0), text::stability_active_only())
            update_yield(amount)
        }
        Offset { debt, amount } uses (bold, manager, ctx: Ctx, call: mut Call, mem: mut RawMem, storage: mut RawStorage, log: mut Log) {
            text::require(ctx.caller() == manager, text::stability_manager_only())
            offset(bold, debt, amount)
        }
    }
}
