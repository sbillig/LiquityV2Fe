// SPDX-License-Identifier: BUSL-1.1
// StabilityPool.sol: exact P/S/B accounting, scale transitions and depositor flows.
// Storage fields are declared in Solidity order, so default numbering already
// reproduces the reference layout (addresses 0..2, balances 3..6, maps 7..9,
// P/scale 10..11, S/B maps 12..13) with no #[slot] annotations.
use core::num::IntDowncast
use std::abi::{sol, DynString}
use std::evm::{Address, Call, Ctx, Log, StorageMap}
use super::addresses_registry::{RegistryMsg, ActivePoolAddressChanged, DefaultPoolAddressChanged, PriceFeedAddressChanged, TroveManagerAddressChanged, BoldTokenAddressChanged}
use super::active_pool::ActivePoolMsg
use super::bold_token::BoldTokenMsg
use super::liquity_base::{entire_coll, entire_debt}
use super::liquity_math as math
use super::token_calls::safe_transfer
use super::revert_texts as text
use super::constants::MIN_BOLD_IN_SP
const P_PRECISION: u256 = 1000000000000000000000000000000000000
const SCALE_FACTOR: u256 = 1000000000
const MAX_SCALE_FACTOR_EXPONENT: u256 = 8
const SCALE_SPAN: u256 = 2

pub struct Snapshot {
    pub s: u256,
    pub p: u256,
    pub b: u256,
    pub scale: u256,
}
impl Copy for Snapshot {}

fn deposit(_ user: Address) -> u256 uses (deposits: StorageMap<Address, u256>) { deposits[user] }
fn stash(_ user: Address) -> u256 uses (stashed_coll: StorageMap<Address, u256>) { stashed_coll[user] }
fn s_sum(_ scale: u256) -> u256 uses (scale_s: StorageMap<u256, u256>) { scale_s[scale] }
fn b_sum(_ scale: u256) -> u256 uses (scale_b: StorageMap<u256, u256>) { scale_b[scale] }
fn scale_power(_ exponent: u256) -> u256 {
    var output: u256 = 1
    var i: u256 = 0
    while i < exponent { output *= SCALE_FACTOR
        i += 1
    }
    output
}
fn normalized_gain(_ snap: Snapshot, _ is_yield: bool) -> u256 uses (scale_s: StorageMap<u256, u256>, scale_b: StorageMap<u256, u256>) {
    var result = if is_yield { b_sum(snap.scale) - snap.b } else { s_sum(snap.scale) - snap.s }
    var i: u256 = 1
    while i <= SCALE_SPAN { result += (if is_yield { b_sum(snap.scale + i) } else { s_sum(snap.scale + i) }) / scale_power(i)
        i += 1
    }
    result
}
fn gain(_ user: Address, _ is_yield: bool) -> u256 uses (deposits: StorageMap<Address, u256>, snapshots: StorageMap<Address, Snapshot>, scale_s: StorageMap<u256, u256>, scale_b: StorageMap<u256, u256>, coll_balance: u256, yield_owed: u256) {
    let initial = deposit(user)
    if initial == 0 { return 0 }
    let snap = snapshots[user]
    let cap = if is_yield { yield_owed } else { coll_balance }
    math::min(initial * normalized_gain(snap, is_yield) / snap.p, cap)
}
fn coll_gain(_ user: Address) -> u256 uses (deposits: StorageMap<Address, u256>, snapshots: StorageMap<Address, Snapshot>, scale_s: StorageMap<u256, u256>, scale_b: StorageMap<u256, u256>, coll_balance: u256, yield_owed: u256) { gain(user, false) }
fn yield_gain(_ user: Address) -> u256 uses (deposits: StorageMap<Address, u256>, snapshots: StorageMap<Address, Snapshot>, scale_s: StorageMap<u256, u256>, scale_b: StorageMap<u256, u256>, coll_balance: u256, yield_owed: u256) { gain(user, true) }
fn compounded(_ user: Address) -> u256 uses (deposits: StorageMap<Address, u256>, snapshots: StorageMap<Address, Snapshot>, product: u256, current_scale: u256) {
    let initial = deposit(user)
    if initial == 0 { return 0 }
    let snap = snapshots[user]
    let diff = current_scale - snap.scale
    if diff > MAX_SCALE_FACTOR_EXPONENT { return 0 }
    initial * product / snap.p / scale_power(diff)
}
fn yield_with_pending(_ user: Address) -> u256 uses (active_pool: Address, total_bold: u256, yield_owed: u256, deposits: StorageMap<Address, u256>, snapshots: StorageMap<Address, Snapshot>, scale_s: StorageMap<u256, u256>, scale_b: StorageMap<u256, u256>, coll_balance: u256, product: u256, current_scale: u256, call: mut Call) {
    if total_bold < MIN_BOLD_IN_SP { return 0 }
    let initial = deposit(user)
    if initial == 0 { return 0 }
    let snap = snapshots[user]
    var owed = yield_owed
    var normalized = normalized_gain(snap, true)
    let pending = active_pool.static(ActivePoolMsg::PendingSPYield {})
    owed += pending
    if current_scale <= snap.scale + SCALE_SPAN {
        normalized += product * pending / total_bold / scale_power(current_scale - snap.scale)
    }
    math::min(initial * normalized / snap.p, owed)
}
#[event]
pub struct StabilityPoolCollBalanceUpdated { pub value: u256 }
#[event]
pub struct StabilityPoolBoldBalanceUpdated { pub value: u256 }
#[event]
pub struct P_Updated { pub value: u256 }
#[event]
pub struct S_Updated { pub value: u256, pub scale: u256 }
#[event]
pub struct B_Updated { pub value: u256, pub scale: u256 }
#[event]
pub struct ScaleUpdated { pub value: u256 }
#[event]
pub struct DepositUpdated {
    #[indexed]
    pub user: Address,
    pub deposit: u256, pub stash: u256, pub p: u256, pub s: u256, pub b: u256, pub scale: u256,
}
#[event]
pub struct DepositOperation {
    #[indexed]
    pub user: Address,
    pub operation: u8, pub loss: u256, pub change: i256,
    pub yield_gain: u256, pub yield_claimed: u256, pub coll_gain: u256, pub coll_claimed: u256,
}
fn update_yield(_ amount: u256) uses (yield_pending: mut u256, total_bold: u256, yield_owed: mut u256, current_scale: u256, scale_b: mut StorageMap<u256, u256>, product: u256, log: mut Log) {
    let accumulated = yield_pending + amount
    if accumulated == 0 { return }
    if total_bold < MIN_BOLD_IN_SP { yield_pending = accumulated
        return
    }
    yield_owed += accumulated
    yield_pending = 0
    let scale = current_scale
    let value = scale_b[scale] + product * accumulated / total_bold
    scale_b[scale] = value
    log.emit(B_Updated { value, scale })
}
fn update_total(_ increase: u256, _ decrease: u256) -> u256 uses (total_bold: mut u256, log: mut Log) {
    if increase == 0 && decrease == 0 { return total_bold }
    total_bold = total_bold + increase - decrease
    log.emit(StabilityPoolBoldBalanceUpdated { value: total_bold })
    total_bold
}
fn decrease_owed(_ amount: u256) uses (yield_owed: mut u256) {
    if amount == 0 { return }
    yield_owed -= amount
}
fn update_deposit(_ user: Address, _ amount: u256, _ stashed: u256) uses (deposits: mut StorageMap<Address, u256>, stashed_coll: mut StorageMap<Address, u256>, snapshots: mut StorageMap<Address, Snapshot>, current_scale: u256, product: u256, scale_s: StorageMap<u256, u256>, scale_b: StorageMap<u256, u256>, log: mut Log) {
    deposits[user] = amount
    stashed_coll[user] = stashed
    if amount == 0 {
        snapshots[user] = Snapshot { s: 0, p: 0, b: 0, scale: 0 }
        log.emit(DepositUpdated { user, deposit: 0, stash: stashed, p: 0, s: 0, b: 0, scale: 0 })
        return
    }
    let scale = current_scale
    let p = product
    let s = s_sum(scale)
    let b = b_sum(scale)
    snapshots[user] = Snapshot { s, p, b, scale }
    log.emit(DepositUpdated { user, deposit: amount, stash: stashed, p, s, b, scale })
}
fn send_bold(_ token: Address, _ user: Address, _ amount: u256) uses (ctx: Ctx, call: mut Call) {
    if amount == 0 { return }
    token.call(BoldTokenMsg::ReturnFromPool { pool: ctx.address(), receiver: user, amount })
}
fn send_coll(_ token: Address, _ amount: u256) uses (ctx: Ctx, call: mut Call, coll_balance: mut u256, log: mut Log) {
    if amount == 0 { return }
    coll_balance -= amount
    log.emit(StabilityPoolCollBalanceUpdated { value: coll_balance })
    safe_transfer(token, ctx.caller(), amount)
}
fn provide(_ bold: Address, _ coll: Address, _ amount: u256, _ claim: bool) uses (ctx: Ctx, call: mut Call, active_pool: Address, deposits: mut StorageMap<Address, u256>, snapshots: mut StorageMap<Address, Snapshot>, stashed_coll: mut StorageMap<Address, u256>, scale_s: StorageMap<u256, u256>, scale_b: mut StorageMap<u256, u256>, coll_balance: mut u256, total_bold: mut u256, yield_owed: mut u256, yield_pending: mut u256, product: u256, current_scale: u256, log: mut Log) {
    text::require(amount > 0, text::stability_nonzero())
    active_pool.call(ActivePoolMsg::MintAggInterest {})
    let user = ctx.caller()
    let initial = deposit(user)
    let coll_reward = coll_gain(user)
    let yield_reward = yield_gain(user)
    let compounded_deposit = compounded(user)
    let kept = if claim { 0 } else { yield_reward }
    let sent = if claim { yield_reward } else { 0 }
    let amount_new = compounded_deposit + amount + kept
    let coll_total = stash(user) + coll_reward
    let stashed = if claim { 0 } else { coll_total }
    let coll_sent = if claim { coll_total } else { 0 }
    log.emit(DepositOperation { user, operation: 0, loss: initial - compounded_deposit, change: amount.downcast_truncate(), yield_gain: yield_reward, yield_claimed: sent, coll_gain: coll_reward, coll_claimed: coll_sent })
    update_deposit(user, amount_new, stashed)
    bold.call(BoldTokenMsg::SendToPool { sender: user, pool: ctx.address(), amount })
    update_total(amount + kept, 0)
    decrease_owed(yield_reward)
    send_bold(bold, user, sent)
    send_coll(coll, coll_sent)
    update_yield(0)
}
fn withdraw(_ bold: Address, _ coll: Address, _ amount: u256, _ claim: bool) uses (ctx: Ctx, call: mut Call, active_pool: Address, deposits: mut StorageMap<Address, u256>, snapshots: mut StorageMap<Address, Snapshot>, stashed_coll: mut StorageMap<Address, u256>, scale_s: StorageMap<u256, u256>, scale_b: mut StorageMap<u256, u256>, coll_balance: mut u256, total_bold: mut u256, yield_owed: mut u256, yield_pending: mut u256, product: u256, current_scale: u256, log: mut Log) {
    let user = ctx.caller()
    let initial = deposit(user)
    text::require(initial > 0, text::stability_has_deposit())
    active_pool.call(ActivePoolMsg::MintAggInterest {})
    let coll_reward = coll_gain(user)
    let yield_reward = yield_gain(user)
    let compounded_deposit = compounded(user)
    let withdrawn = math::min(amount, compounded_deposit)
    let kept = if claim { 0 } else { yield_reward }
    let sent = if claim { yield_reward } else { 0 }
    let amount_new = compounded_deposit - withdrawn + kept
    let coll_total = stash(user) + coll_reward
    let stashed = if claim { 0 } else { coll_total }
    let coll_sent = if claim { coll_total } else { 0 }
    let signed_withdrawal: i256 = withdrawn.downcast_truncate()
    log.emit(DepositOperation { user, operation: 1, loss: initial - compounded_deposit, change: -signed_withdrawal, yield_gain: yield_reward, yield_claimed: sent, coll_gain: coll_reward, coll_claimed: coll_sent })
    update_deposit(user, amount_new, stashed)
    decrease_owed(yield_reward)
    let new_total = update_total(kept, withdrawn)
    send_bold(bold, user, withdrawn + sent)
    send_coll(coll, coll_sent)
    text::require(new_total >= MIN_BOLD_IN_SP, text::stability_minimum())
}
fn claim_coll(_ coll: Address) uses (ctx: Ctx, call: mut Call, active_pool: Address, deposits: StorageMap<Address, u256>, stashed_coll: mut StorageMap<Address, u256>, coll_balance: mut u256, log: mut Log) {
    let user = ctx.caller()
    text::require(deposit(user) == 0, text::stability_no_deposit())
    active_pool.call(ActivePoolMsg::MintAggInterest {})
    let amount = stash(user)
    text::require(amount > 0, text::stability_nonzero())
    stashed_coll[user] = 0
    log.emit(DepositOperation { user, operation: 2, loss: 0, change: 0, yield_gain: 0, yield_claimed: 0, coll_gain: 0, coll_claimed: amount })
    log.emit(DepositUpdated { user, deposit: 0, stash: 0, p: 0, s: 0, b: 0, scale: 0 })
    send_coll(coll, amount)
}
fn offset(_ bold: Address, _ debt: u256, _ coll: u256) uses (ctx: Ctx, call: mut Call, active_pool: Address, current_scale: mut u256, scale_s: mut StorageMap<u256, u256>, product: mut u256, total_bold: mut u256, coll_balance: mut u256, log: mut Log) {
    let scale = current_scale
    let value = scale_s[scale] + product * coll / total_bold
    scale_s[scale] = value
    log.emit(S_Updated { value, scale })
    var numerator = product * (total_bold - debt)
    var new_p = numerator / total_bold
    text::require(new_p > 0, text::stability_nonzero_p())
    while new_p < P_PRECISION / SCALE_FACTOR {
        numerator *= SCALE_FACTOR
        new_p = numerator / total_bold
        current_scale += 1
        log.emit(ScaleUpdated { value: current_scale })
    }
    log.emit(P_Updated { value: new_p })
    product = new_p
    update_total(0, debt)
    bold.call(BoldTokenMsg::Burn { account: ctx.address(), amount: debt })
    coll_balance += coll
    active_pool.call(ActivePoolMsg::SendColl { account: ctx.address(), amount: coll })
    log.emit(StabilityPoolCollBalanceUpdated { value: coll_balance })
}

pub msg StabilityPoolMsg {
    #[selector = sol("NAME()")]
    Name -> DynString,
    #[selector = sol("collToken()")]
    CollToken -> Address,
    #[selector = sol("troveManager()")]
    TroveManager -> Address,
    #[selector = sol("boldToken()")]
    BoldToken -> Address,
    #[selector = sol("activePool()")]
    ActivePool -> Address,
    #[selector = sol("getCollBalance()")]
    CollBalance -> u256,
    #[selector = sol("getTotalBoldDeposits()")]
    TotalBoldDeposits -> u256,
    #[selector = sol("getYieldGainsOwed()")]
    YieldGainsOwed -> u256,
    #[selector = sol("getYieldGainsPending()")]
    YieldGainsPending -> u256,
    #[selector = sol("P()")]
    Product -> u256,
    #[selector = sol("currentScale()")]
    CurrentScale -> u256,
    #[selector = sol("P_PRECISION()")]
    PPrecision -> u256,
    #[selector = sol("SCALE_FACTOR()")]
    ScaleFactor -> u256,
    #[selector = sol("MAX_SCALE_FACTOR_EXPONENT()")]
    MaxScaleFactorExponent -> u256,
    #[selector = sol("SCALE_SPAN()")]
    ScaleSpan -> u256,
    #[selector = sol("getEntireBranchColl()")]
    EntireBranchColl -> u256,
    #[selector = sol("getEntireBranchDebt()")]
    EntireBranchDebt -> u256,
    #[selector = sol("deposits(address)")]
    Deposits { user: Address } -> u256,
    #[selector = sol("stashedColl(address)")]
    StashedColl { user: Address } -> u256,
    #[selector = sol("getDepositorCollGain(address)")]
    DepositorCollGain { user: Address } -> u256,
    #[selector = sol("getDepositorYieldGain(address)")]
    DepositorYieldGain { user: Address } -> u256,
    #[selector = sol("getCompoundedBoldDeposit(address)")]
    CompoundedBoldDeposit { user: Address } -> u256,
    #[selector = sol("getDepositorYieldGainWithPending(address)")]
    DepositorYieldGainWithPending { user: Address } -> u256,
    #[selector = sol("depositSnapshots(address)")]
    DepositSnapshots { user: Address } -> (u256, u256, u256, u256),
    #[selector = sol("scaleToS(uint256)")]
    ScaleToS { scale: u256 } -> u256,
    #[selector = sol("scaleToB(uint256)")]
    ScaleToB { scale: u256 } -> u256,
    #[selector = sol("provideToSP(uint256,bool)")]
    Provide { amount: u256, claim: bool },
    #[selector = sol("withdrawFromSP(uint256,bool)")]
    Withdraw { amount: u256, claim: bool },
    #[selector = sol("claimAllCollGains()")]
    Claim {  },
    #[selector = sol("triggerBoldRewards(uint256)")]
    TriggerRewards { amount: u256 },
    #[selector = sol("offset(uint256,uint256)")]
    Offset { debt: u256, amount: u256 },
}
pub contract StabilityPool {
    coll: Address,
    manager: Address,
    bold: Address,
    mut active_pool: Address,
    mut default_pool: Address,
    mut price_feed: Address,
    mut coll_balance: u256,
    mut total_bold: u256,
    mut yield_owed: u256,
    mut yield_pending: u256,
    mut deposits: StorageMap<Address, u256>,
    mut snapshots: StorageMap<Address, Snapshot>,
    mut stashed_coll: StorageMap<Address, u256>,
    mut product: u256,
    mut current_scale: u256,
    mut scale_s: StorageMap<u256, u256>,
    mut scale_b: StorageMap<u256, u256>,
    init(registry: Address) uses (mut coll, mut manager, mut bold, mut active_pool, mut default_pool, mut price_feed, mut product, call: mut Call, log: mut Log) {
        let active = registry.static(RegistryMsg::GetactivePool {})
        active_pool = active
        let default = registry.static(RegistryMsg::GetdefaultPool {})
        default_pool = default
        let feed = registry.static(RegistryMsg::GetpriceFeed {})
        price_feed = feed
        log.emit(ActivePoolAddressChanged { value: active })
        log.emit(DefaultPoolAddressChanged { value: default })
        log.emit(PriceFeedAddressChanged { value: feed })
        product = P_PRECISION
        coll = registry.static(RegistryMsg::GetcollToken {})
        manager = registry.static(RegistryMsg::GettroveManager {})
        bold = registry.static(RegistryMsg::GetboldToken {})
        log.emit(TroveManagerAddressChanged { value: manager })
        log.emit(BoldTokenAddressChanged { value: bold })
    }
    recv StabilityPoolMsg {
        Name -> DynString { text::stability_name() }
        CollToken -> Address uses (coll) { coll }
        TroveManager -> Address uses (manager) { manager }
        BoldToken -> Address uses (bold) { bold }
        ActivePool -> Address uses (active_pool) { active_pool }
        CollBalance -> u256 uses (coll_balance) { coll_balance }
        TotalBoldDeposits -> u256 uses (total_bold) { total_bold }
        YieldGainsOwed -> u256 uses (yield_owed) { yield_owed }
        YieldGainsPending -> u256 uses (yield_pending) { yield_pending }
        Product -> u256 uses (product) { product }
        CurrentScale -> u256 uses (current_scale) { current_scale }
        PPrecision -> u256  { P_PRECISION }
        ScaleFactor -> u256  { SCALE_FACTOR }
        MaxScaleFactorExponent -> u256  { MAX_SCALE_FACTOR_EXPONENT }
        ScaleSpan -> u256  { SCALE_SPAN }
        EntireBranchColl -> u256 uses (active_pool, default_pool, call: mut Call) { entire_coll(active_pool, default_pool) }
        EntireBranchDebt -> u256 uses (active_pool, default_pool, call: mut Call) { entire_debt(active_pool, default_pool) }
        Deposits { user } -> u256 uses (deposits) { deposit(user) }
        StashedColl { user } -> u256 uses (stashed_coll) { stash(user) }
        DepositorCollGain { user } -> u256 uses (deposits, snapshots, scale_s, scale_b, coll_balance, yield_owed) { coll_gain(user) }
        DepositorYieldGain { user } -> u256 uses (deposits, snapshots, scale_s, scale_b, coll_balance, yield_owed) { yield_gain(user) }
        CompoundedBoldDeposit { user } -> u256 uses (deposits, snapshots, product, current_scale) { compounded(user) }
        DepositorYieldGainWithPending { user } -> u256 uses (active_pool, total_bold, yield_owed, deposits, snapshots, scale_s, scale_b, coll_balance, product, current_scale, call: mut Call) { yield_with_pending(user) }
        DepositSnapshots { user } -> (u256, u256, u256, u256) uses (snapshots) { let snap = snapshots[user]
            (snap.s, snap.p, snap.b, snap.scale) }
        ScaleToS { scale } -> u256 uses (scale_s) { s_sum(scale) }
        ScaleToB { scale } -> u256 uses (scale_b) { b_sum(scale) }
        Provide { amount, claim } uses (bold, coll, ctx: Ctx, call: mut Call, active_pool, mut deposits, mut snapshots, mut stashed_coll, scale_s, mut scale_b, mut coll_balance, mut total_bold, mut yield_owed, mut yield_pending, product, current_scale, log: mut Log) { provide(bold, coll, amount, claim) }
        Withdraw { amount, claim } uses (bold, coll, ctx: Ctx, call: mut Call, active_pool, mut deposits, mut snapshots, mut stashed_coll, scale_s, mut scale_b, mut coll_balance, mut total_bold, mut yield_owed, mut yield_pending, product, current_scale, log: mut Log) { withdraw(bold, coll, amount, claim) }
        Claim { } uses (coll, ctx: Ctx, call: mut Call, active_pool, deposits, mut stashed_coll, mut coll_balance, log: mut Log) { claim_coll(coll) }
        TriggerRewards { amount } uses (ctx: Ctx, active_pool, mut yield_pending, total_bold, mut yield_owed, current_scale, mut scale_b, product, log: mut Log) {
            text::require(ctx.caller() == active_pool, text::stability_active_only())
            update_yield(amount)
        }
        Offset { debt, amount } uses (bold, manager, ctx: Ctx, call: mut Call, active_pool, mut current_scale, mut scale_s, mut product, mut total_bold, mut coll_balance, log: mut Log) {
            text::require(ctx.caller() == manager, text::stability_manager_only())
            offset(bold, debt, amount)
        }
    }
}
